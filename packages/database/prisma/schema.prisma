// ---------------------------------------------------------------------------
// Imports under a Letter of Credit.
//
// An ImportShipment is a file that stays open for the 60–150 days between
// committing to a foreign supplier and the goods clearing customs, accumulating
// costs from the bank, the shipping line, Customs and the C&F agent as they are
// incurred.
//
// The decision the whole module rests on: receiving a shipment EMITS an
// ordinary `Purchase` at landed cost rather than replacing it. After
// `purchase_id` is set, nothing downstream — ProductCost, InventoryMovement,
// the supplier ledger, every purchase report — knows or cares that these goods
// were imported.
//
// See docs/lc-imports-and-proforma-invoice-plan.md §4.
// ---------------------------------------------------------------------------

model ImportShipment {
  id        String @id @default(uuid())
  tenant_id String
  store_id  String
  /// Where the goods land. A container split across branches is received whole
  /// here and moved on with warehouse transfers — see the plan's open question 1.
  supplier_id String?

  /// Set once received. This is the join back to the ordinary purchase
  /// pipeline, and its presence is what "this shipment is closed to further
  /// costing" means.
  purchase_id String? @unique
  /// The customer proforma that justified opening this LC, where there was one.
  /// Not a foreign key with an action: deleting the quotation must not cascade
  /// into an import file that has money against it.
  customer_pi_id String?

  reference_number String
  /// DRAFT | LC_APPLIED | LC_ISSUED | SHIPPED | DOCS_RECEIVED | CUSTOMS |
  /// RECEIVED | CLOSED | CANCELLED
  status           String @default("DRAFT")

  // --- Letter of credit ---
  lc_number            String?
  /// SIGHT | DEFERRED | USANCE
  lc_type              String?
  lc_date              DateTime?
  /// An expired LC is a real loss and nothing else in the system watches a date.
  lc_expiry_date       DateTime?
  latest_shipment_date DateTime?
  bank_name            String?
  bank_branch          String?
  margin_percent       Decimal?  @db.Decimal(5, 2)
  /// Days of credit on a usance LC, from acceptance.
  tenor_days           Int?

  // --- Foreign exchange ---
  /// The GL stays BDT. This is the one place a foreign amount is held, and
  /// every voucher line is translated on the way out.
  currency          String   @default("USD")
  /// BDT per unit of `currency` when the LC opened; what the liability is
  /// booked at.
  fx_rate_at_open   Decimal? @db.Decimal(12, 6)
  /// The rate actually paid at settlement. The difference against
  /// `fx_rate_at_open` is realised FX gain or loss.
  fx_rate_at_settle Decimal? @db.Decimal(12, 6)
  /// Supplier invoice value in `currency`. Decimal(16,2) rather than (12,2):
  /// a container of electronics quoted in a weak currency overflows twelve
  /// digits, and this column is the one that holds a foreign figure.
  invoice_value_fc  Decimal  @default(0) @db.Decimal(16, 2)

  // --- Shipment ---
  incoterm          String?
  bl_number         String?
  bl_date           DateTime?
  vessel_name       String?
  port_of_loading   String?
  port_of_discharge String?
  etd               DateTime?
  eta               DateTime?

  // --- Customs ---
  be_number    String?
  be_date      DateTime?
  cf_agent_name String?

  notes      String?
  created_by String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant    Tenant               @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  store     Store                @relation(fields: [store_id], references: [id])
  supplier  Supplier?            @relation(fields: [supplier_id], references: [id])
  purchase  Purchase?            @relation(fields: [purchase_id], references: [id])
  creator   User?                @relation("ImportShipmentCreator", fields: [created_by], references: [id])
  items     ImportShipmentItem[]
  costs     ImportCost[]
  documents ImportDocument[]

  @@unique([tenant_id, reference_number])
  @@index([tenant_id, status])
  @@index([tenant_id, lc_number])
  @@index([tenant_id, lc_expiry_date])
  @@index([tenant_id, created_at])
}

model ImportShipmentItem {
  id          String @id @default(uuid())
  shipment_id String
  product_id  String
  quantity    Int
  /// Unit price in the shipment's currency. The BDT figure is derived at
  /// posting and deliberately not stored: the rate can move between opening and
  /// settlement, and a stale translated value would quietly disagree with the
  /// voucher that was actually written.
  unit_price_fc Decimal @db.Decimal(16, 4)

  /// Snapshots taken when the item was added. A product's HS code can be
  /// corrected later, but this shipment was assessed under the old one.
  hs_code       String?
  net_weight_kg Decimal? @db.Decimal(12, 3)
  cbm           Decimal? @db.Decimal(12, 4)

  /// Written by the allocation run at receipt, in BDT. Null until then, which
  /// is also how "this shipment has not been costed" is read.
  landed_unit_cost Decimal? @db.Decimal(14, 4)

  shipment ImportShipment @relation(fields: [shipment_id], references: [id], onDelete: Cascade)
  product  Product        @relation(fields: [product_id], references: [id])

  @@index([shipment_id])
}

/// One charge against a shipment: the LC margin, a bank commission, freight,
/// insurance, duty, VAT, AIT, the C&F agent's bill, port charges, inland
/// transport.
model ImportCost {
  id          String @id @default(uuid())
  tenant_id   String
  shipment_id String

  /// LC_MARGIN | LC_COMMISSION | BANK_CHARGE | FREIGHT | INSURANCE |
  /// CUSTOMS_DUTY | VAT | AIT | RD | SD | CF_AGENT | PORT | TRANSPORT | OTHER
  cost_type   String
  description String?

  currency   String   @default("BDT")
  amount     Decimal  @db.Decimal(16, 2)
  fx_rate    Decimal? @db.Decimal(12, 6)
  /// Always populated, always BDT: what the ledger and the allocation both use.
  amount_bdt Decimal  @db.Decimal(16, 2)

  /// VALUE | QTY | WEIGHT | CBM — see landed-cost.utils.ts.
  allocation_basis String @default("VALUE")

  /// False for rebatable VAT and creditable AIT, which are receivables rather
  /// than product cost. Capitalising them overstates COGS on every subsequent
  /// sale of the goods, and it is the most common landed-cost error there is.
  is_capitalized Boolean @default(true)
  /// Where a non-capitalised charge lands instead — VAT Rebate Receivable, AIT.
  /// Required when is_capitalized is false.
  receivable_account_id String?

  paid_at              DateTime?
  paid_from_account_id String?
  /// The voucher this charge posted through, once it has.
  voucher_id           String?

  created_by String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant   Tenant         @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  shipment ImportShipment @relation(fields: [shipment_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, shipment_id])
  @@index([tenant_id, cost_type])
}

/// Shipping and customs paperwork. Stored by `storage_key` on the same
/// AssetsService path as expense-claim receipts and project attachments, not as
/// a bare URL.
model ImportDocument {
  id          String @id @default(uuid())
  tenant_id   String
  shipment_id String

  /// LC_COPY | COMMERCIAL_INVOICE | PACKING_LIST | BL | COO | INSURANCE |
  /// BILL_OF_ENTRY | RELEASE_ORDER | OTHER
  doc_type    String
  file_name   String
  storage_key String
  mime_type   String?
  file_size   Int?

  uploaded_by String?
  created_at  DateTime @default(now())

  tenant   Tenant         @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  shipment ImportShipment @relation(fields: [shipment_id], references: [id], onDelete: Cascade)
  uploader User?          @relation("ImportDocumentUploader", fields: [uploaded_by], references: [id])

  @@index([tenant_id, shipment_id])
}

model Sale {
  id               String   @id @default(uuid())
  tenant_id        String
  store_id         String
  counter_id       String?
  serial_number    String
  reference_number String? // User-editable reference, unique per tenant
  total_amount     Decimal  @db.Decimal(12, 2)
  amount_paid      Decimal  @default(0) @db.Decimal(12, 2)
  status           String
  note             String?
  created_by       String?
  created_at       DateTime @default(now())
  sale_date        DateTime @default(now())

  // Relations
  tenant         Tenant          @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  store          Store           @relation(fields: [store_id], references: [id])
  counter        PosCounter?     @relation(fields: [counter_id], references: [id])
  customer_id    String?
  customer       Customer?       @relation(fields: [customer_id], references: [id])
  items          SaleItem[]
  payments       PaymentRecord[]
  returns        SalesReturn[]
  warrantyClaims WarrantyClaim[]
  deliveryOrders DeliveryOrder[]

  @@unique([tenant_id, serial_number])
  @@unique([tenant_id, reference_number])
  @@index([tenant_id, created_at])
  @@index([tenant_id, sale_date])
  @@index([tenant_id, store_id])
  @@index([tenant_id, customer_id])
  @@index([tenant_id, counter_id])
}

model Customer {
  id                   String       @id @default(uuid())
  tenant_id            String
  customer_code        String
  name                 String
  owner_name           String?
  phone                String?
  email                String?
  address              String?
  profile_pic_url      String?
  customer_type        CustomerType @default(INDIVIDUAL)
  customer_group_id    String?
  territory_id         String?
  credit_limit         Decimal?     @db.Decimal(12, 2)
  default_discount_pct Decimal?     @db.Decimal(5, 2)
  total_spent          Decimal      @default(0) @db.Decimal(12, 2)
  nid                  String?
  segment_category     String       @default("Regular")
  loyalty_points       Int          @default(0)
  due_balance          Decimal      @default(0) @db.Decimal(12, 2)
  credit_enabled       Boolean      @default(false)
  last_contacted_at    DateTime?
  /// Read-only rollup, as Lead.next_activity_id. `last_contacted_at` above is
  /// the customer-side last-touched column and is reused rather than paired
  /// with a new one. Written ONLY by CrmActivitiesService.recalculateRollup().
  next_activity_id     String?
  next_activity_date   DateTime?
  preferred_channel    String       @default("PHONE")
  birthday             DateTime?
  anniversary          DateTime?
  created_at           DateTime     @default(now())
  deleted_at           DateTime?
  // Scoped per tenant, not globally: one person may shop at several storefronts,
  // so the same User links to at most one Customer *per tenant*.
  user_id              String?

  // Relations
  tenant              Tenant                      @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  customerGroup       CustomerGroup?              @relation(fields: [customer_group_id], references: [id])
  territory           Territory?                  @relation(fields: [territory_id], references: [id])
  user                User?                       @relation(fields: [user_id], references: [id])
  sales               Sale[]
  salesOrders         SalesOrder[]
  quotations          Quotation[]
  warrantyClaims      WarrantyClaim[]
  loyaltyTransactions LoyaltyTransaction[]
  interactions        CustomerInteraction[]
  crmFollowUps        CrmFollowUp[]
  crmActivities       CrmActivity[]
  creditTransactions  CustomerCreditTransaction[]
  campaignRecipients  CrmCampaignRecipient[]
  convertedFromLeads  Lead[]                      @relation("LeadConvertedCustomer")
  projects            Project[]

  @@unique([tenant_id, phone])
  @@unique([tenant_id, customer_code])
  @@unique([tenant_id, user_id])
  @@index([tenant_id, deleted_at])
  @@index([tenant_id, email])
}

model CustomerGroup {
  id                   String   @id @default(uuid())
  tenant_id            String
  name                 String
  description          String?
  default_discount_pct Decimal? @db.Decimal(5, 2)
  price_list_id        String?
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  // Relations
  tenant    Tenant     @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  priceList PriceList? @relation(fields: [price_list_id], references: [id], onDelete: SetNull)
  customers Customer[]

  @@unique([tenant_id, name])
  @@index([price_list_id])
}

model PriceList {
  id                     String                 @id @default(uuid())
  tenant_id              String
  name                   String
  description            String?
  is_default             Boolean                @default(false)
  is_active              Boolean                @default(true)
  overall_discount_type  PriceListDiscountType?
  overall_discount_value Decimal?               @db.Decimal(12, 2)
  created_at             DateTime               @default(now())
  updated_at             DateTime               @updatedAt

  tenant         Tenant          @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  items          PriceListItem[]
  customerGroups CustomerGroup[]

  @@unique([tenant_id, name])
  @@index([tenant_id, is_default])
}

model PriceListItem {
  id             String                 @id @default(uuid())
  price_list_id  String
  product_id     String
  selling_price  Decimal?               @db.Decimal(12, 2)
  discount_type  PriceListDiscountType?
  discount_value Decimal?               @db.Decimal(12, 2)
  created_at     DateTime               @default(now())
  updated_at     DateTime               @updatedAt

  priceList PriceList @relation(fields: [price_list_id], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@unique([price_list_id, product_id])
  @@index([price_list_id])
}

model Territory {
  id          String   @id @default(uuid())
  tenant_id   String
  name        String
  parent_id   String?
  description String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  // Relations
  tenant    Tenant      @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  parent    Territory?  @relation("TerritoryHierarchy", fields: [parent_id], references: [id])
  children  Territory[] @relation("TerritoryHierarchy")
  customers Customer[]

  @@unique([tenant_id, name, parent_id])
}

model CustomerInteraction {
  id          String   @id @default(uuid())
  tenant_id   String
  store_id    String?
  customer_id String
  type        String // CALL | SMS | WHATSAPP | EMAIL | VISIT | NOTE
  direction   String   @default("OUTBOUND")
  summary     String
  outcome     String?
  created_by  String?
  created_at  DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  creator  User?    @relation("InteractionCreator", fields: [created_by], references: [id])

  @@index([tenant_id, customer_id])
  @@index([tenant_id, created_at])
}

model Lead {
  id                    String        @id @default(uuid())
  tenant_id             String
  store_id              String?
  name                  String
  mobile                String?
  custom_fields         Json?
  email                 String?
  address               String?
  // `category`/`source` are the legacy enum columns. They are kept in lockstep
  // with `category_id`/`source_id` (dual-written on every create/update) so a
  // rollback to the previous release still finds sane data. They are dropped in
  // the contract release, once `sync-lead-taxonomy` reports zero unbackfilled
  // rows — see docs/crm/lead-taxonomy-rollout.md. Do NOT read them in new code.
  category              LeadCategory?
  category_id           String?
  priority              LeadPriority  @default(MEDIUM)
  remarks               String?
  source                LeadSource    @default(OTHER)
  source_id             String?
  status                LeadStatus    @default(NEW)
  lost_reason           String?
  score                 Int           @default(0)
  linkedin_url          String?
  fb_url                String?
  x_url                 String?
  website_url           String?
  photo_url             String?
  /// Cloudinary's public_id for `photo_url`. A secure_url cannot be turned back
  /// into one, so without this a replaced photo is stranded and billed forever —
  /// the trap VoucherAttachment and ProjectAttachment are still in.
  photo_storage_key     String?
  next_step             String?
  next_step_date        DateTime?
  next_step_assigned_to String?
  /// Read-only rollup of the earliest PLANNED CrmActivity. Written ONLY by
  /// CrmActivitiesService.recalculateRollup(). next_step / next_step_date /
  /// next_step_assigned_to above are the same rollup and are equally read-only
  /// from R1 onward — they keep their names so the leads list, sort allowlist,
  /// myActionsToday filter, CSV importer, lead scoring and ai/chat-data.service
  /// need no changes.
  ///
  /// Deliberately a plain column, not a relation — a FK back to CrmActivity while
  /// CrmActivity has a FK to Lead creates a cycle Prisma requires extra annotation
  /// to resolve, and the rollup only ever needs the id.
  next_activity_id      String?
  assigned_to           String?
  last_contacted_at     DateTime?
  /// When the lead reached a terminal status (CONVERTED or LOST); null while it is
  /// still open. `status` says which of the two it was, so one column serves both.
  /// Written by every path that sets a terminal status and cleared when a lead is
  /// reopened — `updated_at` cannot stand in for it, because any later edit moves it.
  closed_at             DateTime?
  converted_customer_id String?
  created_by            String?
  created_at            DateTime      @default(now())
  updated_at            DateTime      @updatedAt

  tenant             Tenant                 @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  assignee           User?                  @relation("LeadAssignee", fields: [assigned_to], references: [id])
  nextStepAssignee   User?                  @relation("LeadNextStepAssignee", fields: [next_step_assigned_to], references: [id])
  creator            User?                  @relation("LeadCreator", fields: [created_by], references: [id])
  convertedCustomer  Customer?              @relation("LeadConvertedCustomer", fields: [converted_customer_id], references: [id])
  sourceOption       LeadSourceOption?      @relation(fields: [source_id], references: [id], onDelete: Restrict)
  categoryOption     LeadCategoryOption?    @relation(fields: [category_id], references: [id], onDelete: Restrict)
  conversations      LeadConversation[]
  crmFollowUps       CrmFollowUp[]
  crmActivities      CrmActivity[]
  projects           Project[]
  campaignRecipients CrmCampaignRecipient[]

  @@unique([tenant_id, mobile])
  @@index([tenant_id, status])
  @@index([tenant_id, category])
  @@index([tenant_id, priority])
  @@index([tenant_id, assigned_to])
  @@index([tenant_id, next_step_date])
  @@index([tenant_id, source_id])
  @@index([tenant_id, category_id])
  // Serves the CRM dashboard's won/lost-in-period counts, which filter on
  // status + closed_at together.
  @@index([tenant_id, status, closed_at])
  // Serves the same dashboard's new-leads-in-period count and daily trend buckets.
  @@index([tenant_id, created_at])
}

/// Tenant-editable lead sources. Replaces the `LeadSource` enum.
///
/// `code` is the immutable join key (seeded rows reuse the old enum members, so
/// the backfill and CSV import can match on it); `name` is the editable label a
/// tenant can rename freely without breaking either. Seeded rows carry
/// `is_system` and are deactivated rather than deleted, because the idempotent
/// tenant sync would otherwise resurrect them on the next container start.
model LeadSourceOption {
  id           String   @id @default(uuid())
  tenant_id    String
  code         String
  name         String
  /// 0-25 contribution to the lead score. Replaces the hardcoded SOURCE_WEIGHT
  /// map in apps/backend/src/crm-leads/lead-scoring.util.ts.
  score_weight Int      @default(5)
  sort_order   Int      @default(0)
  is_system    Boolean  @default(false)
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  leads  Lead[]

  @@unique([tenant_id, code])
  @@unique([tenant_id, name])
  @@index([tenant_id, is_active, sort_order])
}

/// Tenant-editable lead categories. Replaces the `LeadCategory` enum.
/// Flat by design — unlike CustomerGroup there is no parent/child nesting.
model LeadCategoryOption {
  id         String   @id @default(uuid())
  tenant_id  String
  code       String
  name       String
  sort_order Int      @default(0)
  is_system  Boolean  @default(false)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  leads  Lead[]

  @@unique([tenant_id, code])
  @@unique([tenant_id, name])
  @@index([tenant_id, is_active, sort_order])
}

/// How a contact row first entered the system. `BUSINESS_CARD` marks rows whose
/// fields were extracted from a photographed card, which is worth keeping: those
/// values came out of an OCR pass and are the ones most worth re-checking.
enum CrmContactCaptureSource {
  MANUAL
  BUSINESS_CARD
  IMPORT
}

/// A person the tenant knows — deliberately thinner than `Lead`.
///
/// A lead carries a pipeline (status, score, next step, source/category
/// taxonomy) because it is being worked. A contact is just an address-book row:
/// who they are, where they work, how to reach them. Keeping them separate is
/// what lets the business-card scanner drop a card into the system in one step
/// without inventing a pipeline stage for someone met at a trade fair.
model CrmContact {
  id             String                  @id @default(uuid())
  tenant_id      String
  name           String
  company        String?
  designation    String?
  mobile         String?
  phone          String?
  email          String?
  address        String?
  website_url    String?
  linkedin_url   String?
  photo_url      String?
  /// Cloudinary's public_id for `photo_url` — see the same field on `Lead`.
  photo_storage_key String?
  notes          String?
  capture_source CrmContactCaptureSource @default(MANUAL)
  assigned_to    String?
  created_by     String?
  created_at     DateTime                @default(now())
  updated_at     DateTime                @updatedAt

  tenant             Tenant                 @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  assignee           User?                  @relation("CrmContactAssignee", fields: [assigned_to], references: [id])
  creator            User?                  @relation("CrmContactCreator", fields: [created_by], references: [id])
  attachments        CrmContactAttachment[]
  campaignRecipients CrmCampaignRecipient[]

  // Mobile is the dedupe key, as it is on Lead. Postgres treats NULLs as
  // distinct, so any number of contacts may have no mobile at all.
  @@unique([tenant_id, mobile])
  @@index([tenant_id, name])
  @@index([tenant_id, company])
  @@index([tenant_id, assigned_to])
  @@index([tenant_id, created_at])
}

/// A file kept alongside a contact — today only the photographed business card
/// the contact was read from, so the extraction can be checked against the card
/// itself rather than taken on trust.
model CrmContactAttachment {
  id         String @id @default(uuid())
  tenant_id  String
  contact_id String

  file_url  String
  file_name String
  mime_type String?
  file_size Int?

  /// Cloudinary's handle for the stored asset. Kept because `file_url` cannot be
  /// turned back into one, and without it deleting the row would strand the file.
  storage_key String?

  /// BUSINESS_CARD is the only producer today. A plain string rather than an
  /// enum so a second kind does not need a schema change, matching
  /// `LeadConversation.type`.
  kind String @default("BUSINESS_CARD")

  created_by String?
  created_at DateTime @default(now())

  tenant  Tenant     @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  contact CrmContact @relation(fields: [contact_id], references: [id], onDelete: Cascade)
  creator User?      @relation("CrmContactAttachmentCreator", fields: [created_by], references: [id])

  @@index([tenant_id, contact_id, created_at])
  @@map("crm_contact_attachments")
}

enum CustomFieldEntity {
  LEAD
}

model CustomFieldDefinition {
  id         String            @id @default(uuid())
  tenant_id  String
  entity     CustomFieldEntity
  key        String
  label      String
  order      Int               @default(0)
  is_active  Boolean           @default(true)
  created_at DateTime          @default(now())
  updated_at DateTime          @updatedAt

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, entity, key])
  @@index([tenant_id, entity])
}

/// Tenant-editable communication channels a conversation can be logged under.
/// Replaces the hardcoded CALL | SMS | WHATSAPP | … list that used to live in
/// `LeadConversationType`.
///
/// Same shape and same rules as `LeadSourceOption`: `code` is the immutable join
/// key (seeded rows reuse the old enum members so historical `LeadConversation.type`
/// values still match), `name` is the label a tenant renames freely, and seeded
/// rows carry `is_system` so the idempotent tenant sync deactivates rather than
/// resurrects them.
model ConversationChannel {
  id         String   @id @default(uuid())
  tenant_id  String
  code       String
  name       String
  /// Emoji shown beside the channel in conversation lists. Free text rather than
  /// an icon-name enum so a tenant adding "Telegram" can pick its own glyph
  /// without a code change; the UI falls back to a generic bubble when unset.
  icon       String?
  sort_order Int      @default(0)
  is_system  Boolean  @default(false)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant        Tenant             @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  conversations LeadConversation[]
  activities    CrmActivity[]

  @@unique([tenant_id, code])
  @@unique([tenant_id, name])
  @@index([tenant_id, is_active, sort_order])
}

model LeadConversation {
  id         String   @id @default(uuid())
  tenant_id  String
  store_id   String?
  lead_id    String
  /// The channel's `code`, denormalised. Kept alongside `channel_id` because every
  /// filter, sort and groupBy on this table reads it, and the composite index below
  /// serves those directly — resolving a code to an id on every request would buy
  /// nothing. Written only by the service, always from the resolved channel.
  type       String
  channel_id String?
  direction  String   @default("OUTBOUND")
  summary    String
  outcome    String?
  created_by String?
  created_at DateTime @default(now())

  tenant  Tenant               @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  lead    Lead                 @relation(fields: [lead_id], references: [id], onDelete: Cascade)
  creator User?                @relation("LeadConversationCreator", fields: [created_by], references: [id])
  channel ConversationChannel? @relation(fields: [channel_id], references: [id], onDelete: Restrict)

  @@index([tenant_id, lead_id])
  @@index([tenant_id, created_at])
  // Serves the cross-lead conversations list, which filters by type across every lead.
  // Without it a type filter degrades to a full tenant-partition scan.
  @@index([tenant_id, type, created_at])
  // Serves the per-channel usage counts on the CRM Setup screen.
  @@index([tenant_id, channel_id])
}

/// A dated, assignable prompt to contact a customer or a lead — "call Rahim
/// about his overdue invoice on Thursday". Distinct from LeadConversation /
/// CustomerInteraction, which record contact that already happened.
///
/// Named FollowUp rather than Task because "Task" belongs to the Project
/// Management module. The generic manual type is GENERAL for the same reason a
/// FOLLOW_UP type inside a FollowUp table reads badly.
model CrmFollowUp {
  id           String    @id @default(uuid())
  tenant_id    String
  store_id     String?
  customer_id  String?
  lead_id      String?
  type         String // GENERAL | COLLECTION | BIRTHDAY | REORDER_REMINDER
  title        String
  due_at       DateTime
  completed_at DateTime?
  assigned_to  String?
  created_by   String?
  notes        String?
  status       String    @default("PENDING")
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  tenant   Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  lead     Lead?     @relation(fields: [lead_id], references: [id], onDelete: Cascade)
  assignee User?     @relation("CrmFollowUpAssignee", fields: [assigned_to], references: [id])
  creator  User?     @relation("CrmFollowUpCreator", fields: [created_by], references: [id])

  @@index([tenant_id, status, due_at])
  @@index([tenant_id, customer_id])
  @@index([tenant_id, lead_id])
}

model CrmActivityPurpose {
  id         String   @id @default(uuid())
  tenant_id  String
  code       String
  name       String
  icon       String?
  sort_order Int      @default(0)
  is_system  Boolean  @default(false)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant     Tenant        @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  activities CrmActivity[]

  @@unique([tenant_id, code])
  @@unique([tenant_id, name])
  @@index([tenant_id, is_active, sort_order])
}

/// One row per planned OR logged CRM touch. `status` separates the two — a
/// PLANNED row is a task, a DONE row is history. Replaces LeadConversation,
/// CustomerInteraction and CrmFollowUp, which survive read-only through R2 and
/// are dropped in R3. See docs/superpowers/specs/2026-08-12-crm-activity-unification-design.md
model CrmActivity {
  id           String  @id @default(uuid())
  tenant_id    String
  store_id     String?

  /// Exactly one of lead_id / customer_id is set — enforced in the service, the
  /// same rule CrmFollowUp.validateFollowUpTarget already applies.
  lead_id     String?
  customer_id String?

  purpose_id   String?
  /// Nullable while PLANNED: a rep scheduling "chase the invoice" often does not
  /// yet know whether it will be a call or a WhatsApp. Required on completion.
  channel_id   String?
  /// The channel's `code`, denormalised — exactly as LeadConversation.type is.
  /// Every filter and groupBy reads it and the composite index serves those.
  channel_code String?

  /// The planned title. Null on an activity logged directly with no prior plan,
  /// which genuinely has no separate title — the UI renders `subject ?? summary`.
  subject      String?
  status       String    @default("PLANNED")
  due_at       DateTime?
  completed_at DateTime?

  /// What happened. Null while PLANNED, required on completion.
  summary   String?
  outcome   String?
  /// Written before the activity; `summary` is written after.
  notes     String?
  direction String  @default("OUTBOUND")

  assigned_to String?
  created_by  String?
  origin      String  @default("MANUAL")

  /// Backfill provenance. Both are null on user-created rows, and Postgres
  /// treats NULLs as distinct, so the unique index below constrains only
  /// backfilled rows — which is what makes sync-crm-activities re-runnable.
  /// Dropped in R3.
  legacy_source String?
  legacy_id     String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant   Tenant               @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  lead     Lead?                @relation(fields: [lead_id], references: [id], onDelete: Cascade)
  customer Customer?            @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  purpose  CrmActivityPurpose?  @relation(fields: [purpose_id], references: [id], onDelete: Restrict)
  channel  ConversationChannel? @relation(fields: [channel_id], references: [id], onDelete: Restrict)
  assignee User?                @relation("CrmActivityAssignee", fields: [assigned_to], references: [id])
  creator  User?                @relation("CrmActivityCreator", fields: [created_by], references: [id])

  @@unique([tenant_id, legacy_source, legacy_id])
  @@index([tenant_id, status, due_at])
  @@index([tenant_id, assigned_to, status, due_at])
  @@index([tenant_id, lead_id, status, due_at])
  @@index([tenant_id, customer_id, status, due_at])
  @@index([tenant_id, status, completed_at])
  @@index([tenant_id, channel_id])
  @@index([tenant_id, purpose_id])
}

model CustomerCreditTransaction {
  id             String   @id @default(uuid())
  tenant_id      String
  customer_id    String
  type           String // CREDIT_SALE | PAYMENT | ADJUSTMENT
  amount         Decimal  @db.Decimal(12, 2)
  balance_after  Decimal  @db.Decimal(12, 2)
  reference_type String?
  reference_id   String?
  payment_number String?
  notes          String?
  created_by     String?
  created_at     DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  creator  User?    @relation("CreditTransactionCreator", fields: [created_by], references: [id])

  @@unique([tenant_id, payment_number])
  @@index([tenant_id, customer_id])
  @@index([tenant_id, created_at])
}

model CrmCampaign {
  id                 String    @id @default(uuid())
  tenant_id          String
  name               String
  description        String?
  status             String    @default("DRAFT")
  channel            String // SMS | WHATSAPP | EMAIL
  /// SEGMENT resolves recipients from the customer base at send time.
  /// UPLOAD carries its own recipient rows, written when the campaign is created.
  recipient_source   String    @default("SEGMENT")
  /// TEXT escapes the message and turns newlines into breaks; HTML sends it as-is.
  body_format        String    @default("TEXT")
  target_segment     String? // VIP | At-Risk | Regular | New | ALL
  target_group_id    String?
  subject            String? // required for EMAIL channel with recipient_source SEGMENT
  /// Null for UPLOAD campaigns, where every recipient carries its own message.
  message            String?
  scheduled_at       DateTime?
  sent_at            DateTime?
  recipient_count    Int       @default(0)
  delivered_count    Int       @default(0)
  failed_count       Int       @default(0)
  attributed_revenue Decimal   @default(0) @db.Decimal(12, 2)
  attributed_orders  Int       @default(0)
  created_by         String?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  tenant     Tenant                 @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  creator    User?                  @relation("CampaignCreator", fields: [created_by], references: [id])
  recipients CrmCampaignRecipient[]

  @@index([tenant_id, status])
  @@index([tenant_id, created_at])
}

model CrmCampaignRecipient {
  id          String    @id @default(uuid())
  campaign_id String
  /// All three links are optional: an uploaded address may match a customer, a
  /// lead, a contact, or none of them. At most one is set.
  customer_id String?
  lead_id     String?
  contact_id  String?
  /// Null on SMS/WhatsApp segment campaigns, which reach people by phone.
  phone       String?
  /// The address actually emailed. Null on SMS/WhatsApp segment campaigns.
  email       String?
  name        String?
  /// Set only on UPLOAD campaigns; segment campaigns fall back to the campaign's own.
  subject     String?
  message     String?
  status      String    @default("PENDING")
  /// When this row was claimed for sending. A row left SENDING for longer than
  /// STALE_CLAIM_MS (a crash or redeploy mid-batch) is re-queued by the next
  /// drain pass instead of being stranded and counted as neither sent nor failed.
  claimed_at  DateTime?
  sent_at     DateTime?
  error       String?

  campaign CrmCampaign @relation(fields: [campaign_id], references: [id], onDelete: Cascade)
  customer Customer?   @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  lead     Lead?       @relation(fields: [lead_id], references: [id], onDelete: SetNull)
  contact  CrmContact? @relation(fields: [contact_id], references: [id], onDelete: SetNull)

  @@unique([campaign_id, customer_id])
  @@unique([campaign_id, email])
  @@index([campaign_id, status])
  @@index([lead_id])
  @@index([contact_id])
}

model AccountGroup {
  id         String   @id @default(uuid())
  tenant_id  String
  name       String
  /// `<type digit><serial>`, e.g. 11 = the first asset group. See account-code.ts.
  /// Defaults to '' so `prisma db push` can add it to a populated table; the
  /// boot-time backfill fills it before the API serves. Phase B makes it unique.
  code       String   @default("") @db.VarChar(2)
  type       String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant    Tenant            @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  subgroups AccountSubgroup[]
  accounts  Account[]

  @@unique([tenant_id, name])
  @@index([tenant_id])
  @@map("account_groups")
}

model AccountSubgroup {
  id         String   @id @default(uuid())
  tenant_id  String
  group_id   String
  name       String
  /// Always prefixed with the parent group's code, e.g. 1101 under group 11.
  code       String   @default("") @db.VarChar(4)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant   Tenant       @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  group    AccountGroup @relation(fields: [group_id], references: [id], onDelete: Cascade)
  accounts Account[]

  @@unique([group_id, name])
  @@index([tenant_id])
  @@index([group_id])
  @@map("account_subgroups")
}

model Account {
  id          String     @id @default(uuid())
  tenant_id   String
  group_id    String
  subgroup_id String?
  name        String
  /// Always prefixed with the parent subgroup's code (or `<group>00` when the
  /// account hangs directly off its group), e.g. 110101 under subgroup 1101.
  /// Still nullable in phase A: this column already existed with NULL rows, and
  /// `db push` refuses to make an existing column required, default or not.
  /// The backfill fills every row; phase B is what tightens it. See TODO.md.
  code        String?    @db.VarChar(6)
  /// The flat 4-digit code this account carried before hierarchical codes.
  /// Kept searchable for one release so tenants can map their old paperwork.
  legacy_code String?
  type        String
  category    String     @default("general")
  /// Non-null on a control account (AR / Purchase Payable / Salary Payable):
  /// its balance is maintained as a subsidiary ledger, one balance per party.
  /// autoPostFromRules tags the voucher line hitting this account with party_id.
  party_type  PartyType?
  created_at  DateTime   @default(now())
  updated_at  DateTime   @updatedAt

  tenant                Tenant                 @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  group                 AccountGroup           @relation(fields: [group_id], references: [id])
  subgroup              AccountSubgroup?       @relation(fields: [subgroup_id], references: [id])
  voucherDetails        VoucherDetail[]
  debitPostingRules     PostingRule[]          @relation("PostingRuleDebitAccount")
  creditPostingRules    PostingRule[]          @relation("PostingRuleCreditAccount")
  budgets               AccountBudget[]
  recurringJournalLines RecurringJournalLine[]
  recurringVoucherLines RecurringVoucherLine[]
  voucherTemplateLines  VoucherTemplateLine[]
  paymentRecords        PaymentRecord[]

  @@unique([tenant_id, name])
  @@index([tenant_id])
  @@index([group_id])
  @@index([subgroup_id])
  @@index([tenant_id, type])
  @@index([tenant_id, category])
  @@index([tenant_id, code])
  @@map("accounts")
}

model PostingRule {
  id                String                  @id @default(cuid())
  tenant_id         String
  event_type        PostingRuleEventType
  condition_key     PostingRuleConditionKey @default(none)
  condition_value   String?
  debit_account_id  String
  credit_account_id String
  priority          Int                     @default(100)
  is_active         Boolean                 @default(true)
  created_at        DateTime                @default(now())
  updated_at        DateTime                @updatedAt

  tenant        Tenant  @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  debitAccount  Account @relation("PostingRuleDebitAccount", fields: [debit_account_id], references: [id], onDelete: Restrict)
  creditAccount Account @relation("PostingRuleCreditAccount", fields: [credit_account_id], references: [id], onDelete: Restrict)

  @@index([tenant_id, event_type, is_active])
  @@index([tenant_id, condition_key, condition_value])
  @@index([tenant_id, debit_account_id])
  @@index([tenant_id, credit_account_id])
  @@map("posting_rules")
}

/// Tenant-wide accounting controls. Every flag defaults to the pre-feature
/// behaviour, so a tenant that never opens the settings page is unaffected.
model AccountingSettings {
  id                           String   @id @default(uuid())
  tenant_id                    String   @unique
  /// Manually entered vouchers (and opening-balance imports) land as PENDING and
  /// stay out of approved-only reports until someone with APPROVE_VOUCHER acts.
  require_voucher_approval     Boolean  @default(false)
  /// What happens to vouchers other modules post automatically (sales, purchases,
  /// payments, payroll…) while approval is required. True — the default — lets
  /// them post straight through so day-to-day operations never queue behind an
  /// approver. False routes them into the same approval queue as manual entries.
  auto_approve_system_vouchers Boolean  @default(true)
  /// When true every accounting report, ledger and dashboard figure counts only
  /// APPROVED vouchers. A per-request `approvedOnly` param overrides it.
  reports_approved_only        Boolean  @default(false)
  created_at                   DateTime @default(now())
  updated_at                   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@map("accounting_settings")
}

/// A named, tenant-scoped, optionally year-resetting counter for human-readable
/// document numbers (`PI-2526-00001`, `IMP-2526-00007`).
///
/// Deliberately NOT `VoucherSequence`, which it resembles: that table is keyed
/// by `voucher_type` and read by the posting engine, and widening it to hold
/// sales and import series would make an accounting table the source of truth
/// for documents that never touch the ledger.
///
/// Counting rows (`count() + 1`, as PurchasesService does) is what this exists
/// to avoid: quotations can be deleted, so a count-derived number reissues an
/// identifier that a customer may already be holding on a printed document.
model DocumentSequence {
  id          String   @id @default(uuid())
  tenant_id   String
  /// Logical series: QUOTE | PROFORMA | IMPORT_SHIPMENT.
  doc_type    String
  /// Bangladeshi fiscal year the series resets on — "2526" means July 2025 to
  /// June 2026. Empty string for a series that never resets, so the unique
  /// constraint below stays usable either way (a nullable column would let two
  /// never-resetting rows coexist, since NULL != NULL in Postgres).
  period_key  String   @default("")
  prefix      String
  next_number Int      @default(1)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, doc_type, period_key])
  @@index([tenant_id])
  @@map("document_sequences")
}

model VoucherSequence {
  id           String   @id
  tenant_id    String
  voucher_type String
  prefix       String
  next_number  Int      @default(1)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, voucher_type])
  @@index([tenant_id])
  @@map("voucher_sequences")
}

model Voucher {
  id                    String    @id @default(uuid())
  tenant_id             String
  voucher_number        String
  voucher_type          String
  source_module         String?
  source_type           String?
  source_id             String?
  idempotency_key       String?
  description           String?
  reference_number      String?
  date                  DateTime  @default(now())
  store_id              String?
  attribution           String    @default("BRANCH")
  counterparty_store_id String?
  /// Maker-checker state: PENDING / APPROVED / REJECTED. Defaults to APPROVED so
  /// tenants that never enable voucher approval keep the pre-feature behaviour —
  /// every voucher hits the ledger the moment it is saved.
  approval_status       String    @default("APPROVED")
  approved_by           String?
  approved_at           DateTime?
  rejection_reason      String?
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  tenant                   Tenant              @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  store                    Store?              @relation("VoucherStore", fields: [store_id], references: [id])
  counterpartyStore        Store?              @relation("VoucherCounterpartyStore", fields: [counterparty_store_id], references: [id])
  approver                 User?               @relation("VoucherApprover", fields: [approved_by], references: [id])
  details                  VoucherDetail[]
  attachments              VoucherAttachment[]
  postingEvents            PostingEvent[]
  fundTransfersSource      FundTransfer[]      @relation("FundTransferSourceVoucher")
  fundTransfersDestination FundTransfer[]      @relation("FundTransferDestinationVoucher")

  @@unique([tenant_id, voucher_number])
  @@index([tenant_id])
  @@index([tenant_id, voucher_type])
  @@index([tenant_id, source_module, source_type, source_id])
  @@index([tenant_id, store_id])
  @@index([tenant_id, attribution])
  @@index([tenant_id, approval_status])
  @@index([date])
  @@map("vouchers")
}

model PostingEvent {
  id              String               @id @default(cuid())
  tenant_id       String
  event_type      PostingRuleEventType
  source_module   String
  source_type     String
  source_id       String
  idempotency_key String
  status          PostingEventStatus   @default(pending)
  voucher_id      String?
  attempt_count   Int                  @default(0)
  last_error      String?
  last_attempt_at DateTime?
  created_at      DateTime             @default(now())
  updated_at      DateTime             @updatedAt

  tenant  Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  voucher Voucher? @relation(fields: [voucher_id], references: [id], onDelete: SetNull)

  @@unique([tenant_id, idempotency_key])
  @@index([tenant_id, status, updated_at])
  @@index([tenant_id, source_module, source_type, source_id])
  @@map("posting_events")
}

model VoucherDetail {
  id            String   @id @default(uuid())
  voucher_id    String
  account_id    String
  debit_amount  Decimal  @default(0) @db.Decimal(12, 2)
  credit_amount Decimal  @default(0) @db.Decimal(12, 2)
  comment       String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  voucher        Voucher     @relation(fields: [voucher_id], references: [id], onDelete: Cascade)
  account        Account     @relation(fields: [account_id], references: [id])
  cost_center_id String?
  costCenter     CostCenter? @relation("VoucherDetailCostCenter", fields: [cost_center_id], references: [id])
  /// Set when this line hits a control account, tying it to one customer,
  /// supplier or employee. party_id is a polymorphic reference resolved by
  /// party_type (Customer/Supplier/Employee id) — deliberately NOT a foreign key,
  /// since it points at three different tables. The subsidiary ledger for a party
  /// is `voucher_details WHERE party_id = X`.
  party_type     PartyType?
  party_id       String?

  @@index([voucher_id])
  @@index([account_id])
  @@index([cost_center_id])
  @@index([party_id])
  @@map("voucher_details")
}

model VoucherAttachment {
  id         String   @id @default(uuid())
  tenant_id  String
  voucher_id String
  file_url   String
  file_name  String
  mime_type  String?
  file_size  Int?
  created_at DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  voucher Voucher @relation(fields: [voucher_id], references: [id], onDelete: Cascade)

  @@index([voucher_id])
  @@index([tenant_id])
  @@map("voucher_attachments")
}

model PaymentRecord {
  id             String   @id @default(uuid())
  sale_id        String
  payment_method String
  amount         Decimal  @db.Decimal(12, 2)
  account_id     String? // Links payment to account (for accounting integration)
  created_at     DateTime @default(now())

  // Relations
  sale    Sale     @relation(fields: [sale_id], references: [id], onDelete: Cascade)
  account Account? @relation(fields: [account_id], references: [id], onDelete: SetNull)

  @@index([account_id])
}

model SaleItem {
  id                String   @id @default(uuid())
  sale_id           String
  product_id        String
  quantity          Int
  price_at_sale     Decimal  @db.Decimal(12, 2)
  unit_cost_at_sale Decimal? @db.Decimal(12, 2)

  // Relations
  sale    Sale              @relation(fields: [sale_id], references: [id], onDelete: Cascade)
  product Product           @relation(fields: [product_id], references: [id])
  returns SalesReturnItem[]

  @@index([sale_id])
}

model SalesReturn {
  id               String   @id @default(uuid())
  tenant_id        String
  store_id         String
  /// Optional: a return can be recorded without the original sale, e.g. goods
  /// coming back from before the business moved onto this system. When set it
  /// is validated — the lines must belong to that sale and stay within what is
  /// still returnable on it.
  sale_id          String?
  return_number    String
  /// The source system's own document number. Not unique — an imported
  /// reference can repeat, matching Purchase.reference_number.
  reference_number String?
  total_refund     Decimal  @db.Decimal(12, 2)
  reason           String?
  status           String   @default("COMPLETED")
  created_by       String?
  created_at       DateTime @default(now())

  // Relations
  tenant Tenant            @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  store  Store             @relation(fields: [store_id], references: [id])
  sale   Sale?             @relation(fields: [sale_id], references: [id])
  items  SalesReturnItem[]

  @@unique([tenant_id, return_number])
  @@index([tenant_id, reference_number])
}

model SalesReturnItem {
  id                  String   @id @default(uuid())
  return_id           String
  /// Null when the return has no parent sale; `product_id` then identifies the
  /// goods and `refund_amount` carries the agreed value.
  sale_item_id        String?
  product_id          String
  quantity            Int
  refund_amount       Decimal  @db.Decimal(12, 2)
  /// What the returned goods cost, snapshotted when the return is recorded —
  /// the original sale line's `unit_cost_at_sale` where there is one, otherwise
  /// the cost pool's average at the time of return.
  ///
  /// Without it a return reduced revenue while leaving COGS untouched, so every
  /// refund overstated gross profit by the whole cost of the goods coming back.
  /// Nullable because a return of stock nobody ever costed still has to be
  /// recordable, and zero would claim the goods were free.
  unit_cost_at_return Decimal? @db.Decimal(12, 2)

  // Relations
  return    SalesReturn @relation(fields: [return_id], references: [id], onDelete: Cascade)
  sale_item SaleItem?   @relation(fields: [sale_item_id], references: [id])
  product   Product     @relation(fields: [product_id], references: [id])
}

model SalesOrder {
  id             String    @id @default(uuid())
  tenant_id      String
  store_id       String
  customer_id    String?
  order_number   String
  total_amount   Decimal   @db.Decimal(12, 2)
  amount_paid    Decimal   @default(0) @db.Decimal(12, 2)
  status         String    @default("DRAFT") // DRAFT, CONFIRMED, PROCESSING, DELIVERED, CANCELLED
  payment_status String    @default("UNPAID") // UNPAID, PARTIAL, PAID
  delivery_date  DateTime?
  created_by     String?
  created_at     DateTime  @default(now())

  // Relations
  tenant   Tenant           @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  store    Store            @relation(fields: [store_id], references: [id])
  customer Customer?        @relation(fields: [customer_id], references: [id])
  items    SalesOrderItem[]
  deposits OrderDeposit[]

  @@unique([tenant_id, order_number])
  @@index([tenant_id, status])
  @@index([tenant_id, created_at])
}

model SalesOrderItem {
  id             String  @id @default(uuid())
  order_id       String
  product_id     String
  quantity       Int
  price_at_order Decimal @db.Decimal(12, 2)

  // Relations
  order   SalesOrder @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product Product    @relation(fields: [product_id], references: [id])
}

model OrderDeposit {
  id             String   @id @default(uuid())
  order_id       String
  amount         Decimal  @db.Decimal(12, 2)
  payment_method String
  created_at     DateTime @default(now())

  // Relations
  order SalesOrder @relation(fields: [order_id], references: [id], onDelete: Cascade)
}

model Quotation {
  id                String    @id @default(uuid())
  tenant_id         String
  store_id          String
  customer_id       String?
  quote_number      String
  total_amount      Decimal   @db.Decimal(12, 2)
  status            String    @default("DRAFT") // DRAFT, SENT, ACCEPTED, REJECTED, EXPIRED, CONVERTED, REVISED
  valid_until       DateTime?
  version           Int       @default(1)
  original_quote_id String?
  notes             String?

  /// QUOTE | PROFORMA. A proforma invoice is a quotation with commercial terms
  /// attached and a different name on the paper, so it is a document kind here
  /// rather than a table of its own. Drives the number series, the print
  /// template and what the public page calls itself.
  ///
  /// A quote can be promoted to a proforma; the reverse is deliberately not
  /// allowed, because a PI may already have an advance receipted against it.
  doc_kind          String    @default("QUOTE")

  /// Commercial terms. All null on an ordinary quote — these are what make a
  /// document a PI that a buyer's bank will accept against an LC application.
  ///
  /// `currency` is the one place a non-BDT amount is allowed to reach the
  /// database outside platform billing, and it stops at this table: nothing
  /// posts to the ledger until the PI becomes a sale, and `convertToOrder`
  /// translates at `exchange_rate` on the way through. See
  /// docs/lc-imports-and-proforma-invoice-plan.md §3.
  currency          String    @default("BDT")
  /// BDT per one unit of `currency`, fixed when the document was written.
  /// Required when currency is not BDT, ignored when it is.
  exchange_rate     Decimal?  @db.Decimal(12, 6)
  incoterm          String? // FOB | CFR | CIF | EXW | DDP | DAP | FCA
  port_of_loading   String?
  port_of_discharge String?
  payment_terms     String?
  /// Percentage of the total requested up front. Drives the suggested deposit
  /// when the PI is converted to a sales order.
  advance_percent   Decimal?  @db.Decimal(5, 2)
  /// Days from order to delivery, as promised to the buyer. Deliberately not
  /// `lead_time_days`: `Product.lead_time_days` is the tenant's own
  /// replenishment lead time — internal planning data that a customer-facing
  /// document must never carry — and two fields a line apart in a join with the
  /// same name eventually get copied into each other.
  delivery_lead_time_days Int?
  country_of_origin String?
  /// Unguessable secret authorizing the public view. Clearing it revokes every
  /// link ever shared for this quotation, short or long.
  share_token       String?   @unique
  share_token_at    DateTime?
  created_at        DateTime  @default(now())

  // Relations
  tenant   Tenant          @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  store    Store           @relation(fields: [store_id], references: [id])
  customer Customer?       @relation(fields: [customer_id], references: [id])
  items    QuotationItem[]

  @@unique([tenant_id, quote_number, version])
}

model QuotationItem {
  id           String  @id @default(uuid())
  quotation_id String
  product_id   String
  quantity     Int
  unit_price   Decimal @db.Decimal(12, 2)

  // Relations
  quotation Quotation @relation(fields: [quotation_id], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [product_id], references: [id])
}

model SubscriptionPlan {
  id                      String               @id @default(uuid())
  code                    SubscriptionPlanCode @unique
  name                    String
  description             String?
  monthly_price           Decimal              @db.Decimal(12, 2)
  yearly_price            Decimal?             @db.Decimal(12, 2)
  features_json           Json                 @default("{}")
  marketing_features_json Json                 @default("[]")
  is_active               Boolean              @default(true)
  subscriptions           TenantSubscription[]
}

// ── Add-on modules (independently priced, purchasable regardless of base plan) ──

// Catalog of optional modules a tenant can buy on top of their subscription plan
// (e.g. Manufacturing, Advanced Accounting). `code` is a plain string, not an
// enum, so new add-ons never require a schema migration.
model AddonModule {
  id            String   @id @default(uuid())
  code          String   @unique
  name          String
  description   String?
  category      String?
  monthly_price Decimal  @db.Decimal(12, 2)
  yearly_price  Decimal? @db.Decimal(12, 2)
  features_json Json     @default("{}")
  is_active     Boolean  @default(true)
  sort_order    Int      @default(0)

  subscriptions TenantAddonSubscription[]

  @@index([is_active, sort_order])
}

// A tenant's purchase of a single add-on module, billed independently of but
// alongside the tenant's base TenantSubscription.
model TenantAddonSubscription {
  id                        String             @id @default(uuid())
  tenant_id                 String
  addon_id                  String
  status                    SubscriptionStatus @default(ACTIVE)
  current_period_start      DateTime           @default(now())
  current_period_end        DateTime
  cancel_at_period_end      Boolean            @default(false)
  provider_name             String?
  provider_subscription_ref String?

  tenant Tenant      @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  addon  AddonModule @relation(fields: [addon_id], references: [id])

  @@unique([tenant_id, addon_id])
  @@index([addon_id, status])
}

model CashierSession {
  id           String    @id @default(uuid())
  tenant_id    String
  store_id     String
  counter_id   String?
  user_id      String // The cashier/user who opened the session
  opened_at    DateTime  @default(now())
  closed_at    DateTime?
  opening_cash Decimal   @default(0) @db.Decimal(12, 2)
  closing_cash Decimal   @default(0) @db.Decimal(12, 2)
  status       String    @default("OPEN") // OPEN, CLOSED

  // Relations
  tenant           Tenant            @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  store            Store             @relation(fields: [store_id], references: [id], onDelete: Cascade)
  user             User              @relation(fields: [user_id], references: [id], onDelete: Cascade)
  counter          PosCounter?       @relation(fields: [counter_id], references: [id])
  cashTransactions CashTransaction[]

  @@index([tenant_id, status])
  @@index([tenant_id, counter_id])
}

model CashTransaction {
  id          String   @id @default(uuid())
  tenant_id   String
  session_id  String
  amount      Decimal  @db.Decimal(12, 2) // Positive for cash in, negative for cash out
  type        String // e.g., 'DROP', 'LOAN', 'PAYOUT', 'OTHER'
  description String?
  created_at  DateTime @default(now())

  // Relations
  tenant  Tenant         @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  session CashierSession @relation(fields: [session_id], references: [id], onDelete: Cascade)
}

model TenantSubscription {
  id                        String             @id @default(uuid())
  tenant_id                 String             @unique
  plan_id                   String
  status                    SubscriptionStatus @default(TRIALING)
  current_period_start      DateTime           @default(now())
  current_period_end        DateTime
  cancel_at_period_end      Boolean            @default(false)
  provider_name             String?
  provider_customer_ref     String?
  provider_subscription_ref String?
  // Admin-granted subscription discount applied to future subscription fees.
  // discount_type: 'PERCENTAGE' (value = percent off) | 'FIXED' (value = amount off in BDT).
  discount_type             String?
  discount_value            Decimal?           @db.Decimal(12, 2)

  // Relations
  tenant Tenant           @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  plan   SubscriptionPlan @relation(fields: [plan_id], references: [id])

  @@index([plan_id, status])
}

model BillingEvent {
  id                String   @id @default(uuid())
  tenant_id         String
  provider_name     String
  external_event_id String
  event_type        String
  status            String
  reference_id      String?
  amount            Decimal? @db.Decimal(12, 2)
  currency          String?
  payload           Json
  created_at        DateTime @default(now())

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@unique([provider_name, external_event_id])
  @@index([tenant_id, created_at])
  @@index([tenant_id, provider_name])
}

// ── SMS Credits (prepaid balance the shop spends when sending SMS) ────────────

// Purchasable top-up packages (number of SMS credits for a fixed price).
model SmsPackage {
  id         String   @id @default(uuid())
  name       String
  credits    Int // SMS credits granted on purchase
  price      Decimal  @db.Decimal(12, 2) // price for the package
  currency   String   @default("BDT")
  is_active  Boolean  @default(true)
  sort_order Int      @default(0)
  created_at DateTime @default(now())

  @@index([is_active, sort_order])
}

// Ledger of every change to a tenant's SMS credit balance.
model SmsTransaction {
  id            String   @id @default(uuid())
  tenant_id     String
  type          String // PURCHASE | USAGE | ADJUSTMENT | REFUND
  credits       Int // positive = credited, negative = consumed
  balance_after Int // resulting balance after this entry
  description   String?
  recipient     String? // destination phone number for USAGE entries
  reference     String? // billing/payment reference for PURCHASE entries
  created_at    DateTime @default(now())

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, created_at])
}

// ── Multi-Store Access & Permission Models ───────────────────────────────────

model UserStoreAccess {
  id           String   @id @default(uuid())
  user_id      String
  store_id     String
  tenant_id    String
  // STORE_ONLY = access to exactly this one context
  // MULTI_STORE_CAPABLE = can switch between assigned stores
  access_level String   @default("STORE_ONLY")
  created_at   DateTime @default(now())

  user   User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  store  Store  @relation(fields: [store_id], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@unique([user_id, store_id])
  @@index([tenant_id, store_id])
  @@index([user_id, tenant_id])
}

model UserStorePermission {
  id         String          @id @default(uuid())
  user_id    String
  store_id   String
  tenant_id  String
  permission StorePermission
  granted_by String
  granted_at DateTime        @default(now())

  user   User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  store  Store  @relation(fields: [store_id], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@unique([user_id, store_id, permission])
  @@index([user_id, store_id])
  @@index([tenant_id, store_id, permission])
}

// Store-specific product price overrides.
// store_id = NULL means base price (default for all stores).
model ProductPrice {
  id             String    @id @default(uuid())
  tenant_id      String
  product_id     String
  store_id       String?
  price          Decimal   @db.Decimal(12, 2)
  cost           Decimal?  @db.Decimal(12, 2)
  effective_from DateTime  @default(now())
  effective_to   DateTime?
  created_at     DateTime  @default(now())

  tenant  Tenant  @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)
  store   Store?  @relation(fields: [store_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, product_id, store_id])
  @@index([product_id, store_id, effective_from])
}

model FundTransfer {
  id                     String    @id @default(uuid())
  tenant_id              String
  source_store_id        String
  destination_store_id   String
  amount                 Decimal   @db.Decimal(12, 2)
  method                 String    @default("CASH") // CASH, CHECK, BANK_TRANSFER
  description            String?
  // INITIATED, IN_TRANSIT, RECEIVED, CANCELLED
  status                 String    @default("INITIATED")
  initiated_by           String
  received_by            String?
  // Voucher linkage for accounting integration
  source_voucher_id      String?
  destination_voucher_id String?
  created_at             DateTime  @default(now())
  received_at            DateTime?

  tenant             Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  sourceStore        Store    @relation("FundTransferSourceStore", fields: [source_store_id], references: [id])
  destinationStore   Store    @relation("FundTransferDestinationStore", fields: [destination_store_id], references: [id])
  initiatedByUser    User     @relation("FundTransferInitiator", fields: [initiated_by], references: [id])
  receivedByUser     User?    @relation("FundTransferReceiver", fields: [received_by], references: [id])
  sourceVoucher      Voucher? @relation("FundTransferSourceVoucher", fields: [source_voucher_id], references: [id])
  destinationVoucher Voucher? @relation("FundTransferDestinationVoucher", fields: [destination_voucher_id], references: [id])

  @@index([tenant_id, status, created_at])
  @@index([tenant_id, source_store_id])
  @@index([tenant_id, destination_store_id])
}

// Warranty claim statuses: SUBMITTED, APPROVED, REJECTED, REPAIRED, REPLACED, COMPLETED
model WarrantyClaim {
  id                        String    @id @default(uuid())
  tenant_id                 String
  store_id                  String
  claim_number              String
  serial_number             String
  product_id                String
  sale_id                   String?
  customer_id               String?
  status                    String    @default("SUBMITTED")
  reason                    String
  description               String?
  resolution_notes          String?
  replacement_serial_number String?
  resolved_at               DateTime?
  created_at                DateTime  @default(now())
  updated_at                DateTime  @updatedAt

  tenant   Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  store    Store     @relation(fields: [store_id], references: [id])
  sale     Sale?     @relation(fields: [sale_id], references: [id])
  customer Customer? @relation(fields: [customer_id], references: [id])
  product  Product   @relation(fields: [product_id], references: [id])

  @@unique([tenant_id, claim_number])
  @@index([tenant_id, status, created_at])
  @@index([tenant_id, serial_number])
  @@index([tenant_id, product_id])
  @@index([tenant_id, customer_id])
}

model Feedback {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  type      String // 'bug' | 'feature' | 'general'
  message   String
  page      String?
  createdAt DateTime @default(now())

  /// Admin-driven automation pipeline (propose plan -> approve -> implement -> PR -> rollback).
  /// NEW | ADMIN_REVIEWING | PLAN_REQUESTED | PLAN_PROPOSED | PLAN_APPROVED | CHANGES_REQUESTED
  /// | IN_PROGRESS | PR_OPENED | MERGED | RESOLVED | ROLLED_BACK
  status           String    @default("NEW")
  adminInstruction String?
  prNumber         Int?
  prUrl            String?
  mergeCommitSha   String?
  backupSnapshotId String?
  deployedAt       DateTime?
  lastError        String?
  rollbackPrNumber Int?
  rollbackPrUrl    String?
  updatedAt        DateTime  @updatedAt

  tenant Tenant         @relation(fields: [tenantId], references: [id])
  user   User           @relation(fields: [userId], references: [id])
  plans  FeedbackPlan[]
  thread SupportThread?

  @@map("feedbacks")
}

/// A single version of an agent-proposed implementation plan for a Feedback
/// item, reviewed and approved/rejected by a platform admin before any code
/// is written. Versioned so a "request changes" revision loop keeps history.
model FeedbackPlan {
  id           String    @id @default(cuid())
  feedbackId   String
  version      Int
  planText     String
  hasMigration Boolean   @default(false)
  /// PROPOSED | APPROVED | CHANGES_REQUESTED | SUPERSEDED
  status       String    @default("PROPOSED")
  adminComment String?
  createdAt    DateTime  @default(now())
  reviewedAt   DateTime?
  reviewedBy   String?

  feedback Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  @@index([feedbackId, version])
  @@map("feedback_plans")
}

model ApiKey {
  id         String    @id @default(cuid())
  tenantId   String
  name       String
  key_hash   String    @unique // SHA-256 hash of the actual key
  key_prefix String // first 8 chars for display (e.g. "rsk_live")
  last_used  DateTime?
  created_at DateTime  @default(now())
  revoked_at DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("api_keys")
}

model StorefrontOrder {
  id             String                @id @default(cuid())
  tenantId       String
  customerName   String
  customerEmail  String
  customerPhone  String?
  items          StorefrontOrderItem[]
  totalAmount    Decimal               @db.Decimal(12, 2)
  status         String                @default("PENDING")
  notes          String?
  customerUserId String?
  created_at     DateTime              @default(now())
  updated_at     DateTime              @updatedAt

  tenant       Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerUser User?  @relation(fields: [customerUserId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([customerUserId])
  @@map("storefront_orders")
}

model StorefrontOrderItem {
  id           String  @id @default(cuid())
  orderId      String
  productId    String
  quantity     Int
  priceAtOrder Decimal @db.Decimal(12, 2)

  order   StorefrontOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])

  @@map("storefront_order_items")
}

model DeliveryOrder {
  id              String    @id @default(cuid())
  tenantId        String
  saleId          String?
  customerName    String
  customerPhone   String?
  deliveryAddress String
  driverName      String?
  driverPhone     String?
  status          String    @default("PENDING")
  notes           String?
  scheduledAt     DateTime?
  deliveredAt     DateTime?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sale   Sale?  @relation(fields: [saleId], references: [id])

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("delivery_orders")
}

// Bill of Materials: defines what components go into making 1 unit of a product
model BomRecipe {
  id         String   @id @default(cuid())
  tenantId   String
  productId  String   @unique // the manufactured/output product
  outputQty  Int      @default(1)
  notes      String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product        Product         @relation(fields: [productId], references: [id])
  components     BomComponent[]
  productionJobs ProductionJob[]

  @@index([tenantId])
  @@map("bom_recipes")
}

model BomComponent {
  id        String  @id @default(cuid())
  recipeId  String
  productId String // the raw material / component product
  quantity  Decimal @db.Decimal(12, 4)

  recipe  BomRecipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  product Product   @relation("BomComponent", fields: [productId], references: [id])

  @@map("bom_components")
}

// A production run: manufacture N units of a product
model ProductionJob {
  id           String    @id @default(cuid())
  tenantId     String
  recipeId     String
  productId    String // output product (denormalised for easy querying)
  quantity     Int
  status       String    @default("DRAFT") // DRAFT | IN_PROGRESS | COMPLETED | CANCELLED
  notes        String?
  startedAt    DateTime?
  completedAt  DateTime?
  totalJobCost Decimal?  @db.Decimal(12, 2) // sum of ProductionJobCost lines, snapshotted at completion
  costPerUnit  Decimal?  @db.Decimal(12, 4) // totalJobCost / (quantity * recipe.outputQty)
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  tenant   Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recipe   BomRecipe           @relation(fields: [recipeId], references: [id])
  wastages ProductionWastage[]
  costs    ProductionJobCost[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("production_jobs")
}

// A cost line attached to a production job: either the raw-material cost
// rolled up automatically at completion, or a non-material job cost (printing,
// binding, transport, labor, ...) added manually or allocated from a
// PurchaseItem covering a bill that spans multiple jobs/titles.
model ProductionJobCost {
  id                   String   @id @default(cuid())
  tenantId             String
  jobId                String
  costType             String // RAW_MATERIAL | PRINTING | BINDING | TRANSPORT | LABOR | OVERHEAD | OTHER
  amount               Decimal  @db.Decimal(12, 2)
  sourcePurchaseItemId String? // traceable back to the bill line this cost came from, when there is one
  notes                String?
  created_at           DateTime @default(now())

  tenant             Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  job                ProductionJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  sourcePurchaseItem PurchaseItem? @relation(fields: [sourcePurchaseItemId], references: [id])

  @@index([tenantId, jobId])
  @@map("production_job_costs")
}

// Additional raw-material consumption recorded on top of the standard BOM
// quantities when a production job completes (spoilage, breakage, etc.).
model ProductionWastage {
  id         String   @id @default(cuid())
  tenantId   String
  jobId      String
  productId  String
  quantity   Decimal  @db.Decimal(12, 4)
  note       String?
  created_at DateTime @default(now())

  tenant  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  job     ProductionJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  product Product       @relation("ProductionWastage", fields: [productId], references: [id])

  @@index([tenantId])
  @@index([jobId])
  @@map("production_wastages")
}

model LoyaltyTransaction {
  id          String   @id @default(cuid())
  tenantId    String
  customerId  String
  saleId      String?
  type        String // EARN | REDEEM | ADJUST
  points      Int // positive = earn, negative = redeem/adjust
  description String?
  created_at  DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId, customerId])
  @@index([customerId])
  @@map("loyalty_transactions")
}

model DiscountCode {
  id           String    @id @default(cuid())
  tenantId     String
  code         String
  name         String
  type         String // PERCENTAGE | FIXED
  value        Decimal   @db.Decimal(10, 2) // percent (0-100) or fixed BDT amount
  min_purchase Decimal?  @db.Decimal(12, 2) // minimum cart total to apply
  max_discount Decimal?  @db.Decimal(12, 2) // cap for PERCENTAGE type
  usage_limit  Int? // null = unlimited
  used_count   Int       @default(0)
  valid_from   DateTime?
  valid_until  DateTime?
  is_active    Boolean   @default(true)
  created_at   DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId, is_active])
  @@map("discount_codes")
}

model Notification {
  id         String    @id @default(uuid())
  tenant_id  String
  user_id    String
  type       String // LOW_STOCK | SUBSCRIPTION_EXPIRY | INFO
  title      String
  body       String
  link       String?
  read_at    DateTime?
  created_at DateTime  @default(now())

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, user_id, created_at])
  @@index([user_id, read_at])
}

model Department {
  id         String    @id @default(uuid())
  tenant_id  String
  name       String
  created_at DateTime  @default(now())
  deleted_at DateTime?

  tenant    Tenant     @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  employees Employee[]
  jobPosts  JobPost[]

  @@unique([tenant_id, name])
  @@index([tenant_id, deleted_at])
}

model Designation {
  id         String    @id @default(uuid())
  tenant_id  String
  name       String
  created_at DateTime  @default(now())
  deleted_at DateTime?

  tenant    Tenant     @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  employees Employee[]
  jobPosts  JobPost[]

  @@unique([tenant_id, name])
  @@index([tenant_id, deleted_at])
}

model Employee {
  id               String         @id @default(uuid())
  tenant_id        String
  employee_code    String
  name             String
  phone            String
  email            String?
  nid              String?
  date_of_joining  DateTime?
  department_id    String?
  designation_id   String?
  user_id          String?        @unique
  basic_salary     Decimal?       @db.Decimal(12, 2)
  status           EmployeeStatus @default(ACTIVE)
  /// Why they left, in the tenant's own words. The status says which category;
  /// this says what happened. Nothing recorded either of them before Phase 12.
  exit_reason      String?
  /// The last day they were on the payroll. Distinct from the status change
  /// date: someone can resign in March to leave in May.
  last_working_day DateTime?      @db.Date
  exit_notes       String?

  /// Whether this employee may use the self-service portal. Distinct from
  /// `user_id`: linking a login is how staff get an ERP account, and most
  /// linked employees are staff who should keep using the admin screens.
  /// Portal access is a deliberate, separately revocable grant on top.
  portal_access Boolean   @default(false)
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  deleted_at    DateTime?

  tenant                  Tenant                    @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  department              Department?               @relation(fields: [department_id], references: [id])
  designation             Designation?              @relation(fields: [designation_id], references: [id])
  user                    User?                     @relation(fields: [user_id], references: [id])
  attendanceRecords       AttendanceRecord[]
  attendancePunches       AttendancePunch[]
  leaveBalances           LeaveBalance[]
  leaveRequests           LeaveRequest[]
  salaryPayments          SalaryPayment[]
  salaryAccruals          SalaryAccrual[]
  projectTimeEntries      ProjectTimeEntry[]
  projectMemberships      ProjectMember[]           @relation("ProjectMemberEmployee")
  projectTasksAssigned    ProjectTask[]             @relation("ProjectTaskAssigneeEmployee")
  EmployeeSchedule        EmployeeSchedule[]
  OvertimeRecord          OvertimeRecord[]
  AttendanceMonthSnapshot AttendanceMonthSnapshot[]
  EmployeeSalaryStructure EmployeeSalaryStructure[]
  EmployeeBankAccount     EmployeeBankAccount?
  PayrollLine             PayrollLine[]
  PayrollAdjustment       PayrollAdjustment[]
  ExpenseClaim            ExpenseClaim[]
  AssetAssignment         AssetAssignment[]
  PolicyAcknowledgement   PolicyAcknowledgement[]
  EmployeeDocument        EmployeeDocument[]
  EmployeeChecklistItem   EmployeeChecklistItem[]
  jobPostsManaged         JobPost[]                 @relation("JobPostHiringManager")
  hiredFromApplication    JobApplication?           @relation("JobApplicationHire")

  @@unique([tenant_id, employee_code])
  @@unique([tenant_id, phone])
  @@index([tenant_id, status, deleted_at])
  @@index([tenant_id, department_id])
  @@index([tenant_id, designation_id])
}

model LeaveType {
  id            String @id @default(uuid())
  tenant_id     String
  name          String
  days_per_year Float  @default(0)

  /// ANNUAL_GRANT gives the whole entitlement on 1 January.
  /// MONTHLY_ACCRUAL gives `days_per_year / 12` each month, which is what
  /// stops a January joiner taking a full year's leave in February.
  accrual_mode String @default("ANNUAL_GRANT")

  /// Unused days that survive into next year, capped. Null means none carry.
  /// A cap rather than a boolean because "carry everything forever" is how a
  /// tenant ends up owing somebody 90 days.
  carry_forward_max_days Float?

  /// Whether unused days can be paid out instead of carried. Informational
  /// today — the payout itself is a payroll adjustment, deliberately not
  /// automated, because encashing leave is a money decision.
  allows_encashment Boolean @default(false)

  /// Half-day leave. `LeaveRequest.days` has always been a float; nothing
  /// treated 0.5 as meaningful, so this makes the intent explicit and lets a
  /// type refuse it.
  allows_half_day Boolean @default(true)

  /// A medical certificate on sick leave, for example. Enforced on submission.
  requires_attachment Boolean @default(false)

  /// How many approvals a request of this type needs. 1 is the current
  /// behaviour and stays the default.
  approval_levels Int @default(1)

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  tenant   Tenant         @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  balances LeaveBalance[]
  requests LeaveRequest[]

  @@unique([tenant_id, name])
  @@index([tenant_id, deleted_at])
}

model LeaveBalance {
  id            String   @id @default(uuid())
  tenant_id     String
  employee_id   String
  leave_type_id String
  year          Int
  total_days    Float    @default(0)
  used_days     Float    @default(0)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  tenant     Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  employee   Employee  @relation(fields: [employee_id], references: [id], onDelete: Cascade)
  leave_type LeaveType @relation(fields: [leave_type_id], references: [id])

  @@unique([tenant_id, employee_id, leave_type_id, year])
  @@index([tenant_id, employee_id])
}

model AttendanceRecord {
  id          String           @id @default(uuid())
  tenant_id   String
  employee_id String
  date        DateTime         @db.Date
  clock_in    DateTime?
  clock_out   DateTime?
  status      AttendanceStatus @default(PRESENT)
  notes       String?

  /// Derived from the employee's schedule when the row is written, not on read.
  /// Stored rather than computed because the schedule can change afterwards and
  /// a past day must keep the figures it earned at the time.
  late_minutes        Int @default(0)
  early_leave_minutes Int @default(0)
  worked_minutes      Int @default(0)
  /// Raw minutes past the scheduled end. Becoming *payable* overtime needs an
  /// approval, which is Phase 4 — this is only the observation.
  overtime_minutes    Int @default(0)

  /// Where the row came from: ADMIN (typed by staff), SELF (the employee's own
  /// check-in), LEAVE (written by a leave approval) or IMPORT. Worth storing
  /// because "who says you were here" is the first question asked of any
  /// attendance dispute.
  source String @default("ADMIN")

  /// Captured only when geofencing is on. Null on every row where it is off,
  /// which is the majority — this is deliberately not a required field.
  clock_in_lat  Float?
  clock_in_lng  Float?
  clock_out_lat Float?
  clock_out_lng Float?
  /// The store the check-in was matched to, when geofencing resolved one.
  store_id      String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employee_id], references: [id], onDelete: Cascade)
  store    Store?   @relation(fields: [store_id], references: [id])

  @@unique([tenant_id, employee_id, date])
  @@index([tenant_id, date])
  @@index([tenant_id, employee_id, date])
}

/// One in or out event for an employee — a single tap of the clock.
///
/// `AttendanceRecord` holds one row per employee per day and can therefore only
/// remember one arrival and one departure. That is a lie on any day with a
/// midday errand, a split shift or a forgotten tap corrected later, and it left
/// nowhere to record *why* a time changed. This table is the raw log; the day
/// row is derived from it — **first IN of the day becomes `clock_in`, last OUT
/// becomes `clock_out`** — so the summary can always be rebuilt from evidence
/// rather than being the only copy of it.
///
/// Deliberately not an enum for `direction`: `AttendanceRecord.source` is a
/// plain string for the same reason, and a two-value enum costs a migration the
/// first time a tenant wants BREAK_START.
model AttendancePunch {
  id          String   @id @default(uuid())
  tenant_id   String
  employee_id String
  /// Local midnight of the day this punch is counted against, matching
  /// `AttendanceRecord.date`. Stored rather than derived on read because it is
  /// the grouping key for the rebuild and every query filters on it.
  date        DateTime @db.Date
  punched_at  DateTime
  /// IN | OUT
  direction   String
  /// Where the punch came from: ADMIN (typed by staff), SELF (the employee's
  /// own check-in) or IMPORT. Carried up onto the day row it produces.
  source      String   @default("ADMIN")
  /// Why an admin typed or corrected this one. The question every attendance
  /// dispute ends at.
  notes       String?

  /// Captured only when geofencing is on, mirroring `AttendanceRecord`.
  latitude  Float?
  longitude Float?
  store_id  String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employee_id], references: [id], onDelete: Cascade)
  store    Store?   @relation(fields: [store_id], references: [id])

  @@index([tenant_id, employee_id, date])
  @@index([tenant_id, date])
  @@map("attendance_punches")
}

/// A reusable onboarding or offboarding step for the tenant.
model ChecklistTemplate {
  id          String   @id @default(uuid())
  tenant_id   String
  /// ONBOARDING | OFFBOARDING
  kind        String
  title       String
  description String?
  sort_order  Int      @default(0)
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, kind, title])
  @@index([tenant_id, kind])
  @@map("checklist_templates")
}

/// One step for one employee.
///
/// The title is **copied** from the template rather than referenced, so
/// renaming or retiring a template does not rewrite the history of everyone
/// who already completed it.
model EmployeeChecklistItem {
  id           String    @id @default(uuid())
  tenant_id    String
  employee_id  String
  /// ONBOARDING | OFFBOARDING
  kind         String
  title        String
  description  String?
  sort_order   Int       @default(0)
  completed_at DateTime?
  completed_by String?
  notes        String?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  tenant   Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employee_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, employee_id, kind])
  @@map("employee_checklist_items")
}

/// Something the business handed an employee and expects back.
///
/// Not `FixedAsset`-only, and that is the load-bearing decision here: most
/// assigned things — a SIM, a uniform, a set of keys — are below any
/// capitalisation threshold and will never be a `FixedAsset`. So `item_name` is
/// always present and `fixed_asset_id` is the optional link, rather than the
/// other way round.
///
/// The accounting side of `FixedAsset` needs nothing from this: depreciation is
/// unaffected by who is holding the laptop.
model AssetAssignment {
  id             String  @id @default(uuid())
  tenant_id      String
  employee_id    String
  /// Set when the item is a capitalised asset. Null for a SIM or a uniform.
  fixed_asset_id String?

  item_name     String
  serial_number String?
  quantity      Int     @default(1)

  assigned_on   DateTime  @db.Date
  returned_on   DateTime? @db.Date
  condition_out String?
  condition_in  String?

  /// When the employee confirmed they hold it, from the portal. The whole
  /// point of the acknowledgement: an unacknowledged handover is one person's
  /// word, which is exactly the situation this model exists to end.
  acknowledged_at DateTime?

  notes      String?
  created_by String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant     Tenant      @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  employee   Employee    @relation(fields: [employee_id], references: [id], onDelete: Cascade)
  fixedAsset FixedAsset? @relation(fields: [fixed_asset_id], references: [id])

  @@index([tenant_id, employee_id])
  @@index([tenant_id, returned_on])
  @@map("asset_assignments")
}

/// A company policy or notice published to employees.
model Policy {
  id                       String    @id @default(uuid())
  tenant_id                String
  title                    String
  /// POLICY | NOTICE — a handbook section versus a one-off announcement.
  kind                     String    @default("POLICY")
  body                     String
  /// Null while a draft. Employees only ever see published ones.
  published_at             DateTime?
  /// Whether every employee must acknowledge it. Acknowledgement is the part
  /// with actual value — a PDF on a shared drive already solves distribution.
  requires_acknowledgement Boolean   @default(false)
  effective_from           DateTime? @db.Date

  created_by String?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  tenant           Tenant                  @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  acknowledgements PolicyAcknowledgement[]

  @@index([tenant_id, published_at])
  @@map("policies")
}

model PolicyAcknowledgement {
  id              String   @id @default(uuid())
  tenant_id       String
  policy_id       String
  employee_id     String
  acknowledged_at DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  policy   Policy   @relation(fields: [policy_id], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employee_id], references: [id], onDelete: Cascade)

  @@unique([policy_id, employee_id])
  @@index([tenant_id, employee_id])
  @@map("policy_acknowledgements")
}

/// A document held on an employee's file — contract, NID scan, certificate.
///
/// `Employee` stores an encrypted NID *string* and no files at all. This is
/// what HR actually spends its filing time on.
///
/// Same `uploadBuffer()` + `storage_key` rule as expense receipts: without the
/// key the file cannot be purged and bills forever.
model EmployeeDocument {
  id          String @id @default(uuid())
  tenant_id   String
  employee_id String

  /// CONTRACT | OFFER_LETTER | NID | PASSPORT | CERTIFICATE | OTHER. A plain
  /// string rather than an enum so a new kind does not need a migration.
  kind  String @default("OTHER")
  title String

  file_url    String
  file_name   String
  mime_type   String?
  file_size   Int?
  storage_key String?

  /// Drives the expiry reminder. Null for a document that does not expire.
  expires_on         DateTime? @db.Date
  /// Set when a reminder has been sent, so the cron does not send it daily.
  expiry_notified_at DateTime?

  uploaded_by String?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?

  tenant   Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employee_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, employee_id])
  @@index([tenant_id, expires_on])
  @@map("employee_documents")
}

/// An employee's expense claim.
///
/// Distinct from `ExpenseEntry`, which is a company-level accounting row with
/// no employee and no lifecycle. This is the employee-facing side: they submit
/// it, someone approves it, and it is reimbursed.
///
/// The approval fields mirror `LeaveRequest` field for field. That is
/// deliberate — two approval flows that look different to a manager for no
/// reason is worse than a little duplication.
model ExpenseClaim {
  id           String   @id @default(uuid())
  tenant_id    String
  employee_id  String
  title        String
  /// DRAFT | SUBMITTED | APPROVED | REJECTED | REIMBURSED | CANCELLED
  status       String   @default("DRAFT")
  claim_date   DateTime @db.Date
  total_amount Decimal  @default(0) @db.Decimal(12, 2)
  notes        String?

  approved_by   String?
  approved_at   DateTime?
  approver_note String?

  /// How it was settled: DIRECT (its own payment) or PAYROLL (an earning
  /// adjustment on a run). Null until reimbursed.
  reimbursed_via String?
  reimbursed_at  DateTime?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  tenant      Tenant                   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  employee    Employee                 @relation(fields: [employee_id], references: [id], onDelete: Cascade)
  lines       ExpenseClaimLine[]
  attachments ExpenseClaimAttachment[]

  @@index([tenant_id, status])
  @@index([tenant_id, employee_id, status])
  @@map("expense_claims")
}

model ExpenseClaimLine {
  id          String   @id @default(uuid())
  claim_id    String
  category_id String?
  description String
  amount      Decimal  @db.Decimal(12, 2)
  spent_on    DateTime @db.Date

  claim    ExpenseClaim     @relation(fields: [claim_id], references: [id], onDelete: Cascade)
  category ExpenseCategory? @relation(fields: [category_id], references: [id])

  @@index([claim_id])
  @@map("expense_claim_lines")
}

/// A receipt.
///
/// `storage_key` is mandatory in spirit: the older `uploadFile()` path returns
/// only a URL, which cannot be turned back into a Cloudinary handle, so a row
/// deleted without one strands the file and bills forever. This model exists on
/// the `uploadBuffer()` side of that split from the start — same shape as
/// `CrmContactAttachment`.
model ExpenseClaimAttachment {
  id        String @id @default(uuid())
  tenant_id String
  claim_id  String

  file_url    String
  file_name   String
  mime_type   String?
  file_size   Int?
  storage_key String?

  uploaded_by String?
  created_at  DateTime @default(now())

  tenant Tenant       @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  claim  ExpenseClaim @relation(fields: [claim_id], references: [id], onDelete: Cascade)

  @@index([claim_id])
  @@map("expense_claim_attachments")
}

/// A month's payroll, from draft to paid.
///
/// `kind` separates the regular monthly run from off-cycle ones (a festival
/// bonus, a final settlement) so both can exist for the same month without
/// colliding on the unique key.
model PayrollRun {
  id          String    @id @default(uuid())
  tenant_id   String
  year        Int
  month       Int
  /// REGULAR | BONUS | FINAL_SETTLEMENT
  kind        String    @default("REGULAR")
  /// DRAFT | APPROVED | PAID | CANCELLED
  /// DRAFT is recomputable; APPROVED is frozen; PAID has been disbursed.
  status      String    @default("DRAFT")
  label       String?
  notes       String?
  approved_by String?
  approved_at DateTime?
  paid_at     DateTime?
  created_by  String?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  tenant Tenant        @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  lines  PayrollLine[]

  @@unique([tenant_id, year, month, kind])
  @@index([tenant_id, status])
  @@map("payroll_runs")
}

/// One employee's pay for one run.
///
/// Every input is **copied onto the line**, not referenced: the attendance
/// figures, the structure amounts, the rates. A payslip issued in August must
/// still render in December even after the employee's structure changed, and a
/// line that reaches back into live tables cannot promise that.
model PayrollLine {
  id          String @id @default(uuid())
  run_id      String
  tenant_id   String
  employee_id String

  /// Attendance inputs, copied from the frozen month snapshot.
  scheduled_days            Int   @default(0)
  present_days              Float @default(0)
  absent_days               Int   @default(0)
  leave_days                Int   @default(0)
  approved_overtime_minutes Int   @default(0)

  gross_earnings        Decimal @default(0) @db.Decimal(12, 2)
  overtime_amount       Decimal @default(0) @db.Decimal(12, 2)
  absence_deduction     Decimal @default(0) @db.Decimal(12, 2)
  structure_deductions  Decimal @default(0) @db.Decimal(12, 2)
  adjustment_earnings   Decimal @default(0) @db.Decimal(12, 2)
  adjustment_deductions Decimal @default(0) @db.Decimal(12, 2)
  total_deductions      Decimal @default(0) @db.Decimal(12, 2)
  net_pay               Decimal @default(0) @db.Decimal(12, 2)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  run      PayrollRun        @relation(fields: [run_id], references: [id], onDelete: Cascade)
  tenant   Tenant            @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  employee Employee          @relation(fields: [employee_id], references: [id])
  items    PayrollLineItem[]

  @@unique([run_id, employee_id])
  @@index([tenant_id, employee_id])
  @@map("payroll_lines")
}

/// A single row on the payslip.
model PayrollLineItem {
  id         String  @id @default(uuid())
  line_id    String
  /// EARNING | DEDUCTION
  kind       String
  name       String
  amount     Decimal @db.Decimal(12, 2)
  /// How it was arrived at — "50% of basic", "3 days absent". The payslip's
  /// whole job is answering "why this number".
  note       String?
  sort_order Int     @default(0)

  line PayrollLine @relation(fields: [line_id], references: [id], onDelete: Cascade)

  @@index([line_id])
  @@map("payroll_line_items")
}

/// A one-off addition or deduction for an employee in a period.
///
/// Covers advance recovery, a fine, a spot bonus — anything that is not part of
/// the standing structure. Deliberately not an instalment engine: a staff
/// advance recovered over four months is four adjustments, which is honest
/// about what the system knows rather than pretending to a schedule it does
/// not have.
model PayrollAdjustment {
  id             String   @id @default(uuid())
  tenant_id      String
  employee_id    String
  year           Int
  month          Int
  /// EARNING | DEDUCTION
  kind           String
  name           String
  amount         Decimal  @db.Decimal(12, 2)
  note           String?
  /// Set once a run has consumed it, so it cannot be applied twice.
  applied_run_id String?
  created_by     String?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employee_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, year, month])
  @@index([tenant_id, employee_id])
  @@map("payroll_adjustments")
}

/// A named earning or deduction a tenant can put on a salary structure.
///
/// Tenant-level definitions, seeded with the standard Bangladeshi split (basic,
/// house rent, medical, conveyance) so a new tenant does not start from an
/// empty screen.
model SalaryComponent {
  id          String    @id @default(uuid())
  tenant_id   String
  name        String
  /// EARNING | DEDUCTION
  kind        String
  /// FIXED = a taka amount; PERCENT_OF_BASIC = a percentage of the structure's
  /// basic line. Percentages are the norm here — house rent is conventionally
  /// 50% of basic — and storing the intent rather than the computed figure is
  /// what makes a salary revision one edit instead of five.
  calculation String    @default("FIXED")
  /// Whether this earning counts toward taxable income. Phase 13 reads it.
  is_taxable  Boolean   @default(true)
  /// The one component every structure needs. Exactly one per tenant, enforced
  /// by the service — Prisma cannot express a partial unique index and
  /// `db push` would not create a raw one.
  is_basic    Boolean   @default(false)
  sort_order  Int       @default(0)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?

  tenant Tenant                        @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  lines  EmployeeSalaryStructureLine[]

  @@unique([tenant_id, name])
  @@index([tenant_id, deleted_at])
  @@map("salary_components")
}

/// An employee's pay composition, from a date.
///
/// A revision is a new row, not an edit: recomputing March must use March's
/// structure. Same reasoning as `EmployeeSchedule`, and for the same reason —
/// payroll re-runs.
model EmployeeSalaryStructure {
  id             String   @id @default(uuid())
  tenant_id      String
  employee_id    String
  effective_from DateTime @db.Date
  note           String?
  created_by     String?
  created_at     DateTime @default(now())

  tenant   Tenant                        @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  employee Employee                      @relation(fields: [employee_id], references: [id], onDelete: Cascade)
  lines    EmployeeSalaryStructureLine[]

  @@unique([tenant_id, employee_id, effective_from])
  @@index([tenant_id, employee_id])
  @@map("employee_salary_structures")
}

model EmployeeSalaryStructureLine {
  id           String  @id @default(uuid())
  structure_id String
  component_id String
  /// A taka amount when the component is FIXED, a percentage when it is
  /// PERCENT_OF_BASIC. Which one is decided by the component, not stored twice.
  value        Decimal @db.Decimal(12, 2)

  structure EmployeeSalaryStructure @relation(fields: [structure_id], references: [id], onDelete: Cascade)
  component SalaryComponent         @relation(fields: [component_id], references: [id])

  @@unique([structure_id, component_id])
  @@map("employee_salary_structure_lines")
}

/// Where an employee's pay is sent.
///
/// Split from `Employee` because it is the most sensitive thing the HR module
/// holds and it wants its own read path: an account number is needed by the
/// disbursement export and by nobody else.
model EmployeeBankAccount {
  id             String   @id @default(uuid())
  tenant_id      String
  employee_id    String   @unique
  /// BANK | BKASH | NAGAD | CASH
  method         String   @default("CASH")
  bank_name      String?
  branch_name    String?
  /// Encrypted at rest through `EncryptionService`, same as NID.
  account_number String?
  account_name   String?
  routing_number String?
  /// Encrypted. The bKash/Nagad wallet number.
  wallet_number  String?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employee_id], references: [id], onDelete: Cascade)

  @@index([tenant_id])
  @@map("employee_bank_accounts")
}

/// Overtime worked on a day, and whether anyone has agreed to pay for it.
///
/// Separate from the `overtime_minutes` already on `AttendanceRecord`: that
/// column is the *observation* (they were still clocked in at 8pm), this is the
/// *decision*. Unapproved overtime must never reach payroll, and conflating the
/// two would mean staying late was self-authorising.
model OvertimeRecord {
  id          String    @id @default(uuid())
  tenant_id   String
  employee_id String
  date        DateTime  @db.Date
  minutes     Int
  /// PENDING | APPROVED | REJECTED
  status      String    @default("PENDING")
  approved_by String?
  approved_at DateTime?
  note        String?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  tenant   Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employee_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, employee_id, date])
  @@index([tenant_id, status])
  @@index([tenant_id, employee_id, date])
  @@map("overtime_records")
}

/// A month of attendance, reduced to the numbers payroll needs.
///
/// The point of storing this rather than aggregating on demand is `frozen_at`.
/// A payroll run reads a frozen snapshot, so re-running it next week cannot
/// silently produce different pay because someone corrected an attendance row
/// in the meantime. Until it is frozen it is a cache and is rebuilt freely.
model AttendanceMonthSnapshot {
  id          String @id @default(uuid())
  tenant_id   String
  employee_id String
  year        Int
  month       Int

  present_days   Float @default(0)
  absent_days    Int   @default(0)
  half_days      Int   @default(0)
  leave_days     Int   @default(0)
  holiday_days   Int   @default(0)
  late_days      Int   @default(0)
  /// Days the employee was scheduled to work, holidays excluded.
  scheduled_days Int   @default(0)

  worked_minutes            Int @default(0)
  late_minutes              Int @default(0)
  /// Approved only. The raw observation stays on the attendance rows.
  approved_overtime_minutes Int @default(0)

  /// Set when a payroll run consumes this month. Non-null means immutable.
  frozen_at  DateTime?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  tenant   Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employee_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, employee_id, year, month])
  @@index([tenant_id, year, month])
  @@map("attendance_month_snapshots")
}

/// Per-tenant attendance policy.
///
/// One row per tenant, mirroring `SalesSettings`. Everything here has a working
/// default, so a tenant that never opens the screen still gets sane behaviour —
/// the row exists to be *changed*, not to make the feature work.
model AttendanceSettings {
  id                   String   @id @default(uuid())
  tenant_id            String   @unique
  /// Whether employees may clock themselves in and out at all. On by default:
  /// the portal is the point, and an admin can still type a row either way.
  self_service_enabled Boolean  @default(true)
  /// Off by default. Location capture is a deliberate act, not something a
  /// tenant should discover they enabled by upgrading.
  geofence_enabled     Boolean  @default(false)
  /// How far from a store a check-in may be, in metres. 200m is generous
  /// enough for phone GPS drift in a dense city without covering the next block.
  geofence_radius_m    Int      @default(200)
  /// Minutes after the scheduled start before an arrival counts as late.
  grace_minutes        Int      @default(15)
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@map("attendance_settings")
}

model LeaveRequest {
  id            String             @id @default(uuid())
  tenant_id     String
  employee_id   String
  leave_type_id String
  start_date    DateTime           @db.Date
  end_date      DateTime           @db.Date
  days          Float
  reason        String?
  status        LeaveRequestStatus @default(PENDING)
  approved_by   String?
  approved_at   DateTime?
  approver_note String?
  created_at    DateTime           @default(now())
  updated_at    DateTime           @updatedAt
  deleted_at    DateTime?

  /// How far through the approval chain it is. 0 until the first approval.
  /// Compared against `LeaveType.approval_levels` to decide whether one more
  /// signature is needed or the request is done.
  approvals_given Int @default(0)

  tenant      Tenant                   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  employee    Employee                 @relation(fields: [employee_id], references: [id], onDelete: Cascade)
  leave_type  LeaveType                @relation(fields: [leave_type_id], references: [id])
  approver    User?                    @relation("LeaveApprover", fields: [approved_by], references: [id])
  approvals   LeaveRequestApproval[]
  attachments LeaveRequestAttachment[]

  @@index([tenant_id, employee_id, status])
  @@index([tenant_id, status, start_date])
}

/// One signature on a leave request.
///
/// `LeaveRequest.approved_by` is a single user and stays as the *final*
/// approver for compatibility; this table is the chain behind it. A row per
/// level rather than a status column, so "who signed, when, and what they said"
/// survives a later rejection.
model LeaveRequestApproval {
  id          String   @id @default(uuid())
  tenant_id   String
  request_id  String
  level       Int
  /// APPROVED | REJECTED
  decision    String
  approver_id String
  note        String?
  decided_at  DateTime @default(now())

  tenant  Tenant       @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  request LeaveRequest @relation(fields: [request_id], references: [id], onDelete: Cascade)

  @@unique([request_id, level])
  @@index([tenant_id, request_id])
  @@map("leave_request_approvals")
}

/// A medical certificate or similar, attached to a leave request.
model LeaveRequestAttachment {
  id         String @id @default(uuid())
  tenant_id  String
  request_id String

  file_url    String
  file_name   String
  mime_type   String?
  file_size   Int?
  storage_key String?

  uploaded_by String?
  created_at  DateTime @default(now())

  tenant  Tenant       @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  request LeaveRequest @relation(fields: [request_id], references: [id], onDelete: Cascade)

  @@index([request_id])
  @@map("leave_request_attachments")
}

/// A non-working day for the whole tenant.
///
/// Deliberately tenant-wide rather than per-store: a per-store scope would need
/// `@@unique([tenant_id, date, store_id])`, and Postgres treats NULLs as
/// distinct in a unique index, so two tenant-wide rows for the same date would
/// both be accepted. Eid is a national holiday; when a tenant needs a
/// store-specific closure, that is a different feature with a different name.
model Holiday {
  id         String   @id @default(uuid())
  tenant_id  String
  date       DateTime @db.Date
  name       String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, date])
  @@index([tenant_id, date])
  @@map("holidays")
}

/// The hours an employee is expected to work — the baseline attendance is
/// measured against. Without it, "late" and "overtime" are both uncomputable,
/// which is why this ships before attendance capture rather than with it.
model WorkSchedule {
  id         String    @id @default(uuid())
  tenant_id  String
  name       String
  /// Exactly one per tenant. Enforced by the service, not the database: a
  /// partial unique index on `is_default = true` is not expressible in Prisma
  /// schema, and `db push` would not create a raw one.
  is_default Boolean   @default(false)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  tenant    Tenant             @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  days      WorkScheduleDay[]
  employees EmployeeSchedule[]

  @@unique([tenant_id, name])
  @@index([tenant_id, deleted_at])
  @@map("work_schedules")
}

/// One row per weekday of a schedule.
///
/// Times are **minutes from local midnight**, not `DateTime`. A schedule says
/// "work starts at 9am" — a wall-clock fact with no date and no instant behind
/// it. Storing it as a timestamp would attach a timezone to a concept that has
/// none, and every read would have to strip it back off.
model WorkScheduleDay {
  id            String  @id @default(uuid())
  schedule_id   String
  /// 0 = Sunday … 6 = Saturday, matching JavaScript's `Date#getDay()`.
  weekday       Int
  is_working    Boolean @default(true)
  start_minute  Int?
  end_minute    Int?
  break_minutes Int     @default(0)

  schedule WorkSchedule @relation(fields: [schedule_id], references: [id], onDelete: Cascade)

  @@unique([schedule_id, weekday])
  @@map("work_schedule_days")
}

/// Which schedule an employee is on, from when.
///
/// A row per change rather than a column on `Employee`, so that recomputing a
/// past month uses the schedule that was in force then. Payroll reruns are the
/// whole reason this is dated.
model EmployeeSchedule {
  id             String   @id @default(uuid())
  tenant_id      String
  employee_id    String
  schedule_id    String
  effective_from DateTime @db.Date
  created_at     DateTime @default(now())

  tenant   Tenant       @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  employee Employee     @relation(fields: [employee_id], references: [id], onDelete: Cascade)
  schedule WorkSchedule @relation(fields: [schedule_id], references: [id])

  @@unique([tenant_id, employee_id, effective_from])
  @@index([tenant_id, employee_id])
  @@map("employee_schedules")
}

/// A vacancy the tenant is hiring for.
///
/// Deliberately separate from `Designation`: a designation is a title the org
/// chart uses forever, a job post is one round of hiring for it, with its own
/// headcount, salary band and closing date. Two posts can name the same
/// designation a year apart and neither should overwrite the other.
model JobPost {
  id                String            @id @default(uuid())
  tenant_id         String
  /// Per-tenant human reference (`JOB-00001`), generated on create. Candidates
  /// and interviewers quote this; the uuid is not something anyone can read out
  /// over the phone.
  code              String
  title             String
  department_id     String?
  designation_id    String?
  employment_type   JobEmploymentType @default(FULL_TIME)
  location          String?
  /// How many people this post is hiring. Drives "filled" — one post can take
  /// three hires before it is done.
  openings          Int               @default(1)
  salary_min        Decimal?          @db.Decimal(12, 2)
  salary_max        Decimal?          @db.Decimal(12, 2)
  description       String?
  requirements      String?
  status            JobPostStatus     @default(DRAFT)
  /// Whether this vacancy is listed on the public, cross-tenant careers board.
  ///
  /// Separate from `status` and defaulting to false on purpose. OPEN already
  /// meant "we are hiring for this internally", and letting the careers board
  /// reuse it would have retroactively published every existing OPEN post the
  /// moment this shipped. Advertising to the open internet is a decision a
  /// workspace makes per post, so it gets its own switch.
  publish_to_board  Boolean           @default(false)
  /// When the post went live. Null while it is a draft.
  opened_at         DateTime?         @db.Date
  closing_date      DateTime?         @db.Date
  /// Who owns the hire. An employee rather than a user, because the manager
  /// asking for the headcount often has no ERP login.
  hiring_manager_id String?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  tenant        Tenant           @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  department    Department?      @relation(fields: [department_id], references: [id])
  designation   Designation?     @relation(fields: [designation_id], references: [id])
  hiringManager Employee?        @relation("JobPostHiringManager", fields: [hiring_manager_id], references: [id])
  applications  JobApplication[]

  @@unique([tenant_id, code])
  @@index([tenant_id, status, deleted_at])
  @@index([tenant_id, department_id])
  @@map("job_posts")
}

/// A person who has applied, once, for the whole tenant.
///
/// Kept apart from `JobApplication` so somebody who applies for three roles
/// over two years is one candidate with a history, not three unlinked rows —
/// which is the difference between "we have spoken to them before" and finding
/// out in the interview. Not an `Employee`: most applicants never become one,
/// and the ones who do get an employee record at the point of hire.
model Applicant {
  id                  String   @id @default(uuid())
  tenant_id           String
  name                String
  phone               String
  email               String?
  /// Where they came from — referral, Facebook, walk-in. Free text because
  /// every tenant's channel list is different and none of it drives logic.
  source              String?
  current_company     String?
  current_designation String?
  experience_years    Decimal? @db.Decimal(4, 1)
  expected_salary     Decimal? @db.Decimal(12, 2)
  /// Uploaded CV. A URL, not a blob — file storage already goes to Cloudinary.
  resume_url          String?
  /// Comma-separated, entered by hand. A tag table would be the right shape if
  /// anything searched on it structurally; nothing does yet.
  skills              String?
  notes               String?
  address             String?

  /// Set when this candidate record belongs to a careers-portal login.
  ///
  /// Null is the normal case and stays the normal case: most candidates are
  /// typed in by HR and never sign in. It is filled either because the person
  /// applied through the public board, or because they later signed up and
  /// *claimed* an existing record — see `CareersService.resolveApplicant`, and
  /// note the claim needs a verified email or mobile, because `@@unique([tenant_id, phone])`
  /// means an unverified match would otherwise hand somebody another person's
  /// interview history.
  user_id String?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  tenant       Tenant           @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  user         User?            @relation("ApplicantUser", fields: [user_id], references: [id])
  applications JobApplication[]

  @@unique([tenant_id, phone])
  /// One candidate record per login per company. The portal reads a person's
  /// applications by walking these, so a second row would split their history.
  @@unique([tenant_id, user_id])
  @@index([tenant_id, deleted_at])
  @@index([user_id])
  @@map("applicants")
}

/// One person's platform-wide candidate profile — the careers-portal login.
///
/// Deliberately global where `Applicant` is tenant-scoped, and that difference
/// is the whole feature: somebody fills this in once and applies to any number
/// of companies, and `Applicant` is the per-company copy each hiring workspace
/// actually works with. Applying snapshots this profile into the tenant's
/// `Applicant` row rather than the workspace reading across the boundary.
model JobSeeker {
  id            String    @id @default(uuid())
  user_id       String    @unique
  full_name     String
  /// Required before applying, because `Applicant.phone` is non-null and is the
  /// key a hiring workspace de-duplicates candidates on.
  phone         String?
  /// One-line "Senior Accountant, 6 years" self-description.
  headline      String?
  location      String?
  summary       String?
  /// The default CV, copied onto the tenant's `Applicant` at apply time so a
  /// later profile edit does not silently rewrite what a company reviewed.
  resume_url    String?
  resume_name   String?
  linkedin_url  String?
  portfolio_url String?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  deleted_at    DateTime?

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("job_seekers")
}

/// One candidate against one vacancy — the row that actually moves.
model JobApplication {
  id                String              @id @default(uuid())
  tenant_id         String
  job_post_id       String
  applicant_id      String
  stage             JobApplicationStage @default(APPLIED)
  applied_at        DateTime            @default(now())
  /// When the stage last changed, so "sitting in screening for three weeks" is
  /// answerable without walking the event log.
  stage_changed_at  DateTime            @default(now())
  /// Overrides the applicant's general expectation when they name a figure for
  /// this specific role.
  expected_salary   Decimal?            @db.Decimal(12, 2)
  /// Interviewer's score, 1–5. Null until somebody has met them.
  rating            Int?
  source            String?
  notes             String?
  /// The candidate's own note, written when they applied through the public
  /// careers board. Kept apart from `notes` — which is the workspace's
  /// editable field — so an interviewer cannot overwrite what the applicant
  /// said, and so the application screen can attribute it correctly.
  cover_letter      String?
  /// Why they were rejected, in the tenant's words. Only meaningful on REJECTED.
  rejection_reason  String?
  /// Set when the application ends in a hire. The link is what makes "how long
  /// from application to joining" and "which channel produced staff who stayed"
  /// answerable at all.
  hired_employee_id String?             @unique

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  tenant        Tenant                @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  jobPost       JobPost               @relation(fields: [job_post_id], references: [id], onDelete: Cascade)
  applicant     Applicant             @relation(fields: [applicant_id], references: [id], onDelete: Cascade)
  hiredEmployee Employee?             @relation("JobApplicationHire", fields: [hired_employee_id], references: [id])
  events        JobApplicationEvent[]

  /// One application per candidate per post. Re-applying to the same post is a
  /// duplicate, not a second chance — the stage on the existing row is the
  /// second chance.
  @@unique([job_post_id, applicant_id])
  @@index([tenant_id, stage, deleted_at])
  @@index([tenant_id, job_post_id])
  @@index([tenant_id, applicant_id])
  @@map("job_applications")
}

/// Every stage move and note on an application, in order.
///
/// Append-only. `JobApplication.stage` is where it is now; this is how it got
/// there, which is what an unsuccessful candidate asking "why" needs answered.
model JobApplicationEvent {
  id                 String               @id @default(uuid())
  tenant_id          String
  application_id     String
  from_stage         JobApplicationStage?
  to_stage           JobApplicationStage
  note               String?
  created_by_user_id String?
  created_at         DateTime             @default(now())

  tenant      Tenant         @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  application JobApplication @relation(fields: [application_id], references: [id], onDelete: Cascade)
  createdBy   User?          @relation("JobApplicationEventAuthor", fields: [created_by_user_id], references: [id])

  @@index([tenant_id, application_id, created_at])
  @@map("job_application_events")
}

model FiscalPeriod {
  id                String    @id @default(uuid())
