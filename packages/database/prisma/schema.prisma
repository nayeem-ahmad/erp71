enum ProductType {
  GOODS
  SERVICE
}

model Product {
  id                     String      @id @default(uuid())
  tenant_id              String
  brand_id               String?
  group_id               String?
  subgroup_id            String?
  name                   String
  sku                    String?
  type                   ProductType @default(GOODS)
  price                  Decimal     @default(0) @db.Decimal(12, 2)
  compare_at_price       Decimal?    @db.Decimal(12, 2) // original price for sale display
  is_featured            Boolean     @default(false)
  vat_rate               Decimal?    @db.Decimal(5, 2) // product-specific VAT rate; null = use tenant default
  warranty_enabled       Boolean     @default(false)
  warranty_duration_days Int?
  reorder_level          Int?
  safety_stock           Int?
  lead_time_days         Int?
  image_url              String?
  description            String?
  images_gallery         String[]    @default([])
  unit_type              String      @default("none")

  /// Harmonised System code, as classified on the Bill of Entry. Drives the
  /// duty rate, so a wrong one is an assessment dispute rather than a typo.
  /// Snapshotted onto ImportShipmentItem at shipment time, because a later
  /// reclassification must not retroactively change how past entries were
  /// assessed.
  hs_code                String?
  country_of_origin      String?
  /// Per unit. Sea and air freight are billed on weight, LCL on volume, and
  /// without these an import can only allocate freight by value — which puts
  /// the freight bill on the expensive line rather than the heavy one.
  net_weight_kg          Decimal?    @db.Decimal(12, 3)
  cbm                    Decimal?    @db.Decimal(12, 4)

  created_at             DateTime    @default(now())
  deleted_at             DateTime?

  // Relations
  tenant                 Tenant                   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  brand                  Brand?                   @relation(fields: [brand_id], references: [id])
  group                  ProductGroup?            @relation(fields: [group_id], references: [id])
  subgroup               ProductSubgroup?         @relation(fields: [subgroup_id], references: [id])
  stocks                 ProductStock[]
  cost                   ProductCost?
  inventoryMovements     InventoryMovement[]
  transferItems          WarehouseTransferItem[]
  shrinkageItems         InventoryShrinkageItem[]
  stockTakeLines         StockTakeCountLine[]
  demandItems            ProductDemandItem[]
  saleItems              SaleItem[]
  returnItems            SalesReturnItem[]
  purchaseReturnItems    PurchaseReturnItem[]
  orderItems             SalesOrderItem[]
  quoteItems             QuotationItem[]
  purchaseItems          PurchaseItem[]
  purchaseOrderItems     PurchaseOrderItem[]
  purchaseQuotationItems PurchaseQuotationItem[]
  prices                 ProductPrice[]
  priceListItems         PriceListItem[]
  warrantyClaims         WarrantyClaim[]
  storefrontOrderItems   StorefrontOrderItem[]
  bomRecipe              BomRecipe?
  bomComponents          BomComponent[]           @relation("BomComponent")
  productionWastages     ProductionWastage[]      @relation("ProductionWastage")
  importShipmentItems    ImportShipmentItem[]

  @@unique([tenant_id, sku])
  @@index([tenant_id, brand_id])
  @@index([tenant_id, group_id])
  @@index([tenant_id, subgroup_id])
  @@index([tenant_id, deleted_at])
  @@index([tenant_id, reorder_level])
}

model ProductStock {
  id           String @id @default(uuid())
  tenant_id    String
  product_id   String
  warehouse_id String
  quantity     Int    @default(0)

  // Relations
  tenant    Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [product_id], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouse_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, product_id, warehouse_id])
  @@index([tenant_id, warehouse_id])
}

/// The running weighted-average cost of a product, held tenant-wide rather than
/// per warehouse. One pool per product means a warehouse transfer is a pure
/// quantity move with no cost effect, and every report agrees on what a unit of
/// this product cost — at the price of blurring genuinely different buying
/// prices between branches.
///
/// Maintained by `applyCostMovement` inside `applyInventoryMovement`, so every
/// stock movement in the system keeps it current. Nothing else may write it.
model ProductCost {
  id          String   @id @default(uuid())
  tenant_id   String
  /// Unique on its own — a Product belongs to exactly one tenant, so one pool
  /// per product is already one pool per tenant. The composite below is what
  /// the code upserts against, so tenant scoping stays explicit at every call
  /// site rather than relying on that argument holding.
  product_id  String   @unique
  /// Four decimal places, not two: an average divides, and rounding to paisa at
  /// every receipt compounds into visible drift over a few hundred movements.
  /// Callers round for display; the pool stays precise.
  avg_cost    Decimal  @db.Decimal(12, 4)
  /// The quantity the average is held against. Kept here rather than summed
  /// from ProductStock so that the average and the basis it was computed over
  /// move together in one atomic update — a sum taken separately can be read
  /// mid-transaction and produce an average that never existed.
  ///
  /// Can go negative: `allowNegative` movements let an import book a sale for
  /// stock that was never received, and the pool has to represent that
  /// honestly rather than clamp and silently misstate the next receipt.
  qty_on_hand Int      @default(0)
  updated_at  DateTime @updatedAt

  // Relations
  tenant  Tenant  @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, product_id])
  @@index([tenant_id])
  @@map("product_costs")
}

model ProductSerial {
  id              String    @id @default(uuid())
  tenant_id       String
  store_id        String?
  product_id      String
  serial_number   String
  status          String    @default("IN_STOCK")
  source_type     String?
  source_id       String?
  claim_reference String?
  sold_at         DateTime?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  @@unique([tenant_id, product_id, serial_number])
  @@index([tenant_id, serial_number])
  @@index([tenant_id, status])
  @@index([tenant_id, product_id, status])
}

model InventoryMovement {
