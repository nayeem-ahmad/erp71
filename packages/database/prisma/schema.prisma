datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/.prisma/client"
}

enum UserRole {
  OWNER
  MANAGER
  CASHIER
  ACCOUNTANT
}

enum ReferralCommissionStatus {
  PENDING
  EARNED
  PAID
  // Set when the tenant's payment was refunded or charged back. Terminal: the
  // referral does not return to PENDING, because the discount it granted was
  // already consumed and re-earning it would pay the commission twice.
  REVERSED
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  TRIALING
}

enum SubscriptionPlanCode {
  FREE
  BASIC
  ACCOUNTING
  STANDARD
  PREMIUM
}

enum CustomerType {
  INDIVIDUAL
  ORGANIZATION
}

enum PriceListDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  LOST
  CONVERTED
}

enum LeadSource {
  WALK_IN
  PHONE
  FACEBOOK
  REFERRAL
  WEBSITE
  OTHER
}

enum LeadCategory {
  RETAIL
  WHOLESALE
  CORPORATE
  INDIVIDUAL
  PARTNER
  OTHER
}

enum LeadPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum StorePermission {
  // Product & Catalog
  VIEW_PRODUCT_CATALOG
  EDIT_PRODUCTS
  EDIT_PRODUCT_PRICES
  EDIT_SUPPLIERS
  EDIT_BRANDS

  // Inventory
  CREATE_INVENTORY_MOVEMENTS
  CREATE_GOODS_TRANSFER
  APPROVE_GOODS_TRANSFER
  STOCK_TAKE
  CREATE_PRODUCT_DEMAND
  APPROVE_PRODUCT_DEMAND

  // Transactions
  CREATE_SALE
  CREATE_PURCHASE
  CREATE_RETURN
  CREATE_SALES_ORDER
  CREATE_QUOTATION

  // Accounting
  VIEW_LEDGER
  CREATE_VOUCHER
  APPROVE_VOUCHER
  VIEW_FINANCIAL_REPORTS

  // Fund Transfers
  CREATE_FUND_TRANSFER
  APPROVE_FUND_TRANSFER

  // Multi-Store
  SWITCH_STORES
  VIEW_CONSOLIDATED_REPORTS

  // User Management
  MANAGE_USERS
  MANAGE_USER_STORE_ACCESS
  MANAGE_STORES

  // POS Counters
  MANAGE_COUNTERS

  // CRM
  VIEW_CRM_INTERACTIONS
  CREATE_CRM_INTERACTIONS
  MANAGE_CRM_TASKS
  VIEW_CUSTOMER_CREDIT
  MANAGE_CUSTOMER_CREDIT
  VIEW_LEADS
  MANAGE_LEADS
  VIEW_LEAD_CONVERSATIONS
  CREATE_LEAD_CONVERSATIONS
  MANAGE_CRM_SETTINGS

  // HR
  VIEW_HR
  VIEW_PAYROLL
  MANAGE_HR

  // Loans
  VIEW_LOANS
  MANAGE_LOANS

  // Investors & profit sharing
  VIEW_INVESTORS
  MANAGE_INVESTORS

  // Projects
  VIEW_PROJECTS
  VIEW_ALL_PROJECTS
  MANAGE_PROJECTS
  MANAGE_PROJECT_TASKS
  LOG_PROJECT_TIME
  MANAGE_SPRINTS
  MANAGE_PROJECT_SETTINGS

  // Imports (LC)
  VIEW_IMPORTS
  MANAGE_IMPORTS
  /// Separate from MANAGE_IMPORTS on purpose: adding an import cost changes the
  /// landed cost of the goods and therefore the COGS on every subsequent sale
  /// of them. That is a finance action, not a warehouse one.
  MANAGE_IMPORT_COSTS

  // Short Links
  MANAGE_SHORT_LINKS

  // Storefront blog
  VIEW_BLOG
  MANAGE_BLOG
  PUBLISH_BLOG
}

enum EmployeeStatus {
  ACTIVE
  /// On probation. Still active for payroll and attendance; separated so a
  /// report can find them and a confirmation can be a real event.
  PROBATION
  /// Left of their own accord.
  RESIGNED
  /// Dismissed.
  TERMINATED
  /// A fixed-term contract that ran out.
  CONTRACT_ENDED
  /// The pre-existing catch-all. Kept because rows already carry it and
  /// rewriting them would be guessing at why each person left.
  INACTIVE
}

/// Where a vacancy is in its own life, independent of the candidates on it.
enum JobPostStatus {
  /// Being written. Never counted as a live opening.
  DRAFT
  /// Live and accepting applications.
  OPEN
  /// Paused — the role still exists but nobody is being moved through it.
  ON_HOLD
  /// Every opening has an accepted offer. Distinct from CLOSED so "we stopped
  /// hiring" and "we hired" are not the same row.
  FILLED
  /// Withdrawn or abandoned.
  CLOSED
}

enum JobEmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  TEMPORARY
}

/// One candidate's position in the pipeline for one vacancy.
///
/// Ordered as the pipeline is walked, so a report can compare stages by
/// declaration order. HIRED and REJECTED are terminal; WITHDRAWN is terminal
/// too but records that the candidate left, which a rejection would misstate.
enum JobApplicationStage {
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  HIRED
  REJECTED
  WITHDRAWN
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  HOLIDAY
  /// Present, but clocked in after the scheduled start. Still a present day for
  /// payroll — the distinction is disciplinary, not monetary.
  LATE
  /// Present, but clocked out before the scheduled end.
  EARLY_LEAVE
  /// Covered by an approved leave request. Written by the leave approval rather
  /// than by a human, so the attendance and leave reports cannot contradict
  /// each other.
  ON_LEAVE
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum PostingRuleEventType {
  sale
  sale_return
  purchase
  purchase_return
  inventory_adjustment
  fund_movement
  expense
  loan_disbursement
  loan_repayment
  customer_payment
  supplier_payment
  depreciation
  cash_transaction
  salary_accrual
  salary_payment
  asset_acquisition
  fund_transfer
  investor_contribution
  investor_withdrawal
  investor_profit_accrual
  investor_profit_payout
  /// LC margin paid to the bank, and every cost booked against a shipment.
  import_cost
  /// Goods in transit becoming inventory at landed cost.
  import_receipt
  /// Settling a usance LC, where the rate paid differs from the rate booked.
  import_settlement
}

/// A subsidiary-ledger party. Marks a control account (Accounts Receivable,
/// Purchase Payable, Salary Payable, Investor Profit Payable) as one whose balance is the sum of
/// per-party balances, and tags each voucher line on such an account with the
/// party it belongs to. See Account.party_type and VoucherDetail.party_id.
enum PartyType {
  CUSTOMER
  SUPPLIER
  EMPLOYEE
  INVESTOR
}

enum PostingRuleConditionKey {
  payment_mode
  reason_type
  transfer_scope
  loan_direction
  payment_direction
  none
}

enum PostingEventStatus {
  pending
  posted
  failed
  skipped
}

enum DepreciationMethod {
  STRAIGHT_LINE
  DECLINING_BALANCE
}

model User {
  id                       String    @id @default(uuid())
  email                    String    @unique
  // Null for accounts created through Google sign-in that never set a password.
  // Those users sign in with Google, or claim a password via "forgot password".
  passwordHash             String?
  // Google's stable subject id, so a returning user is matched even after they
  // rename the Gmail address the account was first created with.
  google_id                String?   @unique
  name                     String?
  preferred_locale         String    @default("en")
  token_version            Int       @default(0)
  // Bumped independently of `token_version` so signing out of (or being kicked
  // from) the ERP app does not silently drop the same person's storefront
  // customer sessions, and vice versa. A password change bumps both.
  storefront_token_version Int       @default(0)
  // Third independently-revocable surface, for the same reason `stv` exists:
  // a job seeker who signs out of the careers portal should not lose an ERP
  // session, and a workspace member signing out of ERP should not lose a job
  // application in progress. A password change bumps all three.
  applicant_token_version  Int       @default(0)
  is_platform_admin        Boolean   @default(false)
  /// Last time this person opened the in-app "What's new" feed. The unread dot
  /// is a comparison against the newest published post, which is why there is
  /// no per-user-per-post row: writing a Notification for every user of every
  /// tenant on publish would be one row per platform user per post.
  blog_last_seen_at        DateTime?
  // Firebase's stable per-account uid, set the first time someone signs in with
  // an SMS one-time code. Unique so one Firebase identity can never be linked to
  // two ERP71 users.
  firebase_uid             String?   @unique
  mobile_country_code      String    @default("BD")
  mobile                   String?
  /// When the number in `mobile` was proved by an SMS code. Null means it was
  /// only ever typed into a form, which is why mobile sign-in matches on it only
  /// after Firebase has verified the same number.
  mobile_verified_at       DateTime?
  email_verified_at        DateTime?
  avatar_url               String?
  totp_secret              String?
  created_at               DateTime  @default(now())
  updated_at               DateTime  @updatedAt

  // Relations
  tenantsOwned                      Tenant[]                    @relation("TenantOwner")
  tenantMembers                     TenantUser[]
  cashierSessions                   CashierSession[]
  storeAccess                       UserStoreAccess[]
  storePermissions                  UserStorePermission[]
  fundTransfersInitiated            FundTransfer[]              @relation("FundTransferInitiator")
  fundTransfersReceived             FundTransfer[]              @relation("FundTransferReceiver")
  auditLogs                         AuditLog[]
  passwordResetTokens               PasswordResetToken[]
  emailVerificationTokens           EmailVerificationToken[]
  sentInvitations                   UserInvitation[]            @relation("InvitationSender")
  feedbacks                         Feedback[]
  supportMessages                   SupportMessage[]            @relation("SupportMessageSender")
  notifications                     Notification[]
  storefrontCustomers               Customer[]
  storefrontOrders                  StorefrontOrder[]
  employee                          Employee?
  jobSeeker                         JobSeeker?
  applicantRecords                  Applicant[]                 @relation("ApplicantUser")
  approvedLeaves                    LeaveRequest[]              @relation("LeaveApprover")
  approvedVouchers                  Voucher[]                   @relation("VoucherApprover")
  createdInteractions               CustomerInteraction[]       @relation("InteractionCreator")
  assignedCrmFollowUps              CrmFollowUp[]               @relation("CrmFollowUpAssignee")
  createdCrmFollowUps               CrmFollowUp[]               @relation("CrmFollowUpCreator")
  crmActivitiesAssigned             CrmActivity[]               @relation("CrmActivityAssignee")
  crmActivitiesCreated              CrmActivity[]               @relation("CrmActivityCreator")
  refereeProfile                    Referee?
  assignedLeads                     Lead[]                      @relation("LeadAssignee")
  nextStepAssignedLeads             Lead[]                      @relation("LeadNextStepAssignee")
  createdLeads                      Lead[]                      @relation("LeadCreator")
  assignedCrmContacts               CrmContact[]                @relation("CrmContactAssignee")
  createdCrmContacts                CrmContact[]                @relation("CrmContactCreator")
  crmContactAttachments             CrmContactAttachment[]      @relation("CrmContactAttachmentCreator")
  createdLeadConversations          LeadConversation[]          @relation("LeadConversationCreator")
  createdCreditTransactions         CustomerCreditTransaction[] @relation("CreditTransactionCreator")
  createdSupplierCreditTransactions SupplierCreditTransaction[] @relation("SupplierCreditTransactionCreator")
  createdImportShipments            ImportShipment[]            @relation("ImportShipmentCreator")
  uploadedImportDocuments           ImportDocument[]            @relation("ImportDocumentUploader")
  createdCampaigns                  CrmCampaign[]               @relation("CampaignCreator")
  managedProjects                   Project[]                   @relation("ProjectManager")
  createdProjects                   Project[]                   @relation("ProjectCreator")
  projectMemberships                ProjectMember[]             @relation("ProjectMemberUser")
  assignedProjectTasks              ProjectTask[]               @relation("ProjectTaskAssignee")
  createdProjectTasks               ProjectTask[]               @relation("ProjectTaskCreator")
  projectTimeEntries                ProjectTimeEntry[]          @relation("ProjectTimeEntryUser")
  projectRemainingLogs              ProjectTaskRemainingLog[]   @relation("RemainingLogUser")
  projectComments                   ProjectComment[]            @relation("ProjectCommentUser")
  projectTaskActivities             ProjectTaskActivity[]       @relation("ProjectTaskActivityActor")
  projectTaskWatching               ProjectTaskWatcher[]        @relation("ProjectTaskWatcherUser")
  projectAttachments                ProjectAttachment[]         @relation("ProjectAttachmentCreator")
  authoredBlogPosts                 BlogPost[]                  @relation("BlogPostAuthor")
  authoredTenantBlogPosts           TenantBlogPost[]            @relation("TenantBlogPostAuthor")
  createdBoards                     Board[]                     @relation("BoardCreator")
  addedBoardCards                   BoardTask[]                 @relation("BoardTaskAdder")
  authoredSocialMediaPosts          SocialMediaPost[]           @relation("SocialMediaPostAuthor")
  jobApplicationEvents              JobApplicationEvent[]       @relation("JobApplicationEventAuthor")

  // Mobile sign-in looks an account up by number on every SMS code entered.
  // Deliberately not unique: one person may own several workspaces under the
  // same number, and sign-in resolves that ambiguity rather than the schema.
  @@index([mobile])
}

model PasswordResetToken {
  id         String    @id @default(uuid())
  user_id    String
  token_hash String    @unique
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime  @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

model EmailVerificationToken {
  id         String   @id @default(uuid())
  user_id    String
  token_hash String   @unique
  expires_at DateTime
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

model UserInvitation {
  id             String    @id @default(uuid())
  tenant_id      String
  email          String
  tenant_role_id String
  token_hash     String    @unique
  invited_by     String
  expires_at     DateTime
  accepted_at    DateTime?
  created_at     DateTime  @default(now())

  tenant     Tenant     @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  tenantRole TenantRole @relation(fields: [tenant_role_id], references: [id], onDelete: Restrict)
  invitedBy  User       @relation("InvitationSender", fields: [invited_by], references: [id])

  @@index([tenant_id, email])
}

model AuditLog {
  id         String   @id @default(uuid())
  tenant_id  String?
  user_id    String?
  action     String
  entity     String
  entity_id  String?
  payload    Json?
  ip_address String?
  user_agent String?
  created_at DateTime @default(now())

  user User? @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([tenant_id, entity, created_at])
  @@index([user_id, created_at])
  @@index([entity, entity_id])
}

/// Execution record for scheduled (cron) jobs — platform-scoped, not
/// tenant-scoped. Powers cron-job observability in system-health monitoring.
model JobRun {
  id          String    @id @default(uuid())
  job_name    String
  status      String // RUNNING | SUCCESS | FAILED
  started_at  DateTime  @default(now())
  finished_at DateTime?
  duration_ms Int?
  error       String?
  created_at  DateTime  @default(now())

  @@index([job_name, started_at])
  @@index([job_name, status, finished_at])
}

/// Progress tracker + append-detection marker for a six-month demo-data load.
/// Tenant-scoped. One row per "Load Demo Data" invocation; batch_number lets a
/// tenant append multiple loads. Drives the in-process background generator and
/// the Settings → Data progress UI (polled via GET /tenants/demo-data/status).
model DemoDataBatch {
  id           String    @id @default(uuid())
  tenant_id    String
  batch_number Int
  status       String    @default("PENDING") // PENDING | RUNNING | COMPLETED | FAILED
  phase        String?
  processed    Int       @default(0)
  total        Int       @default(0)
  counts       Json?
  started_at   DateTime  @default(now())
  finished_at  DateTime?
  error        String?

  @@index([tenant_id])
  @@map("demo_data_batches")
}

model Tenant {
  id                       String    @id @default(uuid())
  name                     String
  owner_id                 String
  default_locale           String    @default("en")
  /// When false the workspace is English-only and the language switcher is hidden.
  localization_enabled     Boolean   @default(false)
  /// Second language offered alongside English when localization_enabled is true.
  secondary_locale         String?
  created_at               DateTime  @default(now())
  storefront_slug          String?   @unique
  storefront_enabled       Boolean   @default(false)
  storefront_banner        String?
  storefront_hero_image    String?
  storefront_hero_headline String?
  brand_primary_color      String?
  brand_logo_url           String?
  brand_favicon_url        String?
  brand_business_name      String?
  default_vat_rate         Decimal?  @db.Decimal(5, 2) // e.g. 15.00 for 15% BD VAT
  vat_registration_no      String? // NBR VAT registration number
  business_tin             String? // Tax Identification Number
  business_type            String? // e.g. SURGICAL_MEDICAL, PHARMACY, GROCERY, COMPUTER_HARDWARE
  /// Which dashboard this workspace lands on: AUTO | RETAIL | ACCOUNTING.
  /// AUTO defers to the plan's `accountingDashboard` entitlement. This is a
  /// preference, not a capability, which is why it is a column and not a key in
  /// the plan's features_json — see `resolveDashboardVariant` in shared-types.
  dashboard_preference     String    @default("AUTO")
  /// When the setup wizard was finished or skipped for this workspace. Set once
  /// by whoever dismisses it; every member on every device then skips onboarding.
  onboarding_dismissed_at  DateTime?
  deleted_at               DateTime?

  /// Per-tenant overrides of the platform feature switches, e.g. `{"voice": true}`.
  /// A missing key inherits the platform default; an explicit boolean wins over it.
  feature_overrides Json @default("{}")

  loyalty_points_enabled Boolean  @default(false)
  loyalty_earn_rate      Decimal? @db.Decimal(8, 4) // points per BDT (e.g. 1.0 = 1 point per ৳1)
  loyalty_redeem_rate    Decimal? @db.Decimal(8, 4) // BDT value per point (e.g. 0.01 = 1 point = ৳0.01)
  loyalty_min_redeem     Int? // minimum points required to redeem

  sms_enabled      Boolean @default(false)
  sms_on_sale      Boolean @default(false) // send SMS receipt after each sale
  sms_on_low_stock Boolean @default(false) // send SMS for low stock alerts
  sms_credits      Int     @default(0) // prepaid SMS credit balance (number of message segments remaining)
  ai_credits_bonus Int     @default(0) // purchased / admin-granted AI credits (adds to plan monthly allowance)

  report_weekly_enabled  Boolean @default(false)
  report_monthly_enabled Boolean @default(false)
  report_email           String? // override email for reports (defaults to owner email)

