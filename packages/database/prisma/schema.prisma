/// Platform-admin managed link between a tenant and a third-party ERP we pull
/// historical sales/purchase data out of. One connection per tenant+provider.
model ExternalSyncConnection {
  id                 String    @id @default(uuid())
  tenant_id          String
  /// Provider key, e.g. EXPRESS_RETAIL_PRO.
  provider           String
  base_url           String
  username           String
  /// AES-256-GCM ciphertext produced by EncryptionService — never stored plain.
  password_encrypted String
  /// Provider-side organization/company id, used to reject cross-org data.
  external_org_id    String?
  /// Store every imported sale/purchase is attributed to.
  store_id           String
  /// Prefix applied to imported document numbers so they cannot collide with
  /// natively created ones (e.g. "XR-" -> "XR-2601666").
  document_prefix    String    @default("XR-")
  enabled            Boolean   @default(false)
  /// When true an imported document produces the same effects a natively
  /// entered one would: stock movements, party due balances and dated ledger
  /// postings. Off by default — turning it on double-counts unless the tenant
  /// has no opening balances covering the imported period.
  post_impacts       Boolean   @default(false)
  /// Rolling window (days back from today) each scheduled run re-pulls.
  window_days        Int       @default(90)
  /// Earliest business date the importer will ever ask the provider for.
  history_start_date DateTime?
  last_run_at        DateTime?
  last_success_at    DateTime?
  created_by         String?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  tenant   Tenant             @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  store    Store              @relation(fields: [store_id], references: [id])
  runs     ExternalSyncRun[]
  mappings ExternalSyncMapping[]

  @@unique([tenant_id, provider])
  @@index([enabled])
}

/// Maps a provider-side record id to the row we created for it, so re-running
/// an import updates rather than duplicates.
model ExternalSyncMapping {
  id            String   @id @default(uuid())
  tenant_id     String
  connection_id String
  /// PRODUCT | CUSTOMER | SUPPLIER | SALE | PURCHASE
  entity_type   String
  external_id   String
  internal_id   String
  /// Provider updated_at at the time we last wrote this row; lets a re-pull
  /// skip records that have not changed upstream.
  external_updated_at DateTime?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  tenant     Tenant                 @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  connection ExternalSyncConnection @relation(fields: [connection_id], references: [id], onDelete: Cascade)

  @@unique([connection_id, entity_type, external_id])
  @@index([tenant_id, entity_type])
  @@index([connection_id, entity_type, internal_id])
}

/// One import attempt — manual or scheduled. Retains counts and errors so a
/// platform admin can see what a run actually did.
model ExternalSyncRun {
  id            String    @id @default(uuid())
  tenant_id     String
  connection_id String
  /// MANUAL | SCHEDULED
  trigger       String    @default("MANUAL")
  /// RUNNING | SUCCESS | PARTIAL | FAILED | CANCELLED
  status        String    @default("RUNNING")
  /// What the run is doing right now, e.g. "Sales 2026-05". Null once finished.
  phase         String?
  /// Step/chunk counters, rewritten as the run proceeds so a long import is
  /// observable while it happens rather than only once it ends.
  progress      Json?
  /// Which steps this run was asked to perform; null means all of them.
  steps         Json?
  /// Set by the cancel endpoint; the run checks it between chunks and stops.
  cancel_requested Boolean @default(false)
  /// Business-date window actually requested from the provider.
  window_from   DateTime
  window_to     DateTime
  dry_run       Boolean   @default(false)
  /// Per-entity {created,updated,skipped} tallies.
  stats         Json?
  /// Non-fatal per-record problems (unmapped product, rounded quantity, ...).
  warnings      Json?
  error_message String?
  started_at    DateTime  @default(now())
  finished_at   DateTime?
  triggered_by  String?

  tenant     Tenant                 @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  connection ExternalSyncConnection @relation(fields: [connection_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, started_at])
  @@index([connection_id, started_at])
}

model PaymentMethod {
  id          String   @id @default(uuid())
  tenant_id   String
  type        String   // Cash, Mobile Wallet, Card, Bank
  name        String   // e.g. "Cash Register", "bKash Account", "Bank A/C"
  account_id  String?  // Links to Account for posting
  is_active   Boolean  @default(true)
  show_on_entry Boolean @default(true)
  sort_order  Int      @default(0)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, name])
  @@index([tenant_id, type, is_active])
}

/// Tenant-designed print header (letterhead) applied to printed documents.
/// `config` holds a versioned PrintHeaderConfig JSON — see packages/shared-types.
model PrintTemplate {
  id         String   @id @default(uuid())
  tenant_id  String
  name       String
  /// Used for any document type without a more specific template.
  is_default Boolean  @default(false)
  /// PrintDocType values; empty means the template applies to every type.
  doc_types  String[] @default([])
  config     Json
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant     Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id])
  @@map("print_templates")
}

model SalesSettings {
  id                     String   @id @default(uuid())
  tenant_id              String   @unique
  paper_size             String   @default("A4") // A4, A5, Letter, Thermal80, Thermal58
  reference_number_format String @default("YYMM-#") // Format template
  pos_enabled            Boolean  @default(true)
  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt

  tenant                 Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
}

/// Per-tenant sidebar override. layout=null means pinned to built-in code defaults.
model TenantNavLayout {
  tenant_id  String   @id
  layout     Json?
  updated_at DateTime @updatedAt
  updated_by String?

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
}

model TenantUser {
  id             String   @id @default(uuid())
  tenant_id      String
  user_id        String
  role           UserRole @default(CASHIER)
  tenant_role_id String?

  // Relations
  tenant     Tenant      @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  user       User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  tenantRole TenantRole? @relation(fields: [tenant_role_id], references: [id], onDelete: SetNull)

  @@unique([tenant_id, user_id])
}

model TenantRole {
  id          String   @id @default(uuid())
  tenant_id   String
  name        String
  description String?
  is_system   Boolean  @default(false)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  tenant       Tenant                 @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  permissions  TenantRolePermission[]
  members      TenantUser[]
  invitations  UserInvitation[]

  @@unique([tenant_id, name])
  @@index([tenant_id])
}

model TenantRolePermission {
  id             String          @id @default(uuid())
  tenant_role_id String
  permission     StorePermission

  tenantRole TenantRole @relation(fields: [tenant_role_id], references: [id], onDelete: Cascade)

  @@unique([tenant_role_id, permission])
}

model Store {
  id        String   @id @default(uuid())
  tenant_id String
  name      String
  address   String?
  created_at DateTime @default(now())

  // Relations
  tenant          Tenant              @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  sales           Sale[]
  salesReturns    SalesReturn[]
  purchaseReturns PurchaseReturn[]
  salesOrders     SalesOrder[]
  quotations      Quotation[]
  purchases       Purchase[]
  purchaseOrders  PurchaseOrder[]
  purchaseQuotations PurchaseQuotation[]
  cashierSessions CashierSession[]
  warehouses      Warehouse[]
  userStoreAccess UserStoreAccess[]
  userStorePermissions UserStorePermission[]
  productPrices   ProductPrice[]
  fundTransfersSource      FundTransfer[] @relation("FundTransferSourceStore")
  fundTransfersDestination FundTransfer[] @relation("FundTransferDestinationStore")
  vouchers                 Voucher[]      @relation("VoucherStore")
  vouchersCounterparty     Voucher[]      @relation("VoucherCounterpartyStore")
  warrantyClaims  WarrantyClaim[]
  posCounters     PosCounter[]
  expenseEntries  ExpenseEntry[]
  loans           Loan[]
  investors          Investor[]
  investorProfitRuns InvestorProfitRun[]
  externalSyncConnections ExternalSyncConnection[]
  projects        Project[]
}

model PosCounter {
  id             String   @id @default(uuid())
  tenant_id      String
  store_id       String
  name           String
  counter_number Int
  status         String   @default("ACTIVE") // ACTIVE, INACTIVE
  created_at     DateTime @default(now())

  tenant          Tenant          @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  store           Store           @relation(fields: [store_id], references: [id], onDelete: Cascade)
  cashierSessions CashierSession[]
  sales           Sale[]

  @@unique([tenant_id, store_id, counter_number])
  @@index([tenant_id, store_id])
}

model Warehouse {
  id         String   @id @default(uuid())
  tenant_id  String
  store_id   String
  name       String
  code       String
  is_default Boolean  @default(false)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant     Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  store      Store    @relation(fields: [store_id], references: [id], onDelete: Cascade)
  productStocks ProductStock[]
  inventoryMovements InventoryMovement[]
  transferSourceRows WarehouseTransfer[] @relation("TransferSourceWarehouse")
  transferDestinationRows WarehouseTransfer[] @relation("TransferDestinationWarehouse")
  shrinkageRows InventoryShrinkage[]
  stockTakeSessions StockTakeSession[]
  productWarehouseDefaults InventorySettings[] @relation("ProductWarehouseDefault")
  purchaseWarehouseDefaults InventorySettings[] @relation("PurchaseWarehouseDefault")
  salesWarehouseDefaults InventorySettings[] @relation("SalesWarehouseDefault")
  shrinkageWarehouseDefaults InventorySettings[] @relation("ShrinkageWarehouseDefault")
  transferSourceWarehouseDefaults InventorySettings[] @relation("TransferSourceWarehouseDefault")
  transferDestinationWarehouseDefaults InventorySettings[] @relation("TransferDestinationWarehouseDefault")

  @@unique([tenant_id, code])
  @@index([tenant_id, store_id])
}

model ProductGroup {
  id         String   @id @default(uuid())
  tenant_id  String
  name       String
  description String?
  is_featured Boolean  @default(false)
  image_url  String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant     Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  subgroups  ProductSubgroup[]
  products   Product[]

  @@unique([tenant_id, name])
  @@index([tenant_id])
}

model ProductSubgroup {
  id         String   @id @default(uuid())
  tenant_id  String
  group_id   String
  name       String
  description String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant     Tenant       @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  group      ProductGroup @relation(fields: [group_id], references: [id], onDelete: Cascade)
  products   Product[]

  @@unique([group_id, name])
  @@index([tenant_id])
  @@index([group_id])
}

model Brand {
  id          String    @id @default(uuid())
  tenant_id   String
  name        String
  description String?
  logo_url    String?
  website_url String?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?

  tenant      Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  products    Product[]

  @@unique([tenant_id, name])
  @@index([tenant_id, deleted_at])
}

enum ProductType {
  GOODS
  SERVICE
}

model Product {
  id          String   @id @default(uuid())
  tenant_id   String
  brand_id    String?
  group_id    String?
  subgroup_id String?
  name        String
  sku         String?
  type        ProductType @default(GOODS)
  price       Decimal  @default(0) @db.Decimal(12, 2)
  compare_at_price Decimal? @db.Decimal(12, 2)  // original price for sale display
  is_featured Boolean  @default(false)
  vat_rate    Decimal? @db.Decimal(5, 2)  // product-specific VAT rate; null = use tenant default
  warranty_enabled Boolean @default(false)
  warranty_duration_days Int?
  reorder_level Int?
  safety_stock Int?
  lead_time_days Int?
  image_url   String?
  description String?
  images_gallery String[] @default([])
  unit_type   String    @default("none")
  created_at  DateTime  @default(now())
  deleted_at  DateTime?

  // Relations
  tenant      Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  brand       Brand?   @relation(fields: [brand_id], references: [id])
  group       ProductGroup? @relation(fields: [group_id], references: [id])
  subgroup    ProductSubgroup? @relation(fields: [subgroup_id], references: [id])
  stocks      ProductStock[]
  inventoryMovements InventoryMovement[]
  transferItems WarehouseTransferItem[]
  shrinkageItems InventoryShrinkageItem[]
  stockTakeLines StockTakeCountLine[]
  saleItems   SaleItem[]
  returnItems SalesReturnItem[]
  purchaseReturnItems PurchaseReturnItem[]
  orderItems  SalesOrderItem[]
  quoteItems  QuotationItem[]
  purchaseItems PurchaseItem[]
  purchaseOrderItems PurchaseOrderItem[]
  purchaseQuotationItems PurchaseQuotationItem[]
  prices      ProductPrice[]
  priceListItems PriceListItem[]
  warrantyClaims WarrantyClaim[]
  storefrontOrderItems StorefrontOrderItem[]
  bomRecipe    BomRecipe?
  bomComponents BomComponent[] @relation("BomComponent")
  productionWastages ProductionWastage[] @relation("ProductionWastage")

  @@unique([tenant_id, sku])
  @@index([tenant_id, brand_id])
  @@index([tenant_id, group_id])
  @@index([tenant_id, subgroup_id])
  @@index([tenant_id, deleted_at])
  @@index([tenant_id, reorder_level])
}

model ProductStock {
  id          String   @id @default(uuid())
  tenant_id   String
  product_id  String
  warehouse_id String
  quantity    Int      @default(0)
  
  // Relations
  tenant      Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  warehouse   Warehouse @relation(fields: [warehouse_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, product_id, warehouse_id])
  @@index([tenant_id, warehouse_id])
}

model ProductSerial {
  id               String   @id @default(uuid())
  tenant_id        String
  store_id         String?
  product_id       String
  serial_number    String
  status           String   @default("IN_STOCK")
  source_type      String?
  source_id        String?
  claim_reference  String?
  sold_at          DateTime?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  @@unique([tenant_id, product_id, serial_number])
  @@index([tenant_id, serial_number])
  @@index([tenant_id, status])
  @@index([tenant_id, product_id, status])
}

model InventoryMovement {
  id             String   @id @default(uuid())
  tenant_id      String
  product_id     String
  warehouse_id   String
  movement_type  String
  reference_type String?
  reference_id   String?
  quantity_delta Int
  balance_after  Int?
  unit_cost      Decimal? @db.Decimal(12, 2)
  note           String?
  created_at     DateTime @default(now())

  tenant         Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  product        Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  warehouse      Warehouse @relation(fields: [warehouse_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, created_at])
  @@index([tenant_id, warehouse_id, created_at])
  @@index([tenant_id, product_id, created_at])
  @@index([tenant_id, movement_type])
}

model InventoryReason {
  id            String   @id @default(uuid())
  tenant_id     String
  type          String
  code          String
  label         String
  is_system     Boolean  @default(false)
  is_active     Boolean  @default(true)
  display_order Int      @default(0)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  tenant        Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  shrinkageRows InventoryShrinkage[]
  stockTakeLines StockTakeCountLine[]

  @@unique([tenant_id, type, code])
  @@index([tenant_id, type, is_active])
}

model InventorySettings {
  id                                String   @id @default(uuid())
  tenant_id                         String   @unique
  default_product_warehouse_id      String?
  default_purchase_warehouse_id     String?
  default_sales_warehouse_id        String?
  default_shrinkage_warehouse_id    String?
  default_transfer_source_warehouse_id String?
  default_transfer_destination_warehouse_id String?
  default_reorder_level             Int      @default(10)
  default_safety_stock              Int      @default(0)
  default_lead_time_days            Int      @default(0)
  discrepancy_approval_threshold    Int      @default(25)
  created_at                        DateTime @default(now())
  updated_at                        DateTime @updatedAt

  tenant                            Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  defaultProductWarehouse           Warehouse? @relation("ProductWarehouseDefault", fields: [default_product_warehouse_id], references: [id])
  defaultPurchaseWarehouse          Warehouse? @relation("PurchaseWarehouseDefault", fields: [default_purchase_warehouse_id], references: [id])
  defaultSalesWarehouse             Warehouse? @relation("SalesWarehouseDefault", fields: [default_sales_warehouse_id], references: [id])
  defaultShrinkageWarehouse         Warehouse? @relation("ShrinkageWarehouseDefault", fields: [default_shrinkage_warehouse_id], references: [id])
  defaultTransferSourceWarehouse    Warehouse? @relation("TransferSourceWarehouseDefault", fields: [default_transfer_source_warehouse_id], references: [id])
  defaultTransferDestinationWarehouse Warehouse? @relation("TransferDestinationWarehouseDefault", fields: [default_transfer_destination_warehouse_id], references: [id])

  @@index([default_product_warehouse_id])
  @@index([default_purchase_warehouse_id])
  @@index([default_sales_warehouse_id])
  @@index([default_shrinkage_warehouse_id])
  @@index([default_transfer_source_warehouse_id])
  @@index([default_transfer_destination_warehouse_id])
}

model WarehouseTransfer {
  id                       String   @id @default(uuid())
  tenant_id                String
  transfer_number          String
  source_warehouse_id      String
  destination_warehouse_id String
  status                   String   @default("DRAFT")
  notes                    String?
  sent_at                  DateTime?
  received_at              DateTime?
  created_at               DateTime @default(now())
  updated_at               DateTime @updatedAt

  // Cross-branch fields
  source_store_id          String?
  destination_store_id     String?
  is_cross_branch          Boolean  @default(false)
  requires_approval        Boolean  @default(false)
  approved_by              String?
  approval_date            DateTime?

  tenant                   Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  sourceWarehouse          Warehouse @relation("TransferSourceWarehouse", fields: [source_warehouse_id], references: [id])
  destinationWarehouse     Warehouse @relation("TransferDestinationWarehouse", fields: [destination_warehouse_id], references: [id])
  items                    WarehouseTransferItem[]

  @@unique([tenant_id, transfer_number])
  @@index([tenant_id, status, created_at])
  @@index([tenant_id, source_warehouse_id])
  @@index([tenant_id, destination_warehouse_id])
  @@index([tenant_id, is_cross_branch])
}

model WarehouseTransferItem {
  id                String   @id @default(uuid())
  transfer_id       String
  product_id        String
  quantity_sent     Int
  quantity_received Int      @default(0)
  note              String?

  transfer          WarehouseTransfer @relation(fields: [transfer_id], references: [id], onDelete: Cascade)
  product           Product           @relation(fields: [product_id], references: [id])

  @@unique([transfer_id, product_id])
}

model InventoryShrinkage {
  id               String   @id @default(uuid())
  tenant_id        String
  warehouse_id     String
  reason_id        String
  reference_number String
  notes            String?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  tenant           Tenant          @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  warehouse        Warehouse       @relation(fields: [warehouse_id], references: [id])
  reason           InventoryReason @relation(fields: [reason_id], references: [id])
  items            InventoryShrinkageItem[]

  @@unique([tenant_id, reference_number])
  @@index([tenant_id, warehouse_id, created_at])
  @@index([tenant_id, reason_id])
}

model InventoryShrinkageItem {
  id           String   @id @default(uuid())
  shrinkage_id String
  product_id   String
  quantity     Int
  unit_cost    Decimal? @db.Decimal(12, 2)
  note         String?

  shrinkage    InventoryShrinkage @relation(fields: [shrinkage_id], references: [id], onDelete: Cascade)
  product      Product            @relation(fields: [product_id], references: [id])

  @@unique([shrinkage_id, product_id])
}

model StockTakeSession {
  id             String   @id @default(uuid())
  tenant_id      String
  warehouse_id   String
  session_number String
  status         String   @default("DRAFT")
  notes          String?
  started_at     DateTime @default(now())
  posted_at      DateTime?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  tenant         Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  warehouse      Warehouse @relation(fields: [warehouse_id], references: [id])
  lines          StockTakeCountLine[]

  @@unique([tenant_id, session_number])
  @@index([tenant_id, warehouse_id, status])
  @@index([tenant_id, created_at])
}

model StockTakeCountLine {
  id                String   @id @default(uuid())
  session_id        String
  product_id        String
  expected_quantity Int
  counted_quantity  Int?
  variance_quantity Int?
  reason_id         String?
  note              String?

  session           StockTakeSession  @relation(fields: [session_id], references: [id], onDelete: Cascade)
  product           Product           @relation(fields: [product_id], references: [id])
  reason            InventoryReason?  @relation(fields: [reason_id], references: [id])

  @@unique([session_id, product_id])
  @@index([session_id, variance_quantity])
}

model Supplier {
  id          String   @id @default(uuid())
  tenant_id   String
  name        String
  phone       String?
  email       String?
  address     String?
  due_balance Decimal  @default(0) @db.Decimal(12, 2)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?

  tenant      Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  purchases   Purchase[]
  purchaseReturns PurchaseReturn[]
  purchaseOrders PurchaseOrder[]
  purchaseQuotations PurchaseQuotation[]
  creditTransactions SupplierCreditTransaction[]

  @@unique([tenant_id, name])
}

model SupplierCreditTransaction {
  id             String   @id @default(uuid())
  tenant_id      String
  supplier_id    String
  type           String   // CREDIT_PURCHASE | PAYMENT | PAYOUT | ADJUSTMENT
  amount         Decimal  @db.Decimal(12, 2)
  balance_after  Decimal  @db.Decimal(12, 2)
  reference_type String?
  reference_id   String?
  payment_number String?
  notes          String?
  created_by     String?
  created_at     DateTime @default(now())

  tenant    Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  supplier  Supplier  @relation(fields: [supplier_id], references: [id], onDelete: Cascade)
  creator   User?     @relation("SupplierCreditTransactionCreator", fields: [created_by], references: [id])
  allocations SupplierPaymentAllocation[]

  @@unique([tenant_id, payment_number])
  @@index([tenant_id, supplier_id])
  @@index([tenant_id, created_at])
}

// Matches a supplier PAYMENT transaction (in full or in part) to a specific
// Purchase bill, so advances and part-payments taken before/without a bill
// can be applied to the correct bill(s) later instead of only moving a
// tenant-wide running balance.
model SupplierPaymentAllocation {
  id             String   @id @default(uuid())
  tenant_id      String
  transaction_id String
  purchase_id    String
  amount         Decimal  @db.Decimal(12, 2)
  created_at     DateTime @default(now())

  tenant      Tenant                    @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  transaction SupplierCreditTransaction @relation(fields: [transaction_id], references: [id], onDelete: Cascade)
  purchase    Purchase                  @relation(fields: [purchase_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, purchase_id])
  @@index([tenant_id, transaction_id])
}

model Purchase {
  id              String   @id @default(uuid())
  tenant_id       String
  store_id        String
  supplier_id     String?
  purchase_number String
  /// The supplier's or source system's own document number. Not unique: an
  /// imported reference can legitimately repeat, and two suppliers can reuse
  /// the same bill number.
  reference_number String?
  subtotal_amount Decimal  @default(0) @db.Decimal(12, 2)
  tax_amount      Decimal  @default(0) @db.Decimal(12, 2)
  discount_amount Decimal  @default(0) @db.Decimal(12, 2)
  freight_amount  Decimal  @default(0) @db.Decimal(12, 2)
  total_amount    Decimal  @default(0) @db.Decimal(12, 2)
  paid_amount     Decimal  @default(0) @db.Decimal(12, 2)
  payment_status  String   @default("UNPAID") // UNPAID | PARTIAL | PAID
  notes           String?
  created_by      String?
  created_at      DateTime @default(now())

  tenant          Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  store           Store     @relation(fields: [store_id], references: [id])
  supplier        Supplier? @relation(fields: [supplier_id], references: [id])
  items           PurchaseItem[]
  returns         PurchaseReturn[]
  paymentAllocations SupplierPaymentAllocation[]

  @@unique([tenant_id, purchase_number])
  @@index([tenant_id, created_at])
  @@index([tenant_id, store_id])
  @@index([tenant_id, payment_status])
  @@index([tenant_id, reference_number])
}

model PurchaseItem {
  id            String   @id @default(uuid())
  purchase_id   String
  product_id    String
  quantity      Int
  unit_cost     Decimal  @db.Decimal(12, 2)
  line_total    Decimal  @db.Decimal(12, 2)

  purchase      Purchase @relation(fields: [purchase_id], references: [id], onDelete: Cascade)
  product       Product  @relation(fields: [product_id], references: [id])
  returnItems   PurchaseReturnItem[]
  jobCosts      ProductionJobCost[]
}

model PurchaseReturn {
  id               String   @id @default(uuid())
  tenant_id        String
  store_id         String
  /// Optional, mirroring SalesReturn.sale_id — validated when supplied.
  purchase_id      String?
  supplier_id      String?
  return_number    String
  reference_number String?
  total_amount     Decimal  @default(0) @db.Decimal(12, 2)
  notes            String?
  status           String   @default("RECORDED")
  created_by       String?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  tenant           Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  store            Store     @relation(fields: [store_id], references: [id])
  purchase         Purchase? @relation(fields: [purchase_id], references: [id])
  supplier         Supplier? @relation(fields: [supplier_id], references: [id])
  items            PurchaseReturnItem[]

  @@unique([tenant_id, return_number])
}

model PurchaseReturnItem {
  id               String   @id @default(uuid())
  return_id        String
  /// Null when the return has no parent purchase.
  purchase_item_id String?
  product_id       String
  quantity         Int
  unit_cost        Decimal  @db.Decimal(12, 2)
  line_total       Decimal  @db.Decimal(12, 2)

  purchaseReturn   PurchaseReturn @relation(fields: [return_id], references: [id], onDelete: Cascade)
  purchaseItem     PurchaseItem?  @relation(fields: [purchase_item_id], references: [id])
  product          Product        @relation(fields: [product_id], references: [id])
}

model PurchaseOrder {
  id              String    @id @default(uuid())
  tenant_id       String
  store_id        String
  supplier_id     String?
  po_number       String
  status          String    @default("DRAFT")
  expected_date   DateTime?
  subtotal_amount Decimal   @default(0) @db.Decimal(12, 2)
  tax_amount      Decimal   @default(0) @db.Decimal(12, 2)
  discount_amount Decimal   @default(0) @db.Decimal(12, 2)
  freight_amount  Decimal   @default(0) @db.Decimal(12, 2)
  total_amount    Decimal   @default(0) @db.Decimal(12, 2)
  notes           String?
  received_at     DateTime?
  created_by      String?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  tenant   Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  store    Store     @relation(fields: [store_id], references: [id])
  supplier Supplier? @relation(fields: [supplier_id], references: [id])
  items    PurchaseOrderItem[]

  @@unique([tenant_id, po_number])
  @@index([tenant_id, created_at])
  @@index([tenant_id, status])
}

model PurchaseOrderItem {
  id         String  @id @default(uuid())
  po_id      String
  product_id String
  quantity   Int
  unit_cost  Decimal @db.Decimal(12, 2)
  line_total Decimal @db.Decimal(12, 2)

  purchaseOrder PurchaseOrder @relation(fields: [po_id], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [product_id], references: [id])
}

model PurchaseQuotation {
  id              String    @id @default(uuid())
  tenant_id       String
  store_id        String
  supplier_id     String?
  rfq_number      String
  status          String    @default("DRAFT")
  valid_until     DateTime?
  total_amount    Decimal   @default(0) @db.Decimal(12, 2)
  notes           String?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  tenant   Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  store    Store     @relation(fields: [store_id], references: [id])
  supplier Supplier? @relation(fields: [supplier_id], references: [id])
  items    PurchaseQuotationItem[]

  @@unique([tenant_id, rfq_number])
  @@index([tenant_id, created_at])
  @@index([tenant_id, status])
}

model PurchaseQuotationItem {
  id         String  @id @default(uuid())
  rfq_id     String
  product_id String
  quantity   Int
  unit_cost  Decimal @db.Decimal(12, 2)
  line_total Decimal @db.Decimal(12, 2)

  purchaseQuotation PurchaseQuotation @relation(fields: [rfq_id], references: [id], onDelete: Cascade)
  product           Product           @relation(fields: [product_id], references: [id])
}

model Sale {
  id             String   @id @default(uuid())
  tenant_id      String
  store_id       String
  counter_id     String?
  serial_number  String
  reference_number String?  // User-editable reference, unique per tenant
  total_amount   Decimal  @db.Decimal(12, 2)
  amount_paid    Decimal    @default(0) @db.Decimal(12, 2)
  status         String
  note           String?
  created_by     String?
  created_at     DateTime @default(now())
  sale_date      DateTime @default(now())

  // Relations
  tenant         Tenant      @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  store          Store       @relation(fields: [store_id], references: [id])
  counter        PosCounter? @relation(fields: [counter_id], references: [id])
  customer_id    String?
  customer       Customer? @relation(fields: [customer_id], references: [id])
  items          SaleItem[]
  payments       PaymentRecord[]
  returns        SalesReturn[]
  warrantyClaims WarrantyClaim[]
  deliveryOrders DeliveryOrder[]

  @@unique([tenant_id, serial_number])
  @@unique([tenant_id, reference_number])
  @@index([tenant_id, created_at])
  @@index([tenant_id, sale_date])
  @@index([tenant_id, store_id])
  @@index([tenant_id, customer_id])
  @@index([tenant_id, counter_id])
}

model Customer {
  id                   String        @id @default(uuid())
  tenant_id            String
  customer_code        String
  name                 String
  owner_name           String?
  phone                String?
  email                String?
  address              String?
  profile_pic_url      String?
  customer_type        CustomerType  @default(INDIVIDUAL)
  customer_group_id    String?
  territory_id         String?
  credit_limit         Decimal?      @db.Decimal(12, 2)
  default_discount_pct Decimal?      @db.Decimal(5, 2)
  total_spent          Decimal       @default(0) @db.Decimal(12, 2)
  nid                  String?
  segment_category     String        @default("Regular")
  loyalty_points       Int           @default(0)
  due_balance          Decimal       @default(0) @db.Decimal(12, 2)
  credit_enabled       Boolean       @default(false)
  last_contacted_at    DateTime?
  preferred_channel    String        @default("PHONE")
  birthday             DateTime?
  anniversary          DateTime?
  created_at           DateTime      @default(now())
  deleted_at           DateTime?
  // Scoped per tenant, not globally: one person may shop at several storefronts,
  // so the same User links to at most one Customer *per tenant*.
  user_id              String?

  // Relations
  tenant           Tenant         @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  customerGroup    CustomerGroup? @relation(fields: [customer_group_id], references: [id])
  territory        Territory?     @relation(fields: [territory_id], references: [id])
  user             User?          @relation(fields: [user_id], references: [id])
  sales            Sale[]
  salesOrders      SalesOrder[]
  quotations       Quotation[]
  warrantyClaims   WarrantyClaim[]
  loyaltyTransactions LoyaltyTransaction[]
  interactions       CustomerInteraction[]
  crmFollowUps       CrmFollowUp[]
  creditTransactions CustomerCreditTransaction[]
  campaignRecipients CrmCampaignRecipient[]
  convertedFromLeads Lead[] @relation("LeadConvertedCustomer")
  projects           Project[]

  @@unique([tenant_id, phone])
  @@unique([tenant_id, customer_code])
  @@unique([tenant_id, user_id])
  @@index([tenant_id, deleted_at])
  @@index([tenant_id, email])
}

model CustomerGroup {
  id                   String   @id @default(uuid())
  tenant_id            String
  name                 String
  description          String?
  default_discount_pct Decimal? @db.Decimal(5, 2)
  price_list_id        String?
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  // Relations
  tenant    Tenant     @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  priceList PriceList? @relation(fields: [price_list_id], references: [id], onDelete: SetNull)
  customers Customer[]

  @@unique([tenant_id, name])
  @@index([price_list_id])
}

model PriceList {
  id                     String                 @id @default(uuid())
  tenant_id              String
  name                   String
  description            String?
  is_default             Boolean                @default(false)
  is_active              Boolean                @default(true)
  overall_discount_type  PriceListDiscountType?
  overall_discount_value Decimal?               @db.Decimal(12, 2)
  created_at             DateTime               @default(now())
  updated_at             DateTime               @updatedAt

  tenant         Tenant          @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  items          PriceListItem[]
  customerGroups CustomerGroup[]

  @@unique([tenant_id, name])
  @@index([tenant_id, is_default])
}

model PriceListItem {
  id             String                 @id @default(uuid())
  price_list_id  String
  product_id     String
  selling_price  Decimal?               @db.Decimal(12, 2)
  discount_type  PriceListDiscountType?
  discount_value Decimal?               @db.Decimal(12, 2)
  created_at     DateTime               @default(now())
  updated_at     DateTime               @updatedAt

  priceList PriceList @relation(fields: [price_list_id], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@unique([price_list_id, product_id])
  @@index([price_list_id])
}

model Territory {
  id          String   @id @default(uuid())
  tenant_id   String
  name        String
  parent_id   String?
  description String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  // Relations
  tenant    Tenant      @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  parent    Territory?  @relation("TerritoryHierarchy", fields: [parent_id], references: [id])
  children  Territory[] @relation("TerritoryHierarchy")
  customers Customer[]

  @@unique([tenant_id, name, parent_id])
}

model CustomerInteraction {
  id          String   @id @default(uuid())
  tenant_id   String
  store_id    String?
  customer_id String
  type        String   // CALL | SMS | WHATSAPP | EMAIL | VISIT | NOTE
  direction   String   @default("OUTBOUND")
  summary     String
  outcome     String?
  created_by  String?
  created_at  DateTime @default(now())

  tenant    Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  customer  Customer  @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  creator   User?     @relation("InteractionCreator", fields: [created_by], references: [id])

  @@index([tenant_id, customer_id])
  @@index([tenant_id, created_at])
}

model Lead {
  id                      String    @id @default(uuid())
  tenant_id               String
  store_id                String?
  name                    String
  mobile                  String?
  custom_fields           Json?
  email                   String?
  address                 String?
  // `category`/`source` are the legacy enum columns. They are kept in lockstep
  // with `category_id`/`source_id` (dual-written on every create/update) so a
  // rollback to the previous release still finds sane data. They are dropped in
  // the contract release, once `sync-lead-taxonomy` reports zero unbackfilled
  // rows — see docs/crm/lead-taxonomy-rollout.md. Do NOT read them in new code.
  category                LeadCategory?
  category_id             String?
  priority                LeadPriority @default(MEDIUM)
  remarks                 String?
  source                  LeadSource   @default(OTHER)
  source_id               String?
  status                  LeadStatus   @default(NEW)
  lost_reason             String?
  score                   Int          @default(0)
  linkedin_url            String?
  fb_url                  String?
  x_url                   String?
  website_url             String?
  next_step               String?
  next_step_date          DateTime?
  next_step_assigned_to   String?
  assigned_to             String?
  last_contacted_at       DateTime?
  /// When the lead reached a terminal status (CONVERTED or LOST); null while it is
  /// still open. `status` says which of the two it was, so one column serves both.
  /// Written by every path that sets a terminal status and cleared when a lead is
  /// reopened — `updated_at` cannot stand in for it, because any later edit moves it.
  closed_at               DateTime?
  converted_customer_id   String?
  created_by              String?
  created_at              DateTime  @default(now())
  updated_at              DateTime  @updatedAt

  tenant               Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  assignee             User?     @relation("LeadAssignee", fields: [assigned_to], references: [id])
  nextStepAssignee     User?     @relation("LeadNextStepAssignee", fields: [next_step_assigned_to], references: [id])
  creator              User?     @relation("LeadCreator", fields: [created_by], references: [id])
  convertedCustomer    Customer? @relation("LeadConvertedCustomer", fields: [converted_customer_id], references: [id])
  sourceOption         LeadSourceOption?   @relation(fields: [source_id], references: [id], onDelete: Restrict)
  categoryOption       LeadCategoryOption? @relation(fields: [category_id], references: [id], onDelete: Restrict)
  conversations        LeadConversation[]
  crmFollowUps         CrmFollowUp[]

  @@unique([tenant_id, mobile])
  projects Project[]

  @@index([tenant_id, status])
  @@index([tenant_id, category])
  @@index([tenant_id, priority])
  @@index([tenant_id, assigned_to])
  @@index([tenant_id, next_step_date])
  @@index([tenant_id, source_id])
  @@index([tenant_id, category_id])
  // Serves the CRM dashboard's won/lost-in-period counts, which filter on
  // status + closed_at together.
  @@index([tenant_id, status, closed_at])
  // Serves the same dashboard's new-leads-in-period count and daily trend buckets.
  @@index([tenant_id, created_at])
}

/// Tenant-editable lead sources. Replaces the `LeadSource` enum.
///
/// `code` is the immutable join key (seeded rows reuse the old enum members, so
/// the backfill and CSV import can match on it); `name` is the editable label a
/// tenant can rename freely without breaking either. Seeded rows carry
/// `is_system` and are deactivated rather than deleted, because the idempotent
/// tenant sync would otherwise resurrect them on the next container start.
model LeadSourceOption {
  id           String   @id @default(uuid())
  tenant_id    String
  code         String
  name         String
  /// 0-25 contribution to the lead score. Replaces the hardcoded SOURCE_WEIGHT
  /// map in apps/backend/src/crm-leads/lead-scoring.util.ts.
  score_weight Int      @default(5)
  sort_order   Int      @default(0)
  is_system    Boolean  @default(false)
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  leads  Lead[]

  @@unique([tenant_id, code])
  @@unique([tenant_id, name])
  @@index([tenant_id, is_active, sort_order])
}

/// Tenant-editable lead categories. Replaces the `LeadCategory` enum.
/// Flat by design — unlike CustomerGroup there is no parent/child nesting.
model LeadCategoryOption {
  id         String   @id @default(uuid())
  tenant_id  String
  code       String
  name       String
  sort_order Int      @default(0)
  is_system  Boolean  @default(false)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  leads  Lead[]

  @@unique([tenant_id, code])
  @@unique([tenant_id, name])
  @@index([tenant_id, is_active, sort_order])
}

/// How a contact row first entered the system. `BUSINESS_CARD` marks rows whose
/// fields were extracted from a photographed card, which is worth keeping: those
/// values came out of an OCR pass and are the ones most worth re-checking.
enum CrmContactCaptureSource {
  MANUAL
  BUSINESS_CARD
  IMPORT
}

/// A person the tenant knows — deliberately thinner than `Lead`.
///
/// A lead carries a pipeline (status, score, next step, source/category
/// taxonomy) because it is being worked. A contact is just an address-book row:
/// who they are, where they work, how to reach them. Keeping them separate is
/// what lets the business-card scanner drop a card into the system in one step
/// without inventing a pipeline stage for someone met at a trade fair.
model CrmContact {
  id             String   @id @default(uuid())
  tenant_id      String
  name           String
  company        String?
  designation    String?
  mobile         String?
  phone          String?
  email          String?
  address        String?
  website_url    String?
  linkedin_url   String?
  notes          String?
  capture_source CrmContactCaptureSource @default(MANUAL)
  assigned_to    String?
  created_by     String?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  tenant      Tenant                 @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  assignee    User?                  @relation("CrmContactAssignee", fields: [assigned_to], references: [id])
  creator     User?                  @relation("CrmContactCreator", fields: [created_by], references: [id])
  attachments CrmContactAttachment[]

  // Mobile is the dedupe key, as it is on Lead. Postgres treats NULLs as
  // distinct, so any number of contacts may have no mobile at all.
  @@unique([tenant_id, mobile])
  @@index([tenant_id, name])
  @@index([tenant_id, company])
  @@index([tenant_id, assigned_to])
  @@index([tenant_id, created_at])
}

/// A file kept alongside a contact — today only the photographed business card
/// the contact was read from, so the extraction can be checked against the card
/// itself rather than taken on trust.
model CrmContactAttachment {
  id         String @id @default(uuid())
  tenant_id  String
  contact_id String

  file_url  String
  file_name String
  mime_type String?
  file_size Int?

  /// Cloudinary's handle for the stored asset. Kept because `file_url` cannot be
  /// turned back into one, and without it deleting the row would strand the file.
  storage_key String?

  /// BUSINESS_CARD is the only producer today. A plain string rather than an
  /// enum so a second kind does not need a schema change, matching
  /// `LeadConversation.type`.
  kind String @default("BUSINESS_CARD")

  created_by String?
  created_at DateTime @default(now())

  tenant  Tenant     @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  contact CrmContact @relation(fields: [contact_id], references: [id], onDelete: Cascade)
  creator User?      @relation("CrmContactAttachmentCreator", fields: [created_by], references: [id])

  @@index([tenant_id, contact_id, created_at])
  @@map("crm_contact_attachments")
}

enum CustomFieldEntity {
  LEAD
}

model CustomFieldDefinition {
  id         String            @id @default(uuid())
  tenant_id  String
  entity     CustomFieldEntity
  key        String
  label      String
  order      Int               @default(0)
  is_active  Boolean           @default(true)
  created_at DateTime          @default(now())
  updated_at DateTime          @updatedAt

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, entity, key])
  @@index([tenant_id, entity])
}

/// Tenant-editable communication channels a conversation can be logged under.
/// Replaces the hardcoded CALL | SMS | WHATSAPP | … list that used to live in
/// `LeadConversationType`.
///
/// Same shape and same rules as `LeadSourceOption`: `code` is the immutable join
/// key (seeded rows reuse the old enum members so historical `LeadConversation.type`
/// values still match), `name` is the label a tenant renames freely, and seeded
/// rows carry `is_system` so the idempotent tenant sync deactivates rather than
/// resurrects them.
model ConversationChannel {
  id         String   @id @default(uuid())
  tenant_id  String
  code       String
  name       String
  /// Emoji shown beside the channel in conversation lists. Free text rather than
  /// an icon-name enum so a tenant adding "Telegram" can pick its own glyph
  /// without a code change; the UI falls back to a generic bubble when unset.
  icon       String?
  sort_order Int      @default(0)
  is_system  Boolean  @default(false)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant        Tenant             @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  conversations LeadConversation[]

  @@unique([tenant_id, code])
  @@unique([tenant_id, name])
  @@index([tenant_id, is_active, sort_order])
}

model LeadConversation {
  id          String   @id @default(uuid())
  tenant_id   String
  store_id    String?
  lead_id     String
  /// The channel's `code`, denormalised. Kept alongside `channel_id` because every
  /// filter, sort and groupBy on this table reads it, and the composite index below
  /// serves those directly — resolving a code to an id on every request would buy
  /// nothing. Written only by the service, always from the resolved channel.
  type        String
  channel_id  String?
  direction   String   @default("OUTBOUND")
  summary     String
  outcome     String?
  created_by  String?
  created_at  DateTime @default(now())

  tenant   Tenant               @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  lead     Lead                 @relation(fields: [lead_id], references: [id], onDelete: Cascade)
  creator  User?                @relation("LeadConversationCreator", fields: [created_by], references: [id])
  channel  ConversationChannel? @relation(fields: [channel_id], references: [id], onDelete: Restrict)

  @@index([tenant_id, lead_id])
  @@index([tenant_id, created_at])
  // Serves the cross-lead conversations list, which filters by type across every lead.
  // Without it a type filter degrades to a full tenant-partition scan.
  @@index([tenant_id, type, created_at])
  // Serves the per-channel usage counts on the CRM Setup screen.
  @@index([tenant_id, channel_id])
}

/// A dated, assignable prompt to contact a customer or a lead — "call Rahim
/// about his overdue invoice on Thursday". Distinct from LeadConversation /
/// CustomerInteraction, which record contact that already happened.
///
/// Named FollowUp rather than Task because "Task" belongs to the Project
/// Management module. The generic manual type is GENERAL for the same reason a
/// FOLLOW_UP type inside a FollowUp table reads badly.
model CrmFollowUp {
  id           String    @id @default(uuid())
  tenant_id    String
  store_id     String?
  customer_id  String?
  lead_id      String?
  type         String    // GENERAL | COLLECTION | BIRTHDAY | REORDER_REMINDER
  title        String
  due_at       DateTime
  completed_at DateTime?
  assigned_to  String?
  created_by   String?
  notes        String?
  status       String    @default("PENDING")
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  tenant   Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  lead     Lead?     @relation(fields: [lead_id], references: [id], onDelete: Cascade)
  assignee User?     @relation("CrmFollowUpAssignee", fields: [assigned_to], references: [id])
  creator  User?     @relation("CrmFollowUpCreator", fields: [created_by], references: [id])

  @@index([tenant_id, status, due_at])
  @@index([tenant_id, customer_id])
  @@index([tenant_id, lead_id])
}

model CustomerCreditTransaction {
  id             String   @id @default(uuid())
  tenant_id      String
  customer_id    String
  type           String   // CREDIT_SALE | PAYMENT | ADJUSTMENT
  amount         Decimal  @db.Decimal(12, 2)
  balance_after  Decimal  @db.Decimal(12, 2)
  reference_type String?
  reference_id   String?
  payment_number String?
  notes          String?
  created_by     String?
  created_at     DateTime @default(now())

  tenant    Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  customer  Customer  @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  creator   User?     @relation("CreditTransactionCreator", fields: [created_by], references: [id])

  @@unique([tenant_id, payment_number])
  @@index([tenant_id, customer_id])
  @@index([tenant_id, created_at])
}

model CrmCampaign {
  id              String    @id @default(uuid())
  tenant_id       String
  name            String
  description     String?
  status          String    @default("DRAFT")
  channel             String    // SMS | WHATSAPP | EMAIL
  target_segment      String?   // VIP | At-Risk | Regular | New | ALL
  target_group_id     String?
  subject             String?   // required for EMAIL channel
  message             String
  scheduled_at        DateTime?
  sent_at             DateTime?
  recipient_count     Int       @default(0)
  delivered_count     Int       @default(0)
  failed_count        Int       @default(0)
  attributed_revenue  Decimal   @default(0) @db.Decimal(12, 2)
  attributed_orders   Int       @default(0)
  created_by          String?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  tenant     Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  creator    User?     @relation("CampaignCreator", fields: [created_by], references: [id])
  recipients CrmCampaignRecipient[]

  @@index([tenant_id, status])
  @@index([tenant_id, created_at])
}

model CrmCampaignRecipient {
  id          String    @id @default(uuid())
  campaign_id String
  customer_id String
  phone       String
  status      String    @default("PENDING")
  sent_at     DateTime?
  error       String?

  campaign CrmCampaign @relation(fields: [campaign_id], references: [id], onDelete: Cascade)
  customer Customer    @relation(fields: [customer_id], references: [id], onDelete: Cascade)

  @@unique([campaign_id, customer_id])
  @@index([campaign_id, status])
}

model AccountGroup {
  id         String   @id @default(uuid())
  tenant_id  String
  name       String
  /// `<type digit><serial>`, e.g. 11 = the first asset group. See account-code.ts.
  /// Defaults to '' so `prisma db push` can add it to a populated table; the
  /// boot-time backfill fills it before the API serves. Phase B makes it unique.
  code       String   @default("") @db.VarChar(2)
  type       String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant     Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  subgroups  AccountSubgroup[]
  accounts   Account[]

  @@unique([tenant_id, name])
  @@index([tenant_id])
  @@map("account_groups")
}

model AccountSubgroup {
  id         String   @id @default(uuid())
  tenant_id  String
  group_id   String
  name       String
  /// Always prefixed with the parent group's code, e.g. 1101 under group 11.
  code       String   @default("") @db.VarChar(4)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant     Tenant       @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  group      AccountGroup @relation(fields: [group_id], references: [id], onDelete: Cascade)
  accounts   Account[]

  @@unique([group_id, name])
  @@index([tenant_id])
  @@index([group_id])
  @@map("account_subgroups")
}

model Account {
  id          String   @id @default(uuid())
  tenant_id   String
  group_id    String
  subgroup_id String?
  name        String
  /// Always prefixed with the parent subgroup's code (or `<group>00` when the
  /// account hangs directly off its group), e.g. 110101 under subgroup 1101.
  /// Still nullable in phase A: this column already existed with NULL rows, and
  /// `db push` refuses to make an existing column required, default or not.
  /// The backfill fills every row; phase B is what tightens it. See TODO.md.
  code        String?  @db.VarChar(6)
  /// The flat 4-digit code this account carried before hierarchical codes.
  /// Kept searchable for one release so tenants can map their old paperwork.
  legacy_code String?
  type        String
  category    String   @default("general")
  /// Non-null on a control account (AR / Purchase Payable / Salary Payable):
  /// its balance is maintained as a subsidiary ledger, one balance per party.
  /// autoPostFromRules tags the voucher line hitting this account with party_id.
  party_type  PartyType?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  tenant      Tenant          @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  group       AccountGroup    @relation(fields: [group_id], references: [id])
  subgroup    AccountSubgroup? @relation(fields: [subgroup_id], references: [id])
  voucherDetails VoucherDetail[]
  debitPostingRules PostingRule[] @relation("PostingRuleDebitAccount")
  creditPostingRules PostingRule[] @relation("PostingRuleCreditAccount")
  budgets        AccountBudget[]
  recurringJournalLines RecurringJournalLine[]
  recurringVoucherLines RecurringVoucherLine[]
  voucherTemplateLines  VoucherTemplateLine[]
  paymentRecords PaymentRecord[]

  @@unique([tenant_id, name])
  @@index([tenant_id])
  @@index([group_id])
  @@index([subgroup_id])
  @@index([tenant_id, type])
  @@index([tenant_id, category])
  @@index([tenant_id, code])
  @@map("accounts")
}

model PostingRule {
  id                String                  @id @default(cuid())
  tenant_id         String
  event_type        PostingRuleEventType
  condition_key     PostingRuleConditionKey @default(none)
  condition_value   String?
  debit_account_id  String
  credit_account_id String
  priority          Int                     @default(100)
  is_active         Boolean                 @default(true)
  created_at        DateTime                @default(now())
  updated_at        DateTime                @updatedAt

  tenant       Tenant  @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  debitAccount Account @relation("PostingRuleDebitAccount", fields: [debit_account_id], references: [id], onDelete: Restrict)
  creditAccount Account @relation("PostingRuleCreditAccount", fields: [credit_account_id], references: [id], onDelete: Restrict)

  @@index([tenant_id, event_type, is_active])
  @@index([tenant_id, condition_key, condition_value])
  @@index([tenant_id, debit_account_id])
  @@index([tenant_id, credit_account_id])
  @@map("posting_rules")
}

/// Tenant-wide accounting controls. Every flag defaults to the pre-feature
/// behaviour, so a tenant that never opens the settings page is unaffected.
model AccountingSettings {
  id                            String   @id @default(uuid())
  tenant_id                     String   @unique
  /// Manually entered vouchers (and opening-balance imports) land as PENDING and
  /// stay out of approved-only reports until someone with APPROVE_VOUCHER acts.
  require_voucher_approval      Boolean  @default(false)
  /// What happens to vouchers other modules post automatically (sales, purchases,
  /// payments, payroll…) while approval is required. True — the default — lets
  /// them post straight through so day-to-day operations never queue behind an
  /// approver. False routes them into the same approval queue as manual entries.
  auto_approve_system_vouchers  Boolean  @default(true)
  /// When true every accounting report, ledger and dashboard figure counts only
  /// APPROVED vouchers. A per-request `approvedOnly` param overrides it.
  reports_approved_only         Boolean  @default(false)
  created_at                    DateTime @default(now())
  updated_at                    DateTime @updatedAt

  tenant                        Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@map("accounting_settings")
}

model VoucherSequence {
  id           String   @id
  tenant_id    String
  voucher_type String
  prefix       String
  next_number  Int      @default(1)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  tenant       Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, voucher_type])
  @@index([tenant_id])
  @@map("voucher_sequences")
}

model Voucher {
  id               String   @id @default(uuid())
  tenant_id        String
  voucher_number   String
  voucher_type     String
  source_module    String?
  source_type      String?
  source_id        String?
  idempotency_key  String?
  description      String?
  reference_number String?
  date             DateTime @default(now())
  store_id         String?
  attribution      String   @default("BRANCH")
  counterparty_store_id String?
  /// Maker-checker state: PENDING / APPROVED / REJECTED. Defaults to APPROVED so
  /// tenants that never enable voucher approval keep the pre-feature behaviour —
  /// every voucher hits the ledger the moment it is saved.
  approval_status  String   @default("APPROVED")
  approved_by      String?
  approved_at      DateTime?
  rejection_reason String?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  tenant           Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  store            Store?   @relation("VoucherStore", fields: [store_id], references: [id])
  counterpartyStore Store?  @relation("VoucherCounterpartyStore", fields: [counterparty_store_id], references: [id])
  approver         User?    @relation("VoucherApprover", fields: [approved_by], references: [id])
  details          VoucherDetail[]
  attachments      VoucherAttachment[]
  postingEvents    PostingEvent[]
  fundTransfersSource      FundTransfer[] @relation("FundTransferSourceVoucher")
  fundTransfersDestination FundTransfer[] @relation("FundTransferDestinationVoucher")

  @@unique([tenant_id, voucher_number])
  @@index([tenant_id])
  @@index([tenant_id, voucher_type])
  @@index([tenant_id, source_module, source_type, source_id])
  @@index([tenant_id, store_id])
  @@index([tenant_id, attribution])
  @@index([tenant_id, approval_status])
  @@index([date])
  @@map("vouchers")
}

model PostingEvent {
  id               String            @id @default(cuid())
  tenant_id        String
  event_type       PostingRuleEventType
  source_module    String
  source_type      String
  source_id        String
  idempotency_key  String
  status           PostingEventStatus @default(pending)
  voucher_id       String?
  attempt_count    Int               @default(0)
  last_error       String?
  last_attempt_at  DateTime?
  created_at       DateTime          @default(now())
  updated_at       DateTime          @updatedAt

  tenant           Tenant            @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  voucher          Voucher?          @relation(fields: [voucher_id], references: [id], onDelete: SetNull)

  @@unique([tenant_id, idempotency_key])
  @@index([tenant_id, status, updated_at])
  @@index([tenant_id, source_module, source_type, source_id])
  @@map("posting_events")
}

model VoucherDetail {
  id            String   @id @default(uuid())
  voucher_id    String
  account_id    String
  debit_amount  Decimal  @default(0) @db.Decimal(12, 2)
  credit_amount Decimal  @default(0) @db.Decimal(12, 2)
  comment       String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  voucher       Voucher  @relation(fields: [voucher_id], references: [id], onDelete: Cascade)
  account       Account  @relation(fields: [account_id], references: [id])
  cost_center_id String?
  costCenter     CostCenter? @relation("VoucherDetailCostCenter", fields: [cost_center_id], references: [id])
  /// Set when this line hits a control account, tying it to one customer,
  /// supplier or employee. party_id is a polymorphic reference resolved by
  /// party_type (Customer/Supplier/Employee id) — deliberately NOT a foreign key,
  /// since it points at three different tables. The subsidiary ledger for a party
  /// is `voucher_details WHERE party_id = X`.
  party_type    PartyType?
  party_id      String?

  @@index([voucher_id])
  @@index([account_id])
  @@index([cost_center_id])
  @@index([party_id])
  @@map("voucher_details")
}

model VoucherAttachment {
  id         String   @id @default(uuid())
  tenant_id  String
  voucher_id String
  file_url   String
  file_name  String
  mime_type  String?
  file_size  Int?
  created_at DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  voucher Voucher @relation(fields: [voucher_id], references: [id], onDelete: Cascade)

  @@index([voucher_id])
  @@index([tenant_id])
  @@map("voucher_attachments")
}

model PaymentRecord {
  id             String   @id @default(uuid())
  sale_id        String
  payment_method String
  amount         Decimal  @db.Decimal(12, 2)
  account_id     String?  // Links payment to account (for accounting integration)
  created_at     DateTime @default(now())

  // Relations
  sale           Sale     @relation(fields: [sale_id], references: [id], onDelete: Cascade)
  account        Account? @relation(fields: [account_id], references: [id], onDelete: SetNull)

  @@index([account_id])
}

model SaleItem {
  id                  String   @id @default(uuid())
  sale_id             String
  product_id          String
  quantity            Int
  price_at_sale       Decimal  @db.Decimal(12, 2)
  unit_cost_at_sale   Decimal? @db.Decimal(12, 2)

  // Relations
  sale                Sale     @relation(fields: [sale_id], references: [id], onDelete: Cascade)
  product             Product  @relation(fields: [product_id], references: [id])
  returns             SalesReturnItem[]

  @@index([sale_id])
}

model SalesReturn {
  id             String   @id @default(uuid())
  tenant_id      String
  store_id       String
  /// Optional: a return can be recorded without the original sale, e.g. goods
  /// coming back from before the business moved onto this system. When set it
  /// is validated — the lines must belong to that sale and stay within what is
  /// still returnable on it.
  sale_id        String?
  return_number  String
  /// The source system's own document number. Not unique — an imported
  /// reference can repeat, matching Purchase.reference_number.
  reference_number String?
  total_refund   Decimal  @db.Decimal(12, 2)
  reason         String?
  status         String   @default("COMPLETED")
  created_by     String?
  created_at     DateTime @default(now())
  
  // Relations
  tenant         Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  store          Store    @relation(fields: [store_id], references: [id])
  sale           Sale?    @relation(fields: [sale_id], references: [id])
  items          SalesReturnItem[]

  @@unique([tenant_id, return_number])
  @@index([tenant_id, reference_number])
}

model SalesReturnItem {
  id             String   @id @default(uuid())
  return_id      String
  /// Null when the return has no parent sale; `product_id` then identifies the
  /// goods and `refund_amount` carries the agreed value.
  sale_item_id   String?
  product_id     String
  quantity       Int
  refund_amount  Decimal  @db.Decimal(12, 2)
  
  // Relations
  return         SalesReturn @relation(fields: [return_id], references: [id], onDelete: Cascade)
  sale_item      SaleItem?   @relation(fields: [sale_item_id], references: [id])
  product        Product     @relation(fields: [product_id], references: [id])
}

model SalesOrder {
  id             String   @id @default(uuid())
  tenant_id      String
  store_id       String
  customer_id    String?
  order_number   String
  total_amount   Decimal  @db.Decimal(12, 2)
  amount_paid    Decimal    @default(0) @db.Decimal(12, 2)
  status         String   @default("DRAFT") // DRAFT, CONFIRMED, PROCESSING, DELIVERED, CANCELLED
  payment_status String   @default("UNPAID") // UNPAID, PARTIAL, PAID
  delivery_date  DateTime?
  created_by     String?
  created_at     DateTime @default(now())
  
  // Relations
  tenant         Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  store          Store    @relation(fields: [store_id], references: [id])
  customer       Customer? @relation(fields: [customer_id], references: [id])
  items          SalesOrderItem[]
  deposits       OrderDeposit[]

  @@unique([tenant_id, order_number])
  @@index([tenant_id, status])
  @@index([tenant_id, created_at])
}

model SalesOrderItem {
  id             String   @id @default(uuid())
  order_id       String
  product_id     String
  quantity       Int
  price_at_order Decimal  @db.Decimal(12, 2)
  
  // Relations
  order          SalesOrder @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product        Product    @relation(fields: [product_id], references: [id])
}

model OrderDeposit {
  id             String   @id @default(uuid())
  order_id       String
  amount         Decimal  @db.Decimal(12, 2)
  payment_method String
  created_at     DateTime @default(now())
  
  // Relations
  order          SalesOrder @relation(fields: [order_id], references: [id], onDelete: Cascade)
}

model Quotation {
  id                String   @id @default(uuid())
  tenant_id         String
  store_id          String
  customer_id       String?
  quote_number      String
  total_amount      Decimal  @db.Decimal(12, 2)
  status            String   @default("DRAFT") // DRAFT, SENT, ACCEPTED, REJECTED, EXPIRED, CONVERTED, REVISED
  valid_until       DateTime?
  version           Int      @default(1)
  original_quote_id String?
  notes             String?
  /// Unguessable secret authorizing the public view. Clearing it revokes every
  /// link ever shared for this quotation, short or long.
  share_token       String?  @unique
  share_token_at    DateTime?
  created_at        DateTime @default(now())

  // Relations
  tenant            Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  store             Store    @relation(fields: [store_id], references: [id])
  customer          Customer? @relation(fields: [customer_id], references: [id])
  items             QuotationItem[]

  @@unique([tenant_id, quote_number, version])
}

model QuotationItem {
  id             String   @id @default(uuid())
  quotation_id   String
  product_id     String
  quantity       Int
  unit_price     Decimal  @db.Decimal(12, 2)
  
  // Relations
  quotation      Quotation @relation(fields: [quotation_id], references: [id], onDelete: Cascade)
  product        Product   @relation(fields: [product_id], references: [id])
}

model SubscriptionPlan {
  id            String   @id @default(uuid())
  code          SubscriptionPlanCode @unique
  name          String
  description   String?
  monthly_price Decimal  @db.Decimal(12, 2)
  yearly_price  Decimal? @db.Decimal(12, 2)
  features_json            Json     @default("{}")
  marketing_features_json  Json     @default("[]")
  is_active                Boolean  @default(true)
  subscriptions TenantSubscription[]
}

// ── Add-on modules (independently priced, purchasable regardless of base plan) ──

// Catalog of optional modules a tenant can buy on top of their subscription plan
// (e.g. Manufacturing, Advanced Accounting). `code` is a plain string, not an
// enum, so new add-ons never require a schema migration.
model AddonModule {
  id            String   @id @default(uuid())
  code          String   @unique
  name          String
  description   String?
  category      String?
  monthly_price Decimal  @db.Decimal(12, 2)
  yearly_price  Decimal? @db.Decimal(12, 2)
  features_json Json     @default("{}")
  is_active     Boolean  @default(true)
  sort_order    Int      @default(0)

  subscriptions TenantAddonSubscription[]

  @@index([is_active, sort_order])
}

// A tenant's purchase of a single add-on module, billed independently of but
// alongside the tenant's base TenantSubscription.
model TenantAddonSubscription {
  id                        String             @id @default(uuid())
  tenant_id                 String
  addon_id                  String
  status                    SubscriptionStatus @default(ACTIVE)
  current_period_start      DateTime           @default(now())
  current_period_end        DateTime
  cancel_at_period_end      Boolean            @default(false)
  provider_name             String?
  provider_subscription_ref String?

  tenant Tenant      @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  addon  AddonModule @relation(fields: [addon_id], references: [id])

  @@unique([tenant_id, addon_id])
  @@index([addon_id, status])
}

model CashierSession {
  id            String   @id @default(uuid())
  tenant_id     String
  store_id      String
  counter_id    String?
  user_id       String   // The cashier/user who opened the session
  opened_at     DateTime @default(now())
  closed_at     DateTime?
  opening_cash  Decimal  @default(0) @db.Decimal(12, 2)
  closing_cash  Decimal  @default(0) @db.Decimal(12, 2)
  status        String   @default("OPEN") // OPEN, CLOSED

  // Relations
  tenant        Tenant      @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  store         Store       @relation(fields: [store_id], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  counter       PosCounter? @relation(fields: [counter_id], references: [id])
  cashTransactions CashTransaction[]

  @@index([tenant_id, status])
  @@index([tenant_id, counter_id])
}

model CashTransaction {
  id            String   @id @default(uuid())
  tenant_id     String
  session_id    String
  amount        Decimal  @db.Decimal(12, 2) // Positive for cash in, negative for cash out
  type          String   // e.g., 'DROP', 'LOAN', 'PAYOUT', 'OTHER'
  description   String?
  created_at    DateTime @default(now())
   
  // Relations
  tenant        Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  session       CashierSession @relation(fields: [session_id], references: [id], onDelete: Cascade)
}

model TenantSubscription {
  id                 String             @id @default(uuid())
  tenant_id          String             @unique
  plan_id            String
  status             SubscriptionStatus @default(TRIALING)
  current_period_start DateTime         @default(now())
  current_period_end DateTime
  cancel_at_period_end Boolean          @default(false)
  provider_name      String?
  provider_customer_ref String?
  provider_subscription_ref String?
  // Admin-granted subscription discount applied to future subscription fees.
  // discount_type: 'PERCENTAGE' (value = percent off) | 'FIXED' (value = amount off in BDT).
  discount_type      String?
  discount_value     Decimal?           @db.Decimal(12, 2)

  // Relations
  tenant             Tenant             @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  plan               SubscriptionPlan   @relation(fields: [plan_id], references: [id])

  @@index([plan_id, status])
}

model BillingEvent {
  id                 String   @id @default(uuid())
  tenant_id          String
  provider_name      String
  external_event_id  String
  event_type         String
  status             String
  reference_id       String?
  amount             Decimal? @db.Decimal(12, 2)
  currency           String?
  payload            Json
  created_at         DateTime @default(now())

  tenant             Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@unique([provider_name, external_event_id])
  @@index([tenant_id, created_at])
  @@index([tenant_id, provider_name])
}

// ── SMS Credits (prepaid balance the shop spends when sending SMS) ────────────

// Purchasable top-up packages (number of SMS credits for a fixed price).
model SmsPackage {
  id         String   @id @default(uuid())
  name       String
  credits    Int                              // SMS credits granted on purchase
  price      Decimal  @db.Decimal(12, 2)      // price for the package
  currency   String   @default("BDT")
  is_active  Boolean  @default(true)
  sort_order Int      @default(0)
  created_at DateTime @default(now())

  @@index([is_active, sort_order])
}

// Ledger of every change to a tenant's SMS credit balance.
model SmsTransaction {
  id            String   @id @default(uuid())
  tenant_id     String
  type          String   // PURCHASE | USAGE | ADJUSTMENT | REFUND
  credits       Int      // positive = credited, negative = consumed
  balance_after Int      // resulting balance after this entry
  description   String?
  recipient     String?  // destination phone number for USAGE entries
  reference     String?  // billing/payment reference for PURCHASE entries
  created_at    DateTime @default(now())

  tenant        Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, created_at])
}

// ── Multi-Store Access & Permission Models ───────────────────────────────────

model UserStoreAccess {
  id           String   @id @default(uuid())
  user_id      String
  store_id     String
  tenant_id    String
  // STORE_ONLY = access to exactly this one context
  // MULTI_STORE_CAPABLE = can switch between assigned stores
  access_level String   @default("STORE_ONLY")
  created_at   DateTime @default(now())

  user         User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  store        Store    @relation(fields: [store_id], references: [id], onDelete: Cascade)
  tenant       Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@unique([user_id, store_id])
  @@index([tenant_id, store_id])
  @@index([user_id, tenant_id])
}

model UserStorePermission {
  id           String          @id @default(uuid())
  user_id      String
  store_id     String
  tenant_id    String
  permission   StorePermission
  granted_by   String
  granted_at   DateTime        @default(now())

  user         User            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  store        Store           @relation(fields: [store_id], references: [id], onDelete: Cascade)
  tenant       Tenant          @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@unique([user_id, store_id, permission])
  @@index([user_id, store_id])
  @@index([tenant_id, store_id, permission])
}

// Store-specific product price overrides.
// store_id = NULL means base price (default for all stores).
model ProductPrice {
  id             String    @id @default(uuid())
  tenant_id      String
  product_id     String
  store_id       String?
  price          Decimal   @db.Decimal(12, 2)
  cost           Decimal?  @db.Decimal(12, 2)
  effective_from DateTime  @default(now())
  effective_to   DateTime?
  created_at     DateTime  @default(now())

  tenant         Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  product        Product   @relation(fields: [product_id], references: [id], onDelete: Cascade)
  store          Store?    @relation(fields: [store_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, product_id, store_id])
  @@index([product_id, store_id, effective_from])
}

model FundTransfer {
  id                    String    @id @default(uuid())
  tenant_id             String
  source_store_id       String
  destination_store_id  String
  amount                Decimal   @db.Decimal(12, 2)
  method                String    @default("CASH")  // CASH, CHECK, BANK_TRANSFER
  description           String?
  // INITIATED, IN_TRANSIT, RECEIVED, CANCELLED
  status                String    @default("INITIATED")
  initiated_by          String
  received_by           String?
  // Voucher linkage for accounting integration
  source_voucher_id     String?
  destination_voucher_id String?
  created_at            DateTime  @default(now())
  received_at           DateTime?

  tenant                Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  sourceStore           Store     @relation("FundTransferSourceStore", fields: [source_store_id], references: [id])
  destinationStore      Store     @relation("FundTransferDestinationStore", fields: [destination_store_id], references: [id])
  initiatedByUser       User      @relation("FundTransferInitiator", fields: [initiated_by], references: [id])
  receivedByUser        User?     @relation("FundTransferReceiver", fields: [received_by], references: [id])
  sourceVoucher         Voucher?  @relation("FundTransferSourceVoucher", fields: [source_voucher_id], references: [id])
  destinationVoucher    Voucher?  @relation("FundTransferDestinationVoucher", fields: [destination_voucher_id], references: [id])

  @@index([tenant_id, status, created_at])
  @@index([tenant_id, source_store_id])
  @@index([tenant_id, destination_store_id])
}

// Warranty claim statuses: SUBMITTED, APPROVED, REJECTED, REPAIRED, REPLACED, COMPLETED
model WarrantyClaim {
  id                       String    @id @default(uuid())
  tenant_id                String
  store_id                 String
  claim_number             String
  serial_number            String
  product_id               String
  sale_id                  String?
  customer_id              String?
  status                   String    @default("SUBMITTED")
  reason                   String
  description              String?
  resolution_notes         String?
  replacement_serial_number String?
  resolved_at              DateTime?
  created_at               DateTime  @default(now())
  updated_at               DateTime  @updatedAt

  tenant           Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  store            Store     @relation(fields: [store_id], references: [id])
  sale             Sale?     @relation(fields: [sale_id], references: [id])
  customer         Customer? @relation(fields: [customer_id], references: [id])
  product          Product   @relation(fields: [product_id], references: [id])

  @@unique([tenant_id, claim_number])
  @@index([tenant_id, status, created_at])
  @@index([tenant_id, serial_number])
  @@index([tenant_id, product_id])
  @@index([tenant_id, customer_id])
}

model Feedback {
  id         String   @id @default(cuid())
  tenantId   String
  userId     String
  type       String   // 'bug' | 'feature' | 'general'
  message    String
  page       String?
  createdAt  DateTime @default(now())

  /// Admin-driven automation pipeline (propose plan -> approve -> implement -> PR -> rollback).
  /// NEW | ADMIN_REVIEWING | PLAN_REQUESTED | PLAN_PROPOSED | PLAN_APPROVED | CHANGES_REQUESTED
  /// | IN_PROGRESS | PR_OPENED | MERGED | RESOLVED | ROLLED_BACK
  status            String    @default("NEW")
  adminInstruction  String?
  prNumber          Int?
  prUrl             String?
  mergeCommitSha    String?
  backupSnapshotId  String?
  deployedAt        DateTime?
  lastError         String?
  rollbackPrNumber  Int?
  rollbackPrUrl     String?
  updatedAt         DateTime  @updatedAt

  tenant Tenant         @relation(fields: [tenantId], references: [id])
  user   User           @relation(fields: [userId], references: [id])
  plans  FeedbackPlan[]

  @@map("feedbacks")
}

/// A single version of an agent-proposed implementation plan for a Feedback
/// item, reviewed and approved/rejected by a platform admin before any code
/// is written. Versioned so a "request changes" revision loop keeps history.
model FeedbackPlan {
  id           String    @id @default(cuid())
  feedbackId   String
  version      Int
  planText     String
  hasMigration Boolean   @default(false)
  /// PROPOSED | APPROVED | CHANGES_REQUESTED | SUPERSEDED
  status       String    @default("PROPOSED")
  adminComment String?
  createdAt    DateTime  @default(now())
  reviewedAt   DateTime?
  reviewedBy   String?

  feedback Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  @@index([feedbackId, version])
  @@map("feedback_plans")
}

model ApiKey {
