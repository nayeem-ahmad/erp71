enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  HOLIDAY
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum PostingRuleEventType {
  sale
  sale_return
  purchase
  purchase_return
  inventory_adjustment
  fund_movement
  expense
  loan_disbursement
  loan_repayment
  customer_payment
  supplier_payment
  depreciation
  cash_transaction
  salary_accrual
  salary_payment
  asset_acquisition
  fund_transfer
  investor_contribution
  investor_withdrawal
  investor_profit_accrual
  investor_profit_payout
}

/// A subsidiary-ledger party. Marks a control account (Accounts Receivable,
/// Purchase Payable, Salary Payable, Investor Profit Payable) as one whose balance is the sum of
/// per-party balances, and tags each voucher line on such an account with the
/// party it belongs to. See Account.party_type and VoucherDetail.party_id.
enum PartyType {
  CUSTOMER
  SUPPLIER
  EMPLOYEE
  INVESTOR
}

enum PostingRuleConditionKey {
  payment_mode
  reason_type
  transfer_scope
  loan_direction
  payment_direction
  none
}

enum PostingEventStatus {
  pending
  posted
  failed
  skipped
}

enum DepreciationMethod {
  STRAIGHT_LINE
  DECLINING_BALANCE
}

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  passwordHash      String
  name              String?
  preferred_locale  String    @default("en")
  token_version     Int       @default(0)
  // Bumped independently of `token_version` so signing out of (or being kicked
  // from) the ERP app does not silently drop the same person's storefront
  // customer sessions, and vice versa. A password change bumps both.
  storefront_token_version Int @default(0)
  is_platform_admin Boolean   @default(false)
  mobile_country_code String  @default("BD")
  mobile              String?
  email_verified_at DateTime?
  avatar_url        String?
  totp_secret       String?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  // Relations
  tenantsOwned              Tenant[]                @relation("TenantOwner")
  tenantMembers             TenantUser[]
  cashierSessions           CashierSession[]
  storeAccess               UserStoreAccess[]
  storePermissions          UserStorePermission[]
  fundTransfersInitiated    FundTransfer[]          @relation("FundTransferInitiator")
  fundTransfersReceived     FundTransfer[]          @relation("FundTransferReceiver")
  auditLogs                 AuditLog[]
  passwordResetTokens       PasswordResetToken[]
  emailVerificationTokens   EmailVerificationToken[]
  sentInvitations           UserInvitation[]        @relation("InvitationSender")
  feedbacks                 Feedback[]
  supportMessages           SupportMessage[]         @relation("SupportMessageSender")
  notifications             Notification[]
  storefrontCustomers       Customer[]
  storefrontOrders          StorefrontOrder[]
  employee                  Employee?
  approvedLeaves            LeaveRequest[] @relation("LeaveApprover")
  approvedVouchers          Voucher[]      @relation("VoucherApprover")
  createdInteractions       CustomerInteraction[] @relation("InteractionCreator")
  assignedCrmFollowUps      CrmFollowUp[] @relation("CrmFollowUpAssignee")
  createdCrmFollowUps       CrmFollowUp[] @relation("CrmFollowUpCreator")
  refereeProfile            Referee?
  assignedLeads             Lead[]        @relation("LeadAssignee")
  nextStepAssignedLeads     Lead[]        @relation("LeadNextStepAssignee")
  createdLeads              Lead[]        @relation("LeadCreator")
  assignedCrmContacts       CrmContact[]  @relation("CrmContactAssignee")
  createdCrmContacts        CrmContact[]  @relation("CrmContactCreator")
  crmContactAttachments     CrmContactAttachment[] @relation("CrmContactAttachmentCreator")
  createdLeadConversations  LeadConversation[] @relation("LeadConversationCreator")
  createdCreditTransactions CustomerCreditTransaction[] @relation("CreditTransactionCreator")
  createdSupplierCreditTransactions SupplierCreditTransaction[] @relation("SupplierCreditTransactionCreator")
  createdCampaigns          CrmCampaign[]              @relation("CampaignCreator")
  managedProjects           Project[]                  @relation("ProjectManager")
  createdProjects           Project[]                  @relation("ProjectCreator")
  projectMemberships        ProjectMember[]            @relation("ProjectMemberUser")
  assignedProjectTasks      ProjectTask[]              @relation("ProjectTaskAssignee")
  createdProjectTasks       ProjectTask[]              @relation("ProjectTaskCreator")
  projectTimeEntries        ProjectTimeEntry[]         @relation("ProjectTimeEntryUser")
  projectRemainingLogs      ProjectTaskRemainingLog[]  @relation("RemainingLogUser")
  projectComments           ProjectComment[]           @relation("ProjectCommentUser")
  projectTaskActivities     ProjectTaskActivity[]      @relation("ProjectTaskActivityActor")
  projectTaskWatching       ProjectTaskWatcher[]       @relation("ProjectTaskWatcherUser")
  projectAttachments        ProjectAttachment[]        @relation("ProjectAttachmentCreator")
}

model PasswordResetToken {
  id         String    @id @default(uuid())
  user_id    String
  token_hash String    @unique
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime  @default(now())

  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

model EmailVerificationToken {
  id         String   @id @default(uuid())
  user_id    String
  token_hash String   @unique
  expires_at DateTime
  created_at DateTime @default(now())

  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

model UserInvitation {
  id             String    @id @default(uuid())
  tenant_id      String
  email          String
  tenant_role_id String
  token_hash     String    @unique
  invited_by     String
  expires_at     DateTime
  accepted_at    DateTime?
  created_at     DateTime  @default(now())

  tenant      Tenant     @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  tenantRole  TenantRole @relation(fields: [tenant_role_id], references: [id], onDelete: Restrict)
  invitedBy   User       @relation("InvitationSender", fields: [invited_by], references: [id])

  @@index([tenant_id, email])
}

model AuditLog {
  id          String   @id @default(uuid())
  tenant_id   String?
  user_id     String?
  action      String
  entity      String
  entity_id   String?
  payload     Json?
  ip_address  String?
  user_agent  String?
  created_at  DateTime @default(now())

  user        User?    @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([tenant_id, entity, created_at])
  @@index([user_id, created_at])
  @@index([entity, entity_id])
}

/// Execution record for scheduled (cron) jobs — platform-scoped, not
/// tenant-scoped. Powers cron-job observability in system-health monitoring.
model JobRun {
  id          String    @id @default(uuid())
  job_name    String
  status      String    // RUNNING | SUCCESS | FAILED
  started_at  DateTime  @default(now())
  finished_at DateTime?
  duration_ms Int?
  error       String?
  created_at  DateTime  @default(now())

  @@index([job_name, started_at])
  @@index([job_name, status, finished_at])
}

/// Progress tracker + append-detection marker for a six-month demo-data load.
/// Tenant-scoped. One row per "Load Demo Data" invocation; batch_number lets a
/// tenant append multiple loads. Drives the in-process background generator and
/// the Settings → Data progress UI (polled via GET /tenants/demo-data/status).
model DemoDataBatch {
  id           String    @id @default(uuid())
  tenant_id    String
  batch_number Int
  status       String    @default("PENDING") // PENDING | RUNNING | COMPLETED | FAILED
  phase        String?
  processed    Int       @default(0)
  total        Int       @default(0)
  counts       Json?
  started_at   DateTime  @default(now())
  finished_at  DateTime?
  error        String?

  @@index([tenant_id])
  @@map("demo_data_batches")
}

model Tenant {
  id                   String   @id @default(uuid())
  name                 String
  owner_id             String
  default_locale       String   @default("en")
  /// When false the workspace is English-only and the language switcher is hidden.
  localization_enabled Boolean  @default(false)
  /// Second language offered alongside English when localization_enabled is true.
  secondary_locale     String?
  created_at           DateTime @default(now())
  storefront_slug      String?  @unique
  storefront_enabled   Boolean  @default(false)
  storefront_banner    String?
  storefront_hero_image String?
  storefront_hero_headline String?
  brand_primary_color  String?
  brand_logo_url       String?
  brand_favicon_url    String?
  brand_business_name  String?
  default_vat_rate     Decimal? @db.Decimal(5, 2)  // e.g. 15.00 for 15% BD VAT
  vat_registration_no  String?                      // NBR VAT registration number
  business_tin         String?                      // Tax Identification Number
  business_type        String?  // e.g. SURGICAL_MEDICAL, PHARMACY, GROCERY, COMPUTER_HARDWARE
  /// Which dashboard this workspace lands on: AUTO | RETAIL | ACCOUNTING.
  /// AUTO defers to the plan's `accountingDashboard` entitlement. This is a
  /// preference, not a capability, which is why it is a column and not a key in
  /// the plan's features_json — see `resolveDashboardVariant` in shared-types.
  dashboard_preference String   @default("AUTO")
  /// When the setup wizard was finished or skipped for this workspace. Set once
  /// by whoever dismisses it; every member on every device then skips onboarding.
  onboarding_dismissed_at DateTime?
  deleted_at           DateTime?

  /// Per-tenant overrides of the platform feature switches, e.g. `{"voice": true}`.
  /// A missing key inherits the platform default; an explicit boolean wins over it.
  feature_overrides    Json     @default("{}")

  loyalty_points_enabled Boolean  @default(false)
  loyalty_earn_rate      Decimal? @db.Decimal(8, 4)  // points per BDT (e.g. 1.0 = 1 point per ৳1)
  loyalty_redeem_rate    Decimal? @db.Decimal(8, 4)  // BDT value per point (e.g. 0.01 = 1 point = ৳0.01)
