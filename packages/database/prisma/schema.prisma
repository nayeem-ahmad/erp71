model Employee {
  id              String         @id @default(uuid())
  tenant_id       String
  employee_code   String
  name            String
  phone           String
  email           String?
  nid             String?
  date_of_joining DateTime?
  department_id   String?
  designation_id  String?
  user_id         String?        @unique
  basic_salary    Decimal?       @db.Decimal(12, 2)
  status          EmployeeStatus @default(ACTIVE)
  /// Whether this employee may use the self-service portal. Distinct from
  /// `user_id`: linking a login is how staff get an ERP account, and most
  /// linked employees are staff who should keep using the admin screens.
