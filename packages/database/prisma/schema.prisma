model StockTakeSession {
  id             String    @id @default(uuid())
  tenant_id      String
  warehouse_id   String
  session_number String
  status         String    @default("DRAFT")
  notes          String?
  started_at     DateTime  @default(now())
  posted_at      DateTime?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  tenant    Tenant               @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  warehouse Warehouse            @relation(fields: [warehouse_id], references: [id])
  lines     StockTakeCountLine[]

  @@unique([tenant_id, session_number])
  @@index([tenant_id, warehouse_id, status])
  @@index([tenant_id, created_at])
}

model StockTakeCountLine {
  id                String  @id @default(uuid())
  session_id        String
  product_id        String
  expected_quantity Int
  counted_quantity  Int?
  variance_quantity Int?
  reason_id         String?
  note              String?

  session StockTakeSession @relation(fields: [session_id], references: [id], onDelete: Cascade)
  product Product          @relation(fields: [product_id], references: [id])
  reason  InventoryReason? @relation(fields: [reason_id], references: [id])

  @@unique([session_id, product_id])
  @@index([session_id, variance_quantity])
}

/// A branch asking for stock it does not have.
///
/// Every other inventory document in this schema records something that already
/// happened — a transfer that moved, a count that was taken, shrinkage that was
/// written off. This one records something that has *not* happened yet, which is
/// why it carries an approval pair (`reviewed_by`/`reviewed_at`) and a separate
/// `quantity_approved` per line: what the shop asked for and what head office
/// agreed to are different numbers, and both are worth keeping.
///
/// Status: DRAFT → SUBMITTED → APPROVED | REJECTED → FULFILLED, with CANCELLED
/// reachable from DRAFT or SUBMITTED. Nothing here touches stock; fulfilment is
/// the transfer or purchase that follows, and this row only records that it was
/// dealt with.
model ProductDemand {
  id            String    @id @default(uuid())
  tenant_id     String
  /// The branch the demand is raised for. Nullable because a single-store
  /// workspace has no store context on the request.
  store_id      String?
  /// Where the goods are wanted.
  warehouse_id  String
  demand_number String
  status        String    @default("DRAFT")
  priority      String    @default("NORMAL") // LOW | NORMAL | HIGH | URGENT
  /// Date the branch needs the goods by. Advisory — nothing expires on it.
  needed_by     DateTime?
  notes         String?

  /// User ids, not relations: the rest of this schema records actors the same
  /// way (see `WarehouseTransfer.approved_by`) and a deleted user must not take
  /// the demand history with them.
  requested_by    String?
  submitted_at    DateTime?
  reviewed_by     String?
  reviewed_at     DateTime?
  review_note     String?
  fulfilled_at    DateTime?
  fulfilled_by    String?
  /// How it was met — "TRF-00012", "PO raised with Rahim Traders", anything.
  fulfilment_note String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant    Tenant              @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  store     Store?              @relation(fields: [store_id], references: [id])
  warehouse Warehouse           @relation(fields: [warehouse_id], references: [id])
  items     ProductDemandItem[]

  @@unique([tenant_id, demand_number])
  @@index([tenant_id, status, created_at])
  @@index([tenant_id, warehouse_id])
  @@index([tenant_id, requested_by])
}

model ProductDemandItem {
  id                 String  @id @default(uuid())
  demand_id          String
  product_id         String
  quantity_requested Int
  /// Null until the demand is reviewed. Zero is a meaningful answer — the line
  /// was declined while the rest of the demand went through — so this stays
  /// nullable rather than defaulting to 0.
  quantity_approved  Int?
  note               String?

  demand  ProductDemand @relation(fields: [demand_id], references: [id], onDelete: Cascade)
  product Product       @relation(fields: [product_id], references: [id])

  @@unique([demand_id, product_id])
}

model Supplier {
  id          String    @id @default(uuid())
  tenant_id   String
  name        String
  phone       String?
  email       String?
  address     String?
  due_balance Decimal   @default(0) @db.Decimal(12, 2)

  /// Set on a supplier bought from under an LC. Drives whether the import
  /// fields below are asked for, and nothing else — a foreign supplier is
  /// billed, paid and reported exactly like a local one.
  is_foreign          Boolean @default(false)
  country             String?
  /// The currency this supplier invoices in. A default for new shipments, not a
  /// constraint: one supplier can invoice in USD and EUR.
  currency            String?
  bank_name           String?
  swift_code          String?
  beneficiary_name    String?
  beneficiary_account String?

  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?

  tenant             Tenant                      @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  purchases          Purchase[]
  purchaseReturns    PurchaseReturn[]
  purchaseOrders     PurchaseOrder[]
  purchaseQuotations PurchaseQuotation[]
  creditTransactions SupplierCreditTransaction[]
  importShipments    ImportShipment[]

  @@unique([tenant_id, name])
  @@index([tenant_id, is_foreign])
}

model SupplierCreditTransaction {
  id             String   @id @default(uuid())
  tenant_id      String
  supplier_id    String
  type           String // CREDIT_PURCHASE | PAYMENT | PAYOUT | ADJUSTMENT
  amount         Decimal  @db.Decimal(12, 2)
  balance_after  Decimal  @db.Decimal(12, 2)
  reference_type String?
  reference_id   String?
  payment_number String?
  notes          String?
  created_by     String?
  created_at     DateTime @default(now())

  tenant      Tenant                      @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  supplier    Supplier                    @relation(fields: [supplier_id], references: [id], onDelete: Cascade)
  creator     User?                       @relation("SupplierCreditTransactionCreator", fields: [created_by], references: [id])
  allocations SupplierPaymentAllocation[]

  @@unique([tenant_id, payment_number])
  @@index([tenant_id, supplier_id])
  @@index([tenant_id, created_at])
}

// Matches a supplier PAYMENT transaction (in full or in part) to a specific
// Purchase bill, so advances and part-payments taken before/without a bill
// can be applied to the correct bill(s) later instead of only moving a
// tenant-wide running balance.
model SupplierPaymentAllocation {
  id             String   @id @default(uuid())
  tenant_id      String
  transaction_id String
  purchase_id    String
  amount         Decimal  @db.Decimal(12, 2)
  created_at     DateTime @default(now())

  tenant      Tenant                    @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  transaction SupplierCreditTransaction @relation(fields: [transaction_id], references: [id], onDelete: Cascade)
  purchase    Purchase                  @relation(fields: [purchase_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, purchase_id])
  @@index([tenant_id, transaction_id])
}

model Purchase {
  id               String   @id @default(uuid())
  tenant_id        String
  store_id         String
  supplier_id      String?
  purchase_number  String
  /// The supplier's or source system's own document number. Not unique: an
  /// imported reference can legitimately repeat, and two suppliers can reuse
  /// the same bill number.
  reference_number String?
  subtotal_amount  Decimal  @default(0) @db.Decimal(12, 2)
  tax_amount       Decimal  @default(0) @db.Decimal(12, 2)
  discount_amount  Decimal  @default(0) @db.Decimal(12, 2)
  freight_amount   Decimal  @default(0) @db.Decimal(12, 2)
  total_amount     Decimal  @default(0) @db.Decimal(12, 2)
  paid_amount      Decimal  @default(0) @db.Decimal(12, 2)
  payment_status   String   @default("UNPAID") // UNPAID | PARTIAL | PAID
  notes            String?
  created_by       String?
  created_at       DateTime @default(now())

  tenant             Tenant                      @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  store              Store                       @relation(fields: [store_id], references: [id])
  supplier           Supplier?                   @relation(fields: [supplier_id], references: [id])
  items              PurchaseItem[]
  returns            PurchaseReturn[]
  paymentAllocations SupplierPaymentAllocation[]
  importShipment     ImportShipment?

  @@unique([tenant_id, purchase_number])
  @@index([tenant_id, created_at])
  @@index([tenant_id, store_id])
  @@index([tenant_id, payment_status])
  @@index([tenant_id, reference_number])
}

model PurchaseItem {
  id          String  @id @default(uuid())
  purchase_id String
  product_id  String
  quantity    Int
  unit_cost   Decimal @db.Decimal(12, 2)
  line_total  Decimal @db.Decimal(12, 2)

  purchase    Purchase             @relation(fields: [purchase_id], references: [id], onDelete: Cascade)
  product     Product              @relation(fields: [product_id], references: [id])
  returnItems PurchaseReturnItem[]
  jobCosts    ProductionJobCost[]
}

model PurchaseReturn {
  id               String   @id @default(uuid())
  tenant_id        String
  store_id         String
  /// Optional, mirroring SalesReturn.sale_id — validated when supplied.
  purchase_id      String?
