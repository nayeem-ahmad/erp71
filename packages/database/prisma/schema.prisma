datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/.prisma/client"
}

enum UserRole {
  OWNER
  MANAGER
  CASHIER
  ACCOUNTANT
}

enum ReferralCommissionStatus {
  PENDING
  EARNED
  PAID
  // Set when the tenant's payment was refunded or charged back. Terminal: the
  // referral does not return to PENDING, because the discount it granted was
  // already consumed and re-earning it would pay the commission twice.
  REVERSED
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  TRIALING
}

enum SubscriptionPlanCode {
  FREE
  BASIC
  ACCOUNTING
  STANDARD
  PREMIUM
}

enum CustomerType {
  INDIVIDUAL
  ORGANIZATION
}

enum PriceListDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  LOST
  CONVERTED
}

enum LeadSource {
  WALK_IN
  PHONE
  FACEBOOK
  REFERRAL
  WEBSITE
