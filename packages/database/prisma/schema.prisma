// ── Loans ───────────────────────────────────────────────────────────────────

model Loan {
  id            String        @id @default(uuid())
  tenant_id     String
  store_id      String?
  // Who the loan is with: the lender (for PAYABLE) or the borrower (for RECEIVABLE).
  counterparty  String
  // PAYABLE  = money the business borrowed (a liability)
  // RECEIVABLE = money the business lent out (an asset)
  direction     String        @default("PAYABLE")
  principal     Decimal       @db.Decimal(14, 2)
  // Optional annual interest rate (%), informational only.
  interest_rate Decimal?      @db.Decimal(5, 2)
  start_date    DateTime      @db.Date
  due_date      DateTime?     @db.Date
  // ACTIVE | CLOSED
  status        String        @default("ACTIVE")
  reference     String?
  notes         String?
  created_by    String?
  created_at    DateTime      @default(now())
  updated_at    DateTime      @updatedAt
  tenant        Tenant        @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  store         Store?        @relation(fields: [store_id], references: [id])
  payments      LoanPayment[]

  @@index([tenant_id, status])
  @@index([tenant_id, direction])
}

model LoanPayment {
  id             String   @id @default(uuid())
  tenant_id      String
  loan_id        String
  amount         Decimal  @db.Decimal(14, 2)
  payment_date   DateTime @db.Date
  payment_method String   @default("CASH")
  notes          String?
  created_by     String?
  created_at     DateTime @default(now())
  tenant         Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  loan           Loan     @relation(fields: [loan_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, loan_id])
  @@index([tenant_id, payment_date])
}

// ── Investors & Profit Sharing ──────────────────────────────────────────────
//
// An investor puts capital into the business and takes an agreed percentage of
// each month's profit. That is EQUITY, not debt — which is why this is a
// separate module from Loan rather than a flavour of it:
//
//   capital in      Dr Cash                          / Cr Investor Capital (equity)
//   monthly share   Dr Investor Profit Distribution  / Cr Investor Profit Payable
//   payout          Dr Investor Profit Payable       / Cr Cash
//
// The accrual deliberately hits an equity-contra account rather than an expense.
// If the share were an expense it would land inside net profit — so re-running a
// month's calculation would read a profit figure its own previous run had already
// reduced, and the number would drift downward on every recompute. Keeping it in
// equity makes the profit basis stable no matter how many times a run is redone.

model Investor {
  id                 String    @id @default(uuid())
  tenant_id          String
  // Set when the investor backs one branch rather than the whole company. The
  // monthly run then computes profit scoped to that store's vouchers.
  store_id           String?
  name               String
  phone              String?
  email              String?
  national_id        String?
  /// Agreed share of monthly profit, in percent. The sum across ACTIVE
  /// investors is validated to stay <= 100.
  profit_share_pct   Decimal   @db.Decimal(5, 2)
  // ACTIVE | EXITED
  status             String    @default("ACTIVE")
  joined_on          DateTime  @db.Date
  exited_on          DateTime? @db.Date
  /// Unrecovered losses carried forward, as a positive number. A loss month
  /// accrues nothing and adds the investor's share of the loss here; later
  /// profitable months pay down this balance before any cash share is accrued.
  /// Investors are never billed for a loss.
  loss_carry_forward Decimal   @default(0) @db.Decimal(14, 2)
  notes              String?
  created_by         String?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  tenant       Tenant                @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  store        Store?                @relation(fields: [store_id], references: [id])
  capitalTxns  InvestorCapitalTxn[]
  profitShares InvestorProfitShare[]

  @@index([tenant_id, status])
  @@index([tenant_id, store_id])
}

model InvestorCapitalTxn {
  id             String   @id @default(uuid())
  tenant_id      String
  investor_id    String
  // CONTRIBUTION = capital in, WITHDRAWAL = capital returned to the investor.
  // Neither is a profit payout — those live on InvestorProfitShare.
  direction      String   @default("CONTRIBUTION")
  amount         Decimal  @db.Decimal(14, 2)
  txn_date       DateTime @db.Date
  payment_method String   @default("CASH")
  reference      String?
  notes          String?
  created_by     String?
  created_at     DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  investor Investor @relation(fields: [investor_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, investor_id])
  @@index([tenant_id, txn_date])
}

model InvestorProfitRun {
  id                  String    @id @default(uuid())
  tenant_id           String
  store_id            String?
  /// store_id, or the literal 'COMPANY' for a company-wide run — the non-null
  /// half of the uniqueness key below. A nullable store_id cannot carry it:
  /// Postgres treats NULLs as distinct in a unique index, so two company-wide
  /// runs for the same month would both be accepted and the month would accrue
  /// twice. Always written as `storeId ?? 'COMPANY'`.
  scope_key           String    @default("COMPANY")
  year                Int
  month               Int
  /// Net profit for the month AS READ AT RUN TIME. Snapshotted rather than
  /// recomputed on display, so a voucher back-dated into a closed month cannot
  /// silently rewrite shares that have already been accrued or paid out.
  profit_basis_amount Decimal   @db.Decimal(14, 2)
  // NET_PROFIT (revenue - expenses). Room for GROSS_PROFIT later.
  basis_type          String    @default("NET_PROFIT")
  // DRAFT | POSTED
  status              String    @default("DRAFT")
  posted_at           DateTime?
  notes               String?
  created_by          String?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  tenant Tenant                @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  store  Store?                @relation(fields: [store_id], references: [id])
  shares InvestorProfitShare[]

  // One run per tenant per month per scope — this is what makes "run July
  // again" safe rather than double-accruing.
  @@unique([tenant_id, year, month, scope_key])
  @@index([tenant_id, status])
}

model InvestorProfitShare {
  id                 String   @id @default(uuid())
  tenant_id          String
  run_id             String
  investor_id        String
  /// The percentage as it stood when the run posted. Snapshotted so changing an
  /// investor's agreed share later does not rewrite settled history.
  share_pct_snapshot Decimal  @db.Decimal(5, 2)
  /// Cash share accrued this month. Zero on a loss month, or when the month's
  /// profit only offsets carried-forward losses.
  amount             Decimal  @db.Decimal(14, 2)
  /// Movement in the investor's loss carry-forward this run: positive when a
  /// loss month adds to it, negative when a profitable month pays it down.
  loss_applied       Decimal  @default(0) @db.Decimal(14, 2)
  // ACCRUED | PAID
  status             String   @default("ACCRUED")
  paid_amount        Decimal  @default(0) @db.Decimal(14, 2)
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  tenant   Tenant            @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  run      InvestorProfitRun @relation(fields: [run_id], references: [id], onDelete: Cascade)
  investor Investor          @relation(fields: [investor_id], references: [id], onDelete: Cascade)

  @@unique([run_id, investor_id])
  @@index([tenant_id, investor_id])
  @@index([tenant_id, status])
}

// ── Salary Payments ─────────────────────────────────────────────────────────

model SalaryPayment {
  id             String   @id @default(uuid())
  tenant_id      String
  employee_id    String
  amount         Decimal  @db.Decimal(12, 2)
  pay_period     String // 'YYYY-MM' — the month the salary is for
  payment_date   DateTime @db.Date
  payment_method String   @default("CASH")
  notes          String?
  created_by     String?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employee_id], references: [id])

  // No unique on (employee, period): a period can be settled in several
  // instalments (and advances), each a row that settles the accrued payable.
  // The payable balance, not a row count, is the source of truth now.
  @@index([tenant_id, employee_id, pay_period])
  @@index([tenant_id, payment_date])
  @@index([tenant_id, employee_id])
}

// The monthly accrual of an employee's salary as an expense + payable, distinct
// from SalaryPayment (the cash settlement). Mirrors AssetDepreciationEntry:
// one row per employee per period, carrying the voucher it posted. voucher_id
// gives autoPostFromRules a real source row to key idempotency on.
model SalaryAccrual {
  id          String   @id @default(uuid())
  tenant_id   String
  employee_id String
  pay_period  String // 'YYYY-MM' — the month this salary is for
  amount      Decimal  @db.Decimal(12, 2)
  voucher_id  String?
  created_by  String?
  created_at  DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employee_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, employee_id, pay_period])
  @@index([tenant_id, pay_period])
  @@index([tenant_id, employee_id])
}

// ── AI Usage Logging ──────────────────────────────────────────────────────────

model AiUsageLog {
  id                    String   @id @default(cuid())
  tenant_id             String
  feature               String // 'report_narration' | 'message_drafter' | etc.
  model                 String
  input_tokens          Int
  output_tokens         Int
  cache_read_tokens     Int      @default(0)
  cache_creation_tokens Int      @default(0)
  cost_usd              Float
  credits_used          Float // tokens / 1000
  created_at            DateTime @default(now())

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, created_at])
  @@index([tenant_id, feature, created_at])
}

/// A data-chatbot thread. Scoped to one user inside one tenant — threads are
/// private to their author, not shared across the tenant.
model AiConversation {
  id         String   @id @default(cuid())
  tenant_id  String
  user_id    String
  /// First user message, truncated. Set on the first turn, used as the list label.
  title      String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant   Tenant      @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  messages AiMessage[]

  @@index([tenant_id, user_id, updated_at])
}

model AiMessage {
  id              String   @id @default(cuid())
  conversation_id String
  role            String // 'user' | 'assistant'
  content         String   @db.Text
  /// Summary of the tools this turn ran: [{ name, args, rowCount, ms, error? }].
  /// Deliberately excludes tool result payloads — those are a second copy of
  /// tenant business data and are not needed for the UI or the audit trail.
  tool_calls_json Json?
  credits_used    Float    @default(0)
  created_at      DateTime @default(now())

  conversation AiConversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)

  @@index([conversation_id, created_at])
}

// ── Support Chat ──────────────────────────────────────────────────────────────

model SupportThread {
  id         String   @id @default(cuid())
  tenantId   String
  subject    String
  status     String   @default("open") // open | resolved
  /// support | bug | feature | general
  category   String   @default("support")
  page       String?
  feedbackId String?  @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  feedback Feedback?        @relation(fields: [feedbackId], references: [id], onDelete: SetNull)
  messages SupportMessage[]

  @@index([tenantId, status])
  @@index([tenantId, category])
  @@map("support_threads")
}

model SupportMessage {
  id         String   @id @default(cuid())
  threadId   String
  senderId   String
  senderRole String // "owner" | "admin"
  body       String
  createdAt  DateTime @default(now())

  thread SupportThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender User          @relation("SupportMessageSender", fields: [senderId], references: [id])

  @@index([threadId, createdAt])
  @@map("support_messages")
}

// ── Referral / Commission ─────────────────────────────────────────────────────

model Referee {
  id              String    @id @default(uuid())
  user_id         String?   @unique
  name            String
  email           String    @unique
  phone           String?
  referral_code   String    @unique
  commission_rate Decimal   @db.Decimal(5, 2) // % of plan payment owed to referee
  signup_discount Decimal   @db.Decimal(5, 2) // % discount given to referred client
  is_active       Boolean   @default(true)
  notes           String?
  created_by      String? // platform admin user id
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  deleted_at      DateTime? // set when archived (ledger history retained)

  user            User?            @relation(fields: [user_id], references: [id])
  referralSignups ReferralSignup[]
  payments        RefereePayment[]
  clicks          ReferralClick[]

  @@index([deleted_at])
}

model ReferralSignup {
  id                  String                   @id @default(uuid())
  referee_id          String
  tenant_id           String                   @unique
  discount_pct        Decimal                  @db.Decimal(5, 2)
  commission_pct      Decimal                  @db.Decimal(5, 2)
  /// Plan revenue actually collected from the client — list price less this
  /// referral's signup discount, add-ons excluded. This is the base the
  /// commission is a percentage of. Rows earned before 2026-08-04 hold the
  /// undiscounted list price instead; see the backfill note in TODO.md.
  plan_amount         Decimal?                 @db.Decimal(10, 2)
  commission_amount   Decimal?                 @db.Decimal(10, 2) // calculated when earned
  status              ReferralCommissionStatus @default(PENDING)
  signed_up_at        DateTime                 @default(now())
  earned_at           DateTime?
  paid_at             DateTime?
  reversed_at         DateTime? // set when the tenant's payment was refunded
  reversal_reason     String?
  /// True when the commission had already been paid out at the time of reversal.
  /// The money is gone, so it nets against the referee's next payout rather than
  /// simply vanishing from the ledger.
  reversed_after_paid Boolean                  @default(false)
  referee_payment_id  String?

  referee        Referee         @relation(fields: [referee_id], references: [id])
  tenant         Tenant          @relation(fields: [tenant_id], references: [id])
  refereePayment RefereePayment? @relation(fields: [referee_payment_id], references: [id])

  @@index([referee_id, status])
  @@index([status])
}

/// One recorded visit to a partner's tracking link (`/r/<code>`).
///
/// Deliberately holds no IP address and no cookie id — a partner's marketing
/// reach does not justify storing anything that identifies the visitor. `referrer`
/// and `user_agent` are kept because they are what makes the number interpretable
/// (bot traffic vs a real campaign), and both are truncated on write.
model ReferralClick {
  id          String   @id @default(uuid())
  referee_id  String
  /// Snapshot of the code as typed in the link, so a later code change does not
  /// retro-attribute old clicks.
  code        String
  referrer    String?
  user_agent  String?
  occurred_at DateTime @default(now())

  referee Referee @relation(fields: [referee_id], references: [id], onDelete: Cascade)

  @@index([referee_id, occurred_at])
}

model RefereePayment {
  id         String   @id @default(uuid())
  referee_id String
  amount     Decimal  @db.Decimal(10, 2)
  method     String?
  reference  String?
  notes      String?
  paid_at    DateTime @default(now())
  created_by String?
  created_at DateTime @default(now())

  referee     Referee          @relation(fields: [referee_id], references: [id])
  commissions ReferralSignup[]

  @@index([referee_id])
}

// ---------------------------------------------------------------------------
// Project management (Phase 1)
// Scope: docs/projects/project-management-phase-1.md
// ---------------------------------------------------------------------------

enum ProjectStatus {
  DRAFT
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum ProjectPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ProjectMemberRole {
  MANAGER
  MEMBER
  VIEWER
}

/// Who can reach a project at all. PUBLIC is every user in the tenant who holds
/// VIEW_PROJECTS; PRIVATE is its members, its manager, the workspace OWNER, and
/// anyone granted VIEW_ALL_PROJECTS. Visibility gates the project *and*
/// everything hanging off it — tasks, hours, comments, board cards.
enum ProjectVisibility {
  PUBLIC
  PRIVATE
}

/// What a board column means, independent of what the tenant named it. Burndown
/// and percent-complete both need to know which columns count as finished, and
/// must not depend on a column literally being called "Done".
enum ProjectTaskStatusCategory {
  TODO
  IN_PROGRESS
  DONE
}

enum SprintStatus {
  PLANNED
  ACTIVE
  COMPLETED
}

/// Why a task's remaining hours changed. Burning down through logged work and
/// burning up through re-estimation are opposite events; a bare value cannot
/// tell them apart, and that distinction is the whole scope-creep signal.
enum RemainingHoursSource {
  TASK_CREATED
  TIME_LOGGED
  RE_ESTIMATED
  TASK_COMPLETED
  TASK_REOPENED
  TIME_ENTRY_DELETED
}

model Project {
  id              String          @id @default(uuid())
  tenant_id       String
  store_id        String?
  code            String
  name            String
  /// Abbreviation for cramped surfaces — board cards, chips. Falls back to `code` when unset.
  short_name      String?
  description     String?
  customer_id     String?
  lead_id         String?
  project_type_id String?
  status          ProjectStatus   @default(DRAFT)
  priority        ProjectPriority @default(MEDIUM)
  /// PUBLIC by default: the overwhelming majority of a shop's jobs are meant to
  /// be seen by the whole workspace, and defaulting the other way would hide
  /// every project that existed before this column did.
  visibility      ProjectVisibility @default(PUBLIC)
  manager_id      String?
  start_date      DateTime?       @db.Date
  target_end_date DateTime?       @db.Date
  actual_end_date DateTime?       @db.Date
  /// Plain number in Phase 1 — nothing rolls up into it until costing lands.
  budget_amount   Decimal?        @db.Decimal(14, 2)
  created_by      String?
  created_at      DateTime        @default(now())
  updated_at      DateTime        @updatedAt
  deleted_at      DateTime?

  tenant      Tenant       @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  store       Store?       @relation(fields: [store_id], references: [id])
  customer    Customer?    @relation(fields: [customer_id], references: [id])
  lead        Lead?        @relation(fields: [lead_id], references: [id])
  projectType ProjectType? @relation(fields: [project_type_id], references: [id])
  manager     User?        @relation("ProjectManager", fields: [manager_id], references: [id])
  creator     User?        @relation("ProjectCreator", fields: [created_by], references: [id])

  members        ProjectMember[]
  milestones     ProjectMilestone[]
  tasks          ProjectTask[]
  timeEntries    ProjectTimeEntry[]
  comments       ProjectComment[]
  attachments    ProjectAttachment[]
  remainingLogs  ProjectTaskRemainingLog[]
  taskActivities ProjectTaskActivity[]
  taskStatuses   ProjectTaskStatus[]

  @@unique([tenant_id, code])
  @@index([tenant_id, status, deleted_at])
  @@index([tenant_id, visibility, deleted_at])
  @@index([tenant_id, customer_id])
  @@index([tenant_id, manager_id])
  @@map("projects")
}

model ProjectType {
  id         String   @id @default(uuid())
  tenant_id  String
  name       String
  is_active  Boolean  @default(true)
  sort_order Int      @default(0)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  projects Project[]

  @@unique([tenant_id, name])
  @@index([tenant_id, is_active])
  @@map("project_types")
}

/// A person on a project. EXACTLY ONE of user_id / employee_id is set — Prisma
/// cannot express that, so ProjectsService enforces it. An employee with no
/// login is a real staffing fact worth recording, which is why both exist;
/// ProjectTimeEntry already carries the same pair for the same reason.
model ProjectMember {
  id          String            @id @default(uuid())
  tenant_id   String
  project_id  String
  user_id     String?
  employee_id String?
  role        ProjectMemberRole @default(MEMBER)
  created_at  DateTime          @default(now())

  tenant   Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  project  Project   @relation(fields: [project_id], references: [id], onDelete: Cascade)
  user     User?     @relation("ProjectMemberUser", fields: [user_id], references: [id], onDelete: Cascade)
  employee Employee? @relation("ProjectMemberEmployee", fields: [employee_id], references: [id], onDelete: Cascade)

  @@unique([project_id, user_id])
  @@unique([project_id, employee_id])
  @@index([tenant_id, user_id])
  @@index([tenant_id, employee_id])
  @@map("project_members")
}

model ProjectMilestone {
  id           String    @id @default(uuid())
  tenant_id    String
  project_id   String
  name         String
  target_date  DateTime? @db.Date
  completed_at DateTime?
  sort_order   Int       @default(0)
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  tenant  Tenant        @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  project Project       @relation(fields: [project_id], references: [id], onDelete: Cascade)
  tasks   ProjectTask[]

  @@index([tenant_id, project_id])
  @@map("project_milestones")
}

/// Tenant-managed board columns. Ordering here is the ordering on the board.
/// Board columns. A Trello list belongs to one board, so as of Phase 3L these
/// belong to one project.
///
/// `project_id` NULL marks a **template** row: the tenant's default column set,
/// managed in Project Setup and copied onto every new project. Non-null rows are
/// what a board actually renders, and what a task's `status_id` points at.
///
/// `category` stays mandatory on every row — Phase 2's tenant-level sprints and
/// the cross-project Tasks page filter on what a column *means*, never on a
/// column id, so per-project columns are only safe while every one of them
/// carries a TODO/IN_PROGRESS/DONE.
model ProjectTaskStatus {
  id         String                    @id @default(uuid())
  tenant_id  String
  project_id String?
  name       String
  category   ProjectTaskStatusCategory @default(TODO)
  sort_order Int                       @default(0)
  is_active  Boolean                   @default(true)
  is_default Boolean                   @default(false)
  /// Cards allowed in this column at once. NULL means no limit. Advisory — the
  /// board marks the column over-limit, it does not refuse the drop, because a
  /// WIP limit is a prompt to talk about the queue and not a lock.
  wip_limit  Int?
  created_at DateTime                  @default(now())
  updated_at DateTime                  @updatedAt

  tenant  Tenant        @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  project Project?      @relation(fields: [project_id], references: [id], onDelete: Cascade)
  tasks   ProjectTask[]

  boardBindings BoardColumnStatus[]

  /// Postgres treats NULLs as distinct, so this does not constrain template
  /// rows. `ProjectSettingsService` checks those for a name clash instead.
  @@unique([tenant_id, project_id, name])
  @@index([tenant_id, project_id, sort_order])
  @@index([tenant_id, is_active, sort_order])
  @@map("project_task_statuses")
}

model ProjectTask {
  id                   String             @id @default(uuid())
  tenant_id            String
  project_id           String
  milestone_id         String?
  sprint_id            String?
  parent_task_id       String?
  title                String
  description          String?
  status_id            String
  priority             ProjectPriority    @default(MEDIUM)
  /// Assignment mirrors ProjectMember: a task goes to a User OR to an Employee
  /// who has no login. At most one is set. Everything that reports on "who is
  /// this for" must read both — see assigneeOf() in project-tasks.service.ts.
  assignee_id          String?
  assignee_employee_id String?
  /// Paired with due_date so a card can say when work opens as well as when it
  /// closes. Nothing derives from it — a task with a future start is not
  /// blocked, it is simply not due yet.
  start_date           DateTime?          @db.Date
  due_date             DateTime?          @db.Date
  /// Reuses the label palette rather than adding a near-identical enum: the same
  /// six colours, and a card whose cover matches a label it carries is a feature
  /// rather than a coincidence.
  cover_color          ProjectLabelColor?
  estimate_hours       Decimal?           @db.Decimal(8, 2)
  /// An independent re-estimate, never derived from estimate minus logged.
  /// Written only by RemainingHoursService, always alongside a log row.
  remaining_hours      Decimal?           @db.Decimal(8, 2)
  sort_order           Int                @default(0)
  completed_at         DateTime?
  created_by           String?
  created_at           DateTime           @default(now())
  updated_at           DateTime           @updatedAt
  deleted_at           DateTime?

  tenant           Tenant            @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  project          Project           @relation(fields: [project_id], references: [id], onDelete: Cascade)
  milestone        ProjectMilestone? @relation(fields: [milestone_id], references: [id])
  sprint           Sprint?           @relation(fields: [sprint_id], references: [id])
  parentTask       ProjectTask?      @relation("ProjectTaskSubtask", fields: [parent_task_id], references: [id])
  subtasks         ProjectTask[]     @relation("ProjectTaskSubtask")
  status           ProjectTaskStatus @relation(fields: [status_id], references: [id])
  assignee         User?             @relation("ProjectTaskAssignee", fields: [assignee_id], references: [id])
  assigneeEmployee Employee?         @relation("ProjectTaskAssigneeEmployee", fields: [assignee_employee_id], references: [id])
  creator          User?             @relation("ProjectTaskCreator", fields: [created_by], references: [id])

  checklistItems ProjectTaskChecklistItem[]
  labels         ProjectTaskLabel[]
  activities     ProjectTaskActivity[]
  watchers       ProjectTaskWatcher[]
  timeEntries    ProjectTimeEntry[]
  remainingLogs  ProjectTaskRemainingLog[]
  comments       ProjectComment[]
  attachments    ProjectAttachment[]
  boardCards     BoardTask[]

  @@index([tenant_id, project_id, deleted_at])
  @@index([tenant_id, sprint_id])
  @@index([tenant_id, assignee_id])
  @@index([tenant_id, assignee_employee_id])
  @@index([project_id, status_id, sort_order])
  @@map("project_tasks")
}

/// The history of every change to a task's remaining hours.
///
/// `sprint_id` is denormalised at write time on purpose: moving a task to
/// another sprint later must not rewrite where its hours actually burned.
/// `delta` is redundant against previous/new and stored anyway so a burndown
/// query is a SUM over a date range rather than a window function over rows.
/// Rows are immutable and survive task soft-delete.
model ProjectTaskRemainingLog {
  id             String               @id @default(uuid())
  tenant_id      String
  task_id        String
  project_id     String
  sprint_id      String?
  previous_hours Decimal?             @db.Decimal(8, 2)
  new_hours      Decimal              @db.Decimal(8, 2)
  delta          Decimal              @db.Decimal(8, 2)
  source         RemainingHoursSource
  time_entry_id  String?
  note           String?
  changed_by     String?
  changed_at     DateTime             @default(now())

  tenant  Tenant      @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  task    ProjectTask @relation(fields: [task_id], references: [id], onDelete: Cascade)
  project Project     @relation(fields: [project_id], references: [id], onDelete: Cascade)
  sprint  Sprint?     @relation(fields: [sprint_id], references: [id])
  user    User?       @relation("RemainingLogUser", fields: [changed_by], references: [id])

  @@index([tenant_id, sprint_id, changed_at])
  @@index([task_id, changed_at])
  @@map("project_task_remaining_logs")
}

/// No COMMENTED member on purpose: comments are their own rows and the panel
/// merges the two streams by timestamp, so recording an activity row per comment
/// would draw every comment twice.
enum ProjectTaskActivityType {
  CREATED
  RENAMED
  STATUS_CHANGED
  ASSIGNED
  PRIORITY_CHANGED
  DATES_CHANGED
  LABELS_CHANGED
  RE_ESTIMATED
}

/// Append-only. Rows are never updated or deleted, and survive task soft-delete
/// — "who moved this and when" is the question the feed exists to answer.
///
/// `data` holds the before/after payload rather than a rendered sentence, so the
/// line is composed client-side and therefore translates. A stored English
/// string would be permanently English in a trilingual app.
model ProjectTaskActivity {
  id         String                  @id @default(uuid())
  tenant_id  String
  task_id    String
  project_id String
  type       ProjectTaskActivityType
  data       Json?
  actor_id   String?
  created_at DateTime                @default(now())

  tenant  Tenant      @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  task    ProjectTask @relation(fields: [task_id], references: [id], onDelete: Cascade)
  project Project     @relation(fields: [project_id], references: [id], onDelete: Cascade)
  actor   User?       @relation("ProjectTaskActivityActor", fields: [actor_id], references: [id])

  @@index([task_id, created_at])
  @@index([tenant_id, project_id, created_at])
  @@map("project_task_activities")
}

/// A wall of hand-picked cards. Unlike a project, a board has no work of its
/// own — every card on it is a ProjectTask that still belongs to its project.
model Board {
  id          String    @id @default(uuid())
  tenant_id   String
  name        String
  description String?
  created_by  String?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?

  tenant  Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  creator User?  @relation("BoardCreator", fields: [created_by], references: [id])

  columns BoardColumn[]
  cards   BoardTask[]

  /// Names are deliberately not unique: a unique (tenant_id, name) would let a
  /// soft-deleted board hold its name hostage against a new one.
  @@index([tenant_id, deleted_at])
  @@map("boards")
}

model BoardColumn {
  id         String                    @id @default(uuid())
  tenant_id  String
  board_id   String
  name       String
  category   ProjectTaskStatusCategory @default(TODO)
  sort_order Int                       @default(0)
  /// Advisory, exactly like ProjectTaskStatus.wip_limit: the board marks a
  /// column over-limit, it does not refuse the drop.
  wip_limit  Int?
  created_at DateTime                  @default(now())
  updated_at DateTime                  @updatedAt

  tenant   Tenant              @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  board    Board               @relation(fields: [board_id], references: [id], onDelete: Cascade)
  bindings BoardColumnStatus[]

  @@unique([board_id, name])
  @@index([board_id, sort_order])
  @@map("board_columns")
}

/// Binds one project status to one column of one board.
model BoardColumnStatus {
  id              String @id @default(uuid())
  tenant_id       String
  board_id        String
  board_column_id String
  status_id       String

  tenant Tenant            @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  column BoardColumn       @relation(fields: [board_column_id], references: [id], onDelete: Cascade)
  status ProjectTaskStatus @relation(fields: [status_id], references: [id], onDelete: Cascade)

  /// `board_id` is denormalised for exactly this constraint. It guarantees a
  /// status resolves to at most one column, which is what stops a card
  /// appearing twice on the same board. Deriving it through board_column_id
  /// would lose that.
  @@unique([board_id, status_id])
  @@index([board_column_id])
  @@map("board_column_statuses")
}

/// Explicit membership. Nothing joins a board by rule.
model BoardTask {
  id         String   @id @default(uuid())
  tenant_id  String
  board_id   String
  task_id    String
  sort_order Int      @default(0)
  added_by   String?
  added_at   DateTime @default(now())

  tenant Tenant      @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  board  Board       @relation(fields: [board_id], references: [id], onDelete: Cascade)
  task   ProjectTask @relation(fields: [task_id], references: [id], onDelete: Cascade)
  adder  User?       @relation("BoardTaskAdder", fields: [added_by], references: [id])

  @@unique([board_id, task_id])
  @@index([board_id, sort_order])
  @@map("board_tasks")
}

/// Who hears about a task. Employees without a login are deliberately absent:
/// a watcher exists to be notified, and notifications go to a User.
model ProjectTaskWatcher {
  tenant_id  String
  task_id    String
  user_id    String
  created_at DateTime @default(now())

  tenant Tenant      @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  task   ProjectTask @relation(fields: [task_id], references: [id], onDelete: Cascade)
  user   User        @relation("ProjectTaskWatcherUser", fields: [user_id], references: [id], onDelete: Cascade)

  @@id([task_id, user_id])
  @@index([tenant_id, user_id])
  @@map("project_task_watchers")
}

/// Colour is an enum, not a hex string: the UI rules forbid arbitrary hex, and a
/// free colour field is how a board ends up with twelve indistinguishable greys.
/// The renderer maps each value to a fixed Tailwind pair.
enum ProjectLabelColor {
  GRAY
  BLUE
  EMERALD
  AMBER
  RED
  PURPLE
}

/// Tenant-scoped rather than per-project, deliberately: a label is a vocabulary
/// ("Blocked", "Client waiting") and the cross-project Tasks page and sprint
/// board are only useful if that vocabulary is shared. Per-board labels would
/// fragment it the same way per-project statuses would. Adding `project_id`
/// later is additive if boards ever need private labels.
model ProjectLabel {
  id         String            @id @default(uuid())
  tenant_id  String
  name       String
  color      ProjectLabelColor @default(GRAY)
  sort_order Int               @default(0)
  created_at DateTime          @default(now())
  updated_at DateTime          @updatedAt

  tenant Tenant             @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  tasks  ProjectTaskLabel[]

  @@unique([tenant_id, name])
  @@index([tenant_id, sort_order])
  @@map("project_labels")
}

model ProjectTaskLabel {
  tenant_id  String
  task_id    String
  label_id   String
  created_at DateTime @default(now())

  tenant Tenant       @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  task   ProjectTask  @relation(fields: [task_id], references: [id], onDelete: Cascade)
  label  ProjectLabel @relation(fields: [label_id], references: [id], onDelete: Cascade)

  @@id([task_id, label_id])
  @@index([tenant_id, label_id])
  @@map("project_task_labels")
}

model ProjectTaskChecklistItem {
  id         String   @id @default(uuid())
  tenant_id  String
  task_id    String
  text       String
  is_done    Boolean  @default(false)
  sort_order Int      @default(0)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant Tenant      @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  task   ProjectTask @relation(fields: [task_id], references: [id], onDelete: Cascade)

  @@index([task_id, sort_order])
  @@map("project_task_checklist_items")
}

model ProjectTimeEntry {
  id          String   @id @default(uuid())
  tenant_id   String
  task_id     String
  /// Denormalised for per-project reporting without joining through tasks.
  project_id  String
  user_id     String?
  /// Unused in Phase 1 — the hook Phase 2 needs to cost hours against payroll.
  employee_id String?
  work_date   DateTime @db.Date
  hours       Decimal  @db.Decimal(8, 2)
  note        String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  tenant   Tenant      @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  task     ProjectTask @relation(fields: [task_id], references: [id], onDelete: Cascade)
  project  Project     @relation(fields: [project_id], references: [id], onDelete: Cascade)
  user     User?       @relation("ProjectTimeEntryUser", fields: [user_id], references: [id])
  employee Employee?   @relation(fields: [employee_id], references: [id])

  @@index([tenant_id, project_id, work_date])
  @@index([task_id, work_date])
  @@map("project_time_entries")
}

/// Tenant-level time-box. Deliberately NOT scoped to a project: one sprint
/// takes tasks from any number of projects, so the only ownership is the tenant.
/// At most one sprint per tenant may be ACTIVE (enforced in SprintsService).
model Sprint {
  id         String       @id @default(uuid())
  tenant_id  String
  name       String
  goal       String?
  start_date DateTime     @db.Date
  end_date   DateTime     @db.Date
  status     SprintStatus @default(PLANNED)
  created_at DateTime     @default(now())
  updated_at DateTime     @updatedAt

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  tasks         ProjectTask[]
  snapshots     SprintSnapshot[]
  remainingLogs ProjectTaskRemainingLog[]

  @@index([tenant_id, status])
  @@map("sprints")
}

/// One burndown point per sprint per day. A cache, not the source of truth —
/// derivable from ProjectTaskRemainingLog, so a missed cron night can be
/// rebuilt instead of leaving a permanent hole in the chart.
model SprintSnapshot {
  id              String   @id @default(uuid())
  tenant_id       String
  sprint_id       String
  snapshot_date   DateTime @db.Date
  remaining_hours Decimal  @db.Decimal(10, 2)
  committed_hours Decimal  @db.Decimal(10, 2)
  completed_hours Decimal  @db.Decimal(10, 2)
  task_count      Int
  done_task_count Int
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  sprint Sprint @relation(fields: [sprint_id], references: [id], onDelete: Cascade)

  @@unique([sprint_id, snapshot_date])
  @@index([tenant_id, sprint_id, snapshot_date])
  @@map("sprint_snapshots")
}

model ProjectComment {
  id         String   @id @default(uuid())
  tenant_id  String
  project_id String?
  task_id    String?
  user_id    String?
  body       String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant  Tenant       @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  project Project?     @relation(fields: [project_id], references: [id], onDelete: Cascade)
  task    ProjectTask? @relation(fields: [task_id], references: [id], onDelete: Cascade)
  user    User?        @relation("ProjectCommentUser", fields: [user_id], references: [id])

  @@index([tenant_id, project_id, created_at])
  @@index([tenant_id, task_id, created_at])
  @@map("project_comments")
}

model ProjectAttachment {
  id          String   @id @default(uuid())
  tenant_id   String
  project_id  String?
  task_id     String?
  file_url    String
  file_name   String
  mime_type   String?
  file_size   Int?
  /// Cloudinary's handle for the stored asset. `file_url` cannot be turned back
  /// into one, so without this the row could be deleted while the file stayed —
  /// billed forever. Nullable only because rows predating Phase 3D have none.
  storage_key String?
  created_by  String?
  created_at  DateTime @default(now())

  tenant  Tenant       @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  project Project?     @relation(fields: [project_id], references: [id], onDelete: Cascade)
  task    ProjectTask? @relation(fields: [task_id], references: [id], onDelete: Cascade)
  creator User?        @relation("ProjectAttachmentCreator", fields: [created_by], references: [id])

  @@index([tenant_id, project_id])
  @@index([tenant_id, task_id])
  @@map("project_attachments")
}

enum ShortLinkKind {
  ENTITY
  MANUAL
}

enum ShortLinkEntity {
  QUOTATION
  /// Distinct from QUOTATION even though both resolve to a Quotation row and to
  /// the same /q/<token> page. "Did the buyer open the PI" is a materially
  /// different sales signal from "did they open a quote", and ShortLinkClick
  /// already captures everything needed to answer it — it just cannot separate
  /// the two without this value.
  PROFORMA_INVOICE
  STOREFRONT_PRODUCT
}

/// A code-to-URL alias. For entity links the token in `target_url` is the real
/// authority; this row is only an alias, which is why revoking a quotation's
/// token kills every link to it without touching this table.
model ShortLink {
  id            String           @id @default(uuid())
  /// Null for links minted by platform staff, who sit outside any tenant.
  tenant_id     String?
  code          String           @unique
  /// Internal path or absolute http(s) URL. Always validated by isSafeTarget().
  target_url    String
  /// Human label for the shortener list. Manual links only.
  label         String?
  kind          ShortLinkKind
  entity_type   ShortLinkEntity?
  entity_id     String?
  click_count   Int              @default(0)
  last_click_at DateTime?
  created_by    String?
  created_at    DateTime         @default(now())
  revoked_at    DateTime?

  tenant Tenant? @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  clicks ShortLinkClick[]

  @@index([tenant_id, created_at])
  @@index([entity_type, entity_id])
}

/// One recorded click on a short link (`/s/<code>`), kept as the raw material for
/// link analytics: `ShortLink.click_count` answers "how many", this answers
/// "who, from where, on what".
///
/// Everything here is captured at redirect time and stored rather than
/// aggregated, because the questions worth asking later (which campaign, which
/// channel, which country, mobile vs desktop) cannot be reconstructed from a
/// counter. Columns are deliberately wide and denormalised for the same reason:
/// `referrer_host`, `channel`, `browser`/`os`/`device_type` and the utm_* fields
/// are all derived from `referrer`/`user_agent`/`query` on write, so a report can
/// GROUP BY them without re-parsing every row, while the raw values stay for
/// re-derivation when the parsing improves.
///
/// Trust boundary: `/s/<code>` is public and unauthenticated, so every value here
/// is ultimately visitor-supplied and none of it is evidence of anything. It is
/// analytics, not audit — do not use it for access decisions.
///
/// Unlike ReferralClick, this table *does* keep `ip_address`, because geo and
/// unique-visitor analysis are the point of it. That makes these rows personal
/// data: anything built on top should treat retention as a policy question, not
/// keep them forever by default.
model ShortLinkClick {
  id            String @id @default(uuid())
  short_link_id String
  /// Copied off the link so tenant-scoped reporting never needs the join, and so
  /// a click survives in aggregate form if the link row is ever reshaped.
  /// Null for platform-owned links, matching ShortLink.tenant_id.
  tenant_id     String?
  /// Snapshot of the code as requested, so a later code change does not
  /// retro-attribute old clicks.
  code          String

  occurred_at DateTime @default(now())

  /// Full `Referer` header, and just its host — the host is what almost every
  /// report groups by, and pulling it out of a 2KB URL per row is wasteful.
  referrer      String?
  referrer_host String?
  /// Coarse bucket derived from referrer + utm_medium:
  /// DIRECT | SEARCH | SOCIAL | EMAIL | INTERNAL | REFERRAL.
  channel       String?

  /// Campaign tags read off the `/s/<code>?utm_...` request itself, not the
  /// target. Shortened links are what get pasted into ads and WhatsApp, so this
  /// is where campaign attribution actually lands.
  utm_source   String?
  utm_medium   String?
  utm_campaign String?
  utm_term     String?
  utm_content  String?
  /// Raw query string as received, so a tag we do not parse today is not lost.
  query        String?

  user_agent  String?
  /// Parsed from user_agent on write. `device_type` is MOBILE | TABLET | DESKTOP | BOT.
  browser     String?
  os          String?
  device_type String?
  /// Known crawler/preview-fetcher. Kept rather than dropped: a WhatsApp or
  /// Facebook link preview is a real signal, it just is not a human visit.
  is_bot      Boolean @default(false)

  /// Left-most `X-Forwarded-For` entry as seen by the API. Spoofable — see the
  /// trust note above.
  ip_address String?
  /// Filled from a CDN/proxy geo header when one is present; null otherwise, so
  /// a later geo-IP backfill has somewhere to write.
  country    String?
  city       String?
  /// Primary tag of `Accept-Language`, e.g. `bn` or `en-GB`.
  language   String?

  short_link ShortLink @relation(fields: [short_link_id], references: [id], onDelete: Cascade)

  @@index([short_link_id, occurred_at])
  @@index([tenant_id, occurred_at])
  @@index([code, occurred_at])
}

// ---------------------------------------------------------------------------
// Platform blog — written by platform staff, read on erp71.com/blog and in-app.
//
// No `tenant_id` anywhere: these are platform rows, like PlatformSetting. Reads
// are guarded only by status/audience; writes only by PlatformAdminGuard.
// ---------------------------------------------------------------------------

model BlogPost {
  id   String @id @default(uuid())
  slug String @unique

  /// DRAFT | SCHEDULED | PUBLISHED | ARCHIVED
  status   String @default("DRAFT")
  /// PUBLIC | IN_APP | BOTH — which surfaces are allowed to serve this post.
  /// A release note is IN_APP; an SEO article is PUBLIC; most are BOTH.
  audience String @default("BOTH")

  category_id String?

  cover_image_url   String?
  /// Cloudinary's handle for the cover. A secure_url cannot be turned back into
  /// one, so without this the image is billed forever after the post is deleted.
  cover_storage_key String?
  cover_alt         String?

  author_user_id String?
  /// Byline as readers see it, denormalised on purpose: an author may leave the
  /// company, and the post should keep the name it was published under.
  author_name    String?
  author_title   String?

  published_at  DateTime?
  scheduled_for DateTime?
  /// Set by hand for a meaningful revision. Kept separate from `updated_at` so
  /// fixing a typo does not claim the article was rewritten.
  edited_at     DateTime?

  /// Computed on save from the English body — never recomputed on read.
  reading_minutes Int @default(0)
  view_count      Int @default(0)

  /// Pins a post to the top of the index regardless of date.
  featured Boolean @default(false)

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  category     BlogCategory?         @relation(fields: [category_id], references: [id], onDelete: SetNull)
  author       User?                 @relation("BlogPostAuthor", fields: [author_user_id], references: [id], onDelete: SetNull)
  translations BlogPostTranslation[]
  slugHistory  BlogPostSlug[]

  @@index([status, published_at])
  @@index([category_id, status, published_at])
  @@index([deleted_at])
  @@map("blog_posts")
}

/// Every locale's copy of a post, including `en`.
///
/// English is not kept on BlogPost itself: that would create two places a
/// post's English title can live, and every read would have to decide which
/// one wins. One row per locale means the answer to "what is this post's title
/// in locale X" is always "its X row, else its en row".
model BlogPostTranslation {
  id      String @id @default(uuid())
  post_id String
  /// en | bn | ms — matches localeRegistry in the frontend.
  locale  String

  title   String
  excerpt String?
  body_md String

  seo_title       String?
  seo_description String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  post BlogPost @relation(fields: [post_id], references: [id], onDelete: Cascade)

  @@unique([post_id, locale])
  @@map("blog_post_translations")
}

model BlogCategory {
  id         String  @id @default(uuid())
  slug       String  @unique
  name_en    String
  name_bn    String?
  name_ms    String?
  sort_order Int     @default(0)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  posts BlogPost[]

  @@map("blog_categories")
}

/// Every slug a post has ever carried, so a rename 301s instead of 404ing.
/// A renamed article that drops its inbound links has lost the thing it was
/// published for.
model BlogPostSlug {
  id         String   @id @default(uuid())
  post_id    String
  slug       String   @unique
  created_at DateTime @default(now())

  post BlogPost @relation(fields: [post_id], references: [id], onDelete: Cascade)

  @@index([post_id])
  @@map("blog_post_slugs")
}

// ---------------------------------------------------------------------------
// Tenant blog — written by a shop's own staff, published on their storefront.
//
// A separate model set from the platform blog on purpose. Every row is
// tenant-scoped and every query goes through the tenant guard; the two share a
// shape but never a table, because a bug that crossed them would publish one
// shop's drafts under another's name.
// ---------------------------------------------------------------------------

model TenantBlogPost {
  id        String @id @default(uuid())
  tenant_id String
  slug      String

  /// DRAFT | SCHEDULED | PUBLISHED | ARCHIVED
  status String @default("DRAFT")

  category_id String?

  title   String
  excerpt String?
  body_md String

  seo_title       String?
  seo_description String?

  cover_image_url   String?
  cover_storage_key String?
  cover_alt         String?

  author_user_id String?
  author_name    String?

  published_at  DateTime?
  scheduled_for DateTime?
  edited_at     DateTime?

  reading_minutes Int     @default(0)
  view_count      Int     @default(0)
  featured        Boolean @default(false)

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  tenant      Tenant               @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  category    TenantBlogCategory?  @relation(fields: [category_id], references: [id], onDelete: SetNull)
  author      User?                @relation("TenantBlogPostAuthor", fields: [author_user_id], references: [id], onDelete: SetNull)
  slugHistory TenantBlogPostSlug[]

  /// Slugs are unique per shop, not globally — two shops may both write a post
  /// called "eid-sale", and each owns the URL under its own storefront.
  @@unique([tenant_id, slug])
  @@index([tenant_id, status, published_at])
  @@index([tenant_id, category_id, status])
  @@index([deleted_at])
  @@map("tenant_blog_posts")
}

model TenantBlogCategory {
  id         String @id @default(uuid())
  tenant_id  String
  slug       String
  name       String
  sort_order Int    @default(0)

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  tenant Tenant           @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  posts  TenantBlogPost[]

  @@unique([tenant_id, slug])
  @@map("tenant_blog_categories")
}

model TenantBlogPostSlug {
  id         String   @id @default(uuid())
  tenant_id  String
  post_id    String
  slug       String
  created_at DateTime @default(now())

  post TenantBlogPost @relation(fields: [post_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, slug])
  @@index([post_id])
  @@map("tenant_blog_post_slugs")
}

/// Per-shop switch and chrome for the storefront blog.
///
/// A row exists only once a shop has touched its blog settings; absent means
/// "off with defaults", so enabling the feature costs no backfill.
model TenantBlogSettings {
  tenant_id String @id

  enabled Boolean @default(false)
  title   String?
  tagline String?

  updated_at DateTime @updatedAt
  updated_by String?

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@map("tenant_blog_settings")
}

/// Marketing copy the platform posts to its own social accounts.
///
/// Platform-owned like `BlogPost` — there is no `tenant_id` because these are
/// ERP71's own Facebook/LinkedIn/X posts, not a shop's. Publishing is delegated
/// to Buffer rather than to each network's API: Buffer already holds the page
/// tokens and the review queue, so the only thing stored here is the copy and
/// the record of what was handed over.
model SocialMediaPost {
  id String @id @default(uuid())

  /// DRAFT | SCHEDULED | PUBLISHED | FAILED — see social-media-status.ts.
  status String @default("DRAFT")

  /// Internal label for the list view only; never sent to any network.
  title   String?
  content String

  /// Appended to the copy by most networks as a link preview. Kept separate
  /// from `content` so it can be swapped without re-editing the text.
  link_url  String?
  /// Must be a public URL: Buffer fetches the asset itself and has no upload.
  image_url String?

  /// Networks this copy is written for — facebook | instagram | linkedin | x |
  /// threads | pinterest. Advisory: what actually goes out is whichever Buffer
  /// channels the operator picks at push time.
  networks String[] @default([])

  scheduled_for DateTime?
  published_at  DateTime?

  author_user_id String?
  /// Denormalised for the same reason as BlogPost.author_name — the row should
  /// keep the name it was written under after that person leaves.
  author_name    String?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  author User?                 @relation("SocialMediaPostAuthor", fields: [author_user_id], references: [id], onDelete: SetNull)
  pushes SocialMediaPostPush[]

  @@index([status, scheduled_for])
  @@index([deleted_at])
  @@map("social_media_posts")
}

/// One handover of a post to one Buffer channel.
///
/// A row per channel rather than a status column on the post: pushing to three
/// pages can half-fail, and a single field cannot say which page rejected it.
/// Rows are kept after failure so the error is still readable on the next visit.
model SocialMediaPostPush {
  id      String @id @default(uuid())
  post_id String

  /// buffer — the only provider today, named so a second one does not need a
  /// migration to tell the rows apart.
  provider        String  @default("buffer")
  channel_id      String
  /// Buffer's own name for the network (facebook, linkedin, …) and the page
  /// label, both copied at push time so the history reads correctly even after
  /// the channel is disconnected in Buffer.
  channel_service String?
  channel_name    String?

  /// addToQueue | now | next | customScheduled. NOT Buffer's spelling — it
  /// calls the middle two shareNow/shareNext, translated in buffer.service.ts.
  mode   String    @default("addToQueue")
  due_at DateTime?

  /// SENT | FAILED. There is no PENDING: the Buffer call is synchronous, so a
  /// row is only written once its outcome is known.
  status           String  @default("SENT")
  /// Buffer's post id, which is what makes the queued item findable in Buffer.
  external_post_id String?
  error            String?

  created_at DateTime @default(now())
  created_by String?

  post SocialMediaPost @relation(fields: [post_id], references: [id], onDelete: Cascade)

