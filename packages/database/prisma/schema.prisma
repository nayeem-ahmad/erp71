  last_used  DateTime?
  created_at DateTime  @default(now())
  revoked_at DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("api_keys")
}

model StorefrontOrder {
