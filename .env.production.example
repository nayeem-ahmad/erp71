NODE_ENV=production

# Public application URLs
FRONTEND_URL=https://app.erp71.com
# The API's own public host: payment gateway callbacks are built from it, and
# the mobile app and API-key clients call it.
BACKEND_PUBLIC_URL=https://api.erp71.com
# Where the browser app sends its API calls: the app's own origin, whose reverse
# proxy routes /api/v1/* straight to the backend. Same origin means no CORS
# preflight per call and no second TLS connection per page load. Bare origin -
# the frontend appends /api/v1. Baked into the frontend image at build time.
# scripts/sync-erp71-env-urls.sh rewrites both on every deploy.
NEXT_PUBLIC_API_BASE=https://app.erp71.com
NEXT_PUBLIC_API_URL=https://app.erp71.com

# Two-domain routing (see docs/ops/deployment-runbook.md -> Domains).
#
# NEXT_PUBLIC_MARKETING_URL is the switch. While it is empty the frontend
# behaves as a single-domain deployment: the marketing homepage is served at
# app.erp71.com/ and nothing is redirected. Set it only once erp71.com and
# www.erp71.com resolve to this VPS and the reverse proxy has site blocks for
# them, then redeploy:
#
#   NEXT_PUBLIC_MARKETING_URL=https://erp71.com
#
# With it set, erp71.com serves the marketing site, app paths typed against it
# move to app.erp71.com, and app.erp71.com/ becomes the app's front door
# (dashboard or account chooser when signed in, login when not).
#
# Both are baked into the frontend image at build time, so a change to either
# needs a rebuild - which is what scripts/deploy.sh does on every deploy.
NEXT_PUBLIC_MARKETING_URL=
NEXT_PUBLIC_APP_URL=https://app.erp71.com

# VPS Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-db-password
POSTGRES_DB=erp71
#
# `connection_limit` is worth setting explicitly. Left off, Prisma sizes the
# pool at (cores * 2 + 1) as seen from inside the container — 5 on a 2-core
# VPS. Every request spends a few queries in the auth path before its handler
# runs, so a pool that small is what gives out first when several people are
# using the app at once: requests queue for a connection while Postgres itself
# is idle. 20 is a reasonable start for one backend container against a
# self-hosted Postgres whose default `max_connections` is 100 — keep the total
# across all containers well under that, and raise Postgres's limit (or put
# PgBouncer in front, see docs/ops/pgbouncer-config.md) before going higher.
DATABASE_URL=postgresql://postgres:change-this-db-password@db:5432/erp71?connection_limit=20
DIRECT_URL=postgresql://postgres:change-this-db-password@db:5432/erp71

# Auth and admin
JWT_SECRET=generate-a-long-random-secret
# Access tokens are renewed silently against a refresh token, so this ceiling no
# longer decides when someone's working day is interrupted. Revocation does not
# depend on it — a logout or password change is checked against the database on
# every request — so there is little to gain from shortening it further.
# Accepts 900, 15m, 2h, 1d. Default: 1h.
JWT_ACCESS_TTL=1h
# How long a browser session can go untouched before it has to sign in again,
# when the sign-in form's "Remember me" was ticked. Default: 30.
JWT_REFRESH_TTL_DAYS=30
# The same, for a sign-in that left "Remember me" unchecked. That box used to
# decide which browser storage held the tokens, which made the session die with
# the tab and left a second tab looking signed out; it sets the session's length
# instead. Never applied above JWT_REFRESH_TTL_DAYS. Default: 1.
JWT_SESSION_REFRESH_TTL_DAYS=1
PLATFORM_ADMIN_EMAILS=nayeem.ahmad@gmail.com
FIELD_ENCRYPTION_KEY=generate-64-hex-chars
REQUIRE_EMAIL_VERIFICATION=true
# Google sign-in. OAuth 2.0 Web client id from Google Cloud Console →
# APIs & Services → Credentials, with app.erp71.com listed as an authorised
# JavaScript origin. Leave empty to hide the Google button entirely. Comma-
# separate to accept more clients, but keep the web client FIRST: it is the one
# /auth/google/config hands out, and the mobile app (apps/mobile) asks Google
# for tokens addressed to it, so no mobile client id has to be listed here.
GOOGLE_CLIENT_ID=

# Mobile-number sign-in (Firebase phone auth). Project id and web API key from
# the Firebase console -> Project settings -> General; add app.erp71.com to
# Authentication -> Settings -> Authorised domains. Both values are public
# client identifiers, not secrets. Leave empty to hide the option entirely.
# FIREBASE_AUTH_DOMAIN is optional and defaults to <project>.firebaseapp.com.
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=

# Billing and payments
BILLING_PROVIDER=SSL_WIRELESS

# Self-serve "Confirm checkout" without a gateway behind it. The manual provider
# — what a deployment with no SSL Wireless credentials falls back to — would
# otherwise hand a tenant a paid plan for nothing, so that path is refused when
# NODE_ENV=production. Set this to true only on a staging box that needs to
# exercise it without gateway credentials. See BillingService.confirmCheckout.
BILLING_ALLOW_MANUAL_CONFIRM=false
SSL_WIRELESS_STORE_ID=your-ssl-wireless-store-id
SSL_WIRELESS_STORE_PASSWORD=your-ssl-wireless-store-password
SSL_WIRELESS_API_URL=https://sandbox.sslcommerz.com/gwprocess/v4/api.php
SSL_WIRELESS_VALIDATION_URL=https://sandbox.sslcommerz.com/validator/api/validationserverAPI.php
SSL_WIRELESS_SUCCESS_REDIRECT=https://app.erp71.com/dashboard/billing
SSL_WIRELESS_FAIL_REDIRECT=https://app.erp71.com/dashboard/billing
SSL_WIRELESS_CANCEL_REDIRECT=https://app.erp71.com/dashboard/billing
BKASH_APP_KEY=your-bkash-app-key
BKASH_APP_SECRET=your-bkash-app-secret
BKASH_API_URL=https://api.bkash.com/sandbox
NAGAD_MERCHANT_ID=your-nagad-merchant-id
NAGAD_API_KEY=your-nagad-api-key
NAGAD_API_URL=https://api.nagad.com.bd/sandbox

# Email and support (use one provider)
BREVO_API_KEY=your-brevo-api-v3-key
RESEND_API_KEY=
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-smtp-login
SMTP_PASS=your-brevo-smtp-key
EMAIL_FROM=notify@erp71.com
SUPPORT_EMAIL=support@nayeemahmad.com
FEEDBACK_EMAIL=feedback@nayeemahmad.com

# Rate limits (apps/backend/src/common/default-throttle.util.ts). Leave unset to
# use the defaults below; each budget is per route, per minute.
#   THROTTLE_LIMIT     per signed-in user (per address for a request without a
#                      valid access token). Default 120.
#   THROTTLE_IP_LIMIT  per address, whatever the token: the ceiling that lets a
#                      shop floor share one office line while still capping one
#                      host. Default 600, and never below THROTTLE_LIMIT unless
#                      set explicitly.
#   THROTTLE_TTL_MS    the window both count over. Default 60000.
# Routes with their own @Throttle budget (sign-in, sign-up, password reset,
# /auth/me, uploads, AI) keep it, per user and per address alike.
# THROTTLE_LIMIT=120
# THROTTLE_IP_LIMIT=600
# THROTTLE_TTL_MS=60000

# Client addresses behind a CDN
#
# Set to true only while Cloudflare proxies the site (orange cloud). The backend
# then also trusts Cloudflare's published ranges as proxy hops, so rate limits
# and the audit log see the visitor's address instead of a Cloudflare edge's.
# Caddy's own `trusted_proxies` must list the same ranges, or it will not pass
# Cloudflare's X-Forwarded-For on. Leave it false otherwise: with no Cloudflare
# in front, trusting those ranges lets anyone who routes through Cloudflare
# choose the address the backend records. See apps/backend/src/common/
# trust-proxy.util.ts and docs/performance/perceived-speed-plan.md (P3.1).
TRUST_CLOUDFLARE_PROXY=false

# Infrastructure and observability
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# System health monitoring thresholds (platform-admin /admin/system-health)
HEALTH_DEP_TIMEOUT_MS=2000
HEALTH_DB_LATENCY_DEGRADED_MS=1000
HEALTH_DB_POOL_DEGRADED_PCT=80
# Prometheus metrics scrape endpoint (GET /api/v1/metrics); leave unset to disable
METRICS_TOKEN=
# Threshold alerting — notify platform admins when the system is degraded/down
HEALTH_ALERT_EMAILS=
HEALTH_ALERT_SMS=
HEALTH_ALERT_COOLDOWN_MIN=30
HEALTH_PAYMENT_FAILURE_THRESHOLD=3
HEALTH_PAYMENT_FAILURE_WINDOW_MIN=60
SMS_CREDIT_LOW_THRESHOLD=100
SMS_CREDIT_LOW_TENANTS_ALERT=5
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=your-frontend-sentry-dsn
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=erp71-frontend

# Directory for gzipped external-ERP extracts (per-tenant subdirs).
EXTERNAL_SYNC_SNAPSHOT_DIR=/var/lib/erp71/external-sync-snapshots