{
  "name": "erp71",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/backend",
    "apps/frontend",
    "apps/mobile"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:catalog-harvest": "tsx --test scripts/catalog-harvest/*.spec.ts",
    "prepare": "bash scripts/setup-git-hooks.sh"
  },
  "devDependencies": {
    "node-html-parser": "^9.0.7",
    "playwright": "^1.60.0",
    "prisma": "^5.22.0",
    "tsx": "^4.23.15"
  }
}
